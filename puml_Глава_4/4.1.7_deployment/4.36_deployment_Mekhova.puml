' Рисунок 4.36 — Сегмент диаграммы развёртывания: Backoffice, администрирование и аудит, Мехова А.С.
' Рендер: PlantUML 1.2024+ со встроенной библиотекой C4 (!include <C4/...>), интернет не нужен
@startuml
skinparam defaultFontName Arial
skinparam shadowing false
skinparam ArrowColor #1F3F6E
skinparam node {
  BackgroundColor #EAF4FB
  BorderColor #2E86C1
}
skinparam artifact {
  BackgroundColor #6CC0F0
  BorderColor #2E86C1
}
skinparam database {
  BackgroundColor #A9D8F5
  BorderColor #2E86C1
}
skinparam cloud {
  BackgroundColor #F2F2F2
  BorderColor #8A8A8A
}

title ИС ОСАГО, Backoffice. DEPLOYMENT DIAGRAM — локальный сегмент модуля администрирования и аудита (Мехова А.С.)

node "Рабочие места сотрудников\nбэк-офиса\n(браузер, корпоративная сеть)" as ws
node "VPN-шлюз / корпоративный МЭ\nдоступ только для сотрудников" as vpn

node "Корпоративный сервер (on-prem)\nDocker host, Linux, 16 CPU / 32 GB" as host {
  node "Изолированная docker-сеть\n172.20.0.0/16 (bridge)" as net {
    artifact "Nginx Reverse Proxy\n:443, TLS 1.2+\nвход в Backoffice только\nиз корпоративной сети (allowlist)" as nginx
    artifact "API (FastAPI)\nреплика 1\n:8000" as api1
    artifact "Backoffice\nстатический бандл React SPA\n(отдаётся Nginx)" as bo
    artifact "API (FastAPI)\nреплика 2\n:8000" as api2
    artifact "Worker (Celery)\nинстанс 1" as w1
    database "DB_USERS\nPostgreSQL :5432, TLS" as users
    database "DB_TARIFS\nPostgreSQL :5432, TLS" as tarifs
    database "DB_AUDIT\nPostgreSQL, Master\n:5432, TLS" as audit_m
    database "DB_AUDIT\nPostgreSQL, Replica\n(hot standby), :5432" as audit_r
  }
}

node "Служба авторизации (IAM)\nкорпоративный сервер, :8443" as iam

cloud "Интернет" as inet {
  node "E-mail система\nвнешний почтовый релей" as email
  node "АИС ОСАГО (РСА)\nвнешняя отраслевая система" as ais
}

ws --> vpn : HTTPS, TLS 1.2+\n:443/TCP
vpn --> nginx : HTTPS :443/TCP\n(IP allowlist)
nginx --> api1 : reverse proxy /api/admin\n:8000/TCP, round-robin\n+ health check
nginx --> bo : отдача статики\n:443/TCP
nginx --> api2 : reverse proxy /api/admin\n:8000/TCP, round-robin\n+ health check
api1 --> users : SQL/TCP, TLS :5432
api1 --> tarifs : SQL/TCP, TLS :5432
api1 --> audit_m : SQL/TCP, TLS :5432\nаудит, outbox
api2 --> audit_m : SQL/TCP, TLS :5432
w1 --> audit_m : опрос outbox\n:5432/TCP, TLS
audit_m --> audit_r : streaming replication\n:5432/TCP, TLS
api1 --> iam : OAuth2 introspection\n:8443/TCP, TLS
api2 --> iam : OAuth2 introspection\n:8443/TCP, TLS
w1 --> email : SMTP STARTTLS\n:587/TCP
w1 --> ais : HTTPS, mTLS\n:443/TCP
@enduml
