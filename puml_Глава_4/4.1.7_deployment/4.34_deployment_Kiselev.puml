' Рисунок 4.34 — Сегмент диаграммы развёртывания: API, фиксация ДТП и осмотр, Киселев Д.А.
' Рендер: PlantUML 1.2024+ со встроенной библиотекой C4 (!include <C4/...>), интернет не нужен
@startuml
skinparam defaultFontName Arial
skinparam shadowing false
skinparam ArrowColor #1F3F6E
skinparam node {
  BackgroundColor #EAF4FB
  BorderColor #2E86C1
}
skinparam artifact {
  BackgroundColor #6CC0F0
  BorderColor #2E86C1
}
skinparam database {
  BackgroundColor #A9D8F5
  BorderColor #2E86C1
}
skinparam cloud {
  BackgroundColor #F2F2F2
  BorderColor #8A8A8A
}

title ИС ОСАГО, фиксация ДТП. DEPLOYMENT DIAGRAM — локальный сегмент модуля аварийного эксперта (Киселев Д.А.)

node "Рабочие места\nдиспетчера, эксперта, клиента\n(браузер)" as ws

node "Корпоративный сервер (on-prem)\nDocker host, Linux, 16 CPU / 32 GB" as host {
  node "Изолированная docker-сеть\n172.20.0.0/16 (bridge)" as net {
    artifact "Nginx Reverse Proxy\n:443, TLS 1.2+\nединственная точка входа" as nginx
    artifact "Web App\nстатический бандл React SPA\n(отдаётся Nginx)" as webapp
    artifact "API (FastAPI)\nреплика 1\n:8000" as api1
    artifact "API (FastAPI)\nреплика 2\n:8000" as api2
    artifact "Worker (Celery)\nинстанс 1" as w1
    artifact "Worker (Celery)\nинстанс 2" as w2
    database "DB_AUDIT\nPostgreSQL, Master\n:5432, TLS" as audit_m
    database "DB_AUDIT\nPostgreSQL, Replica\n(hot standby), :5432" as audit_r
    database "DB_FILES\nMongoDB, Primary\n:27017, TLS" as files_p
    database "DB_FILES\nMongoDB, Secondary\n:27017" as files_s
  }
}

cloud "Интернет" as inet {
  node "E-mail система\nвнешний почтовый релей" as email
  node "АИС ОСАГО (РСА)\nвнешняя отраслевая система" as ais
}

ws --> nginx : HTTPS, TLS 1.2+, HSTS\n:443/TCP
nginx --> webapp : отдача статики\n:443/TCP
nginx --> api1 : reverse proxy\n:8000/TCP, round-robin\n+ health check
nginx --> api2 : reverse proxy\n:8000/TCP, round-robin\n+ health check
api1 --> audit_m : SQL/TCP, TLS\n5432
api2 --> audit_m : SQL/TCP, TLS\n5432
api1 --> files_p : MongoDB Wire, TLS\n:27017
api2 --> files_p : MongoDB Wire, TLS\n:27017
w1 --> audit_m : опрос очереди outbox\n:5432/TCP, TLS
w2 --> audit_m : опрос очереди outbox\n:5432/TCP, TLS
w1 --> files_p : чтение фото,\nзапись PDF :27017/TCP, TLS
w2 --> files_p : чтение фото,\nзапись PDF :27017/TCP, TLS
audit_m --> audit_r : streaming replication\n:5432/TCP, TLS
files_p --> files_s : replication\n:27017/TCP, TLS
w1 --> email : SMTPS :465/TCP\nили STARTTLS 587
w2 --> email : SMTPS :465/TCP\nили STARTTLS 587
api1 --> ais : HTTPS, mTLS\n(клиентский сертификат)\n:443/TCP
api2 --> ais : HTTPS, mTLS\n(клиентский сертификат)\n:443/TCP
@enduml
