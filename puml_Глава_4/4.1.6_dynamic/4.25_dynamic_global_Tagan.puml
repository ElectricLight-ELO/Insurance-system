' Рисунок 4.25 — Глобальная динамическая диаграмма: сквозной процесс ИС ОСАГО, Таган А.М.
' Рендер: PlantUML 1.2024+ со встроенной библиотекой C4 (!include <C4/...>), интернет не нужен
@startuml
!include <C4/C4_Dynamic>
skinparam defaultFontName Arial
skinparam wrapWidth 300
AddElementTag("ext", $bgColor="#A9A9A9", $borderColor="#8A8A8A", $fontColor="#FFFFFF", $legendText="Внешняя система")
AddElementTag("staff", $bgColor="#1F4E8C", $borderColor="#143560", $fontColor="#FFFFFF", $legendText="Пользователь / сотрудник")
AddRelTag("async", $lineStyle=DashedLine(), $lineColor="#000000", $legendText="Асинхронное взаимодействие (фоновая обработка)")
HIDE_STEREOTYPE()

title Глобальная динамическая диаграмма ИС ОСАГО — сквозной процесс всех модулей (сборка тимлида Таган А.М.)

Person(client, "Клиент / агент", "Полис, подпись протокола", $tags="staff")
Person(insured, "Застрахованный клиент", "Оплата полиса", $tags="staff")
Person(dispexp, "Диспетчер и эксперт", "ДТП и осмотр", $tags="staff")
Person(suppsec, "Поддержка и ИБ", "Задачи и аудит", $tags="staff")
Person(accountant, "Бухгалтер", "Маржа и сверка", $tags="staff")

System_Boundary(osago, "ИС ОСАГО") {
    Container(web_app, "Web App", "React SPA", "Романов Н.И.: CalculatorPage, CheckoutPage, AccidentPage, InspectionPage → *ApiClient → HttpClient")
    Container(backoffice, "Backoffice", "React SPA", "Мехова А.С.: TasksPage, AuditLogPage, FinanceDashboard → *ApiClient → HttpClient")
    Container(api, "API", "FastAPI", "Киселев Д.А.: Auth/Policy/Payment/Accident/Inspection/AdminController → сервисы → фасады и репозитории")
    Container(worker, "Worker", "Python / Celery", "Усков М.В.: OutboxPoller, Scheduler → задачи Celery → сервисы")
    ContainerDb(db_users, "DB_USERS", "PostgreSQL", "Пользователи, роли, полисы")
    ContainerDb(db_tarifs, "DB_TARIFS", "PostgreSQL", "Тарифы, коэффициенты, маржа")
    ContainerDb(db_audit, "DB_AUDIT", "PostgreSQL", "Аудит, транзакции, акты ДТП, очередь задач (outbox)")
    ContainerDb(db_files, "DB_FILES", "MongoDB", "Фото, подписи, PDF")
}
System_Ext(sms, "SMS-шлюз", "Одноразовые коды", $tags="ext")
System_Ext(ais, "АИС ОСАГО (РСА)", "КБМ, проверка полиса, регистрация договоров", $tags="ext")
System_Ext(payment, "Платёжная система", "Сессии, webhook, сверка", $tags="ext")
System_Ext(email, "E-mail система", "Доставка документов и отчётов", $tags="ext")


' ===== Фаза 0 — вход по одноразовому коду (общая, API) =====
setIndex(1)
Rel(client, web_app, "Вводит телефон и одноразовый код", "HTTPS")
Rel(web_app, api, "POST /api/auth/code — request_code(); POST /api/auth/verify — issue_token() [AuthController → AccessService]", "REST/HTTPS, JSON")
Rel(api, sms, "send_code(phone, code) [SmsGatewayFacade]", "HTTPS, JSON")

' ===== Фаза А — Романов Н.И., Web App: расчёт, оформление, оплата, регистрация, PDF =====
Rel(web_app, api, "POST /api/policies/calculate — calculate_premium() [PolicyController → PolicyService]", "REST/HTTPS, JSON")
Rel(api, db_tarifs, "get_coefficients() [TariffRepository]", "SQL/TCP 5432")
Rel(api, ais, "get_kbm(), check_vehicle(), check_drivers() [AisOsagoFacade]", "HTTPS, JSON, mTLS")
Rel(web_app, api, "POST /api/policies — issue_policy() [PolicyController]", "REST/HTTPS, JSON")
Rel(api, db_users, "save_policy() [UserRepository]", "SQL/TCP 5432")
Rel(web_app, api, "POST /api/payments/session — create_session() [PaymentController → PaymentService]", "REST/HTTPS, JSON")
Rel(api, payment, "create_session(policy_id, amount) [PaymentGatewayFacade]", "HTTPS, JSON")
Rel(insured, payment, "Оплачивает полис", "HTTPS")
Rel(payment, api, "POST /api/payments/webhook — handle_webhook()", "HTTPS, JSON")
Rel(api, db_audit, "save_transaction(); save_task(CONTRACT_REG, PDF_POLICY) [AccidentRepository, TaskQueueFacade → outbox]", "SQL/TCP 5432")
Rel(worker, db_audit, "list_pending_tasks() [OutboxPoller → AuditRepository]", "SQL/TCP 5432", $tags="async")
Rel(worker, ais, "register_policy(policy_data) [RegistrationTask → ContractService → AisOsagoFacade]", "HTTPS, JSON, mTLS", $tags="async")
Rel(worker, db_files, "generate_policy_pdf() → save_policy_pdf() [PdfTask → DocumentService → FileRepository]", "MongoDB/TCP 27017", $tags="async")
Rel(worker, email, "send_mail(полис, чек) [NotificationTask → EmailFacade]", "SMTP/STARTTLS 587", $tags="async")

' ===== Фаза Б — Киселев Д.А., API: заявление о ДТП, осмотр, подпись, PDF-протокол =====
Rel(dispexp, web_app, "Регистрирует заявление, назначает эксперта, вносит осмотр", "HTTPS")
Rel(web_app, api, "POST /api/claims — register_claim() [AccidentController → AccidentService]", "REST/HTTPS, JSON")
Rel(api, ais, "check_policy(claim) [AisOsagoFacade]", "HTTPS, JSON, mTLS")
Rel(api, db_audit, "save_claim(); assign_expert() [AccidentRepository]", "SQL/TCP 5432")
Rel(web_app, api, "POST /api/claims/{id}/inspection, /photos — submit_results(), upload_photos() [InspectionController → InspectionService]", "REST/HTTPS, multipart")
Rel(api, db_files, "save_photos() [FileRepository]; save_inspection() [AccidentRepository]", "MongoDB/TCP 27017 / SQL/TCP 5432")
Rel(client, web_app, "Подписывает протокол осмотра (SignaturePad)", "HTTPS")
Rel(web_app, api, "POST /api/claims/{id}/signature — accept_signature()", "REST/HTTPS, JSON")
Rel(api, db_files, "save_signature() [FileRepository]", "MongoDB/TCP 27017")
Rel(api, db_audit, "save_task(PDF_PROTOCOL); save_audit() [TaskQueueFacade, AuditService]", "SQL/TCP 5432")
Rel(worker, db_audit, "list_pending_tasks(): PDF_PROTOCOL [OutboxPoller]", "SQL/TCP 5432", $tags="async")
Rel(worker, db_files, "generate_protocol_pdf() → save_pdf() [PdfTask → DocumentService]", "MongoDB/TCP 27017", $tags="async")
Rel(worker, email, "send_mail(протокол осмотра) [NotificationTask → EmailFacade]", "SMTP/STARTTLS 587", $tags="async")

' ===== Фаза В — Усков М.В., Worker: маржа, сверка платежей, отчёт =====
Rel(accountant, backoffice, "Запускает расчёт маржи за период (FinanceDashboard)", "HTTPS (VPN)")
Rel(backoffice, api, "POST /api/admin/finance/margin — trigger_margin() [AdminController → AdminService]", "REST/HTTPS, JSON")
Rel(api, db_audit, "save_task(MARGIN_CALC) [TaskQueueFacade → outbox]", "SQL/TCP 5432")
Rel(worker, db_audit, "get_for_period(): транзакции [MarginCalculationTask → MarginService → TransactionRepository]", "SQL/TCP 5432", $tags="async")
Rel(worker, db_tarifs, "get_coefficients(); save_margin_result() [TariffRepository]", "SQL/TCP 5432", $tags="async")
Rel(worker, payment, "check_pending_transactions() по расписанию [Scheduler → GatewayReconciliationTask → PaymentGatewayFacade]", "HTTPS, JSON", $tags="async")
Rel(worker, db_audit, "update_status() зависших платежей [ReconciliationService → TransactionRepository]", "SQL/TCP 5432", $tags="async")
Rel(worker, email, "Отчёт по марже бухгалтеру [ReportTask → ReportService → EmailFacade]", "SMTP/STARTTLS 587", $tags="async")

' ===== Фаза Г — Мехова А.С., Backoffice: перезапуск задачи, журнал аудита =====
Rel(suppsec, backoffice, "Перезапускает сбойную задачу (TasksPage), открывает журнал аудита (AuditLogPage)", "HTTPS (VPN)")
Rel(backoffice, api, "POST /api/admin/tasks/{id}/restart — restart_task() [AdminController → AccessService (RBAC) → AdminService]", "REST/HTTPS, JSON")
Rel(api, db_audit, "save_task(CONTRACT_REG, pending); save_audit(task_restarted) [TaskQueueFacade, AuditService]", "SQL/TCP 5432")
Rel(backoffice, api, "GET /api/admin/audit — get_audit() [AdminController → AdminService]", "REST/HTTPS, JSON")
Rel(api, db_audit, "list_audit() [AccidentRepository]", "SQL/TCP 5432")

SHOW_LEGEND()
@enduml
