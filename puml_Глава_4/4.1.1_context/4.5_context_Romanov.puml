' Рисунок 4.5 — Локальная диаграмма контекста (уровень 1): Web App, продажа и оформление полисов, Романов Н.И.
' Рендер: PlantUML 1.2024+ со встроенной библиотекой C4 (!include <C4/...>), интернет не нужен
@startuml
!include <C4/C4_Context>
skinparam defaultFontName Arial
AddElementTag("target", $bgColor="#2E86C1", $borderColor="#1F6391", $fontColor="#FFFFFF", $legendText="Целевой модуль разработчика")
AddElementTag("ext", $bgColor="#A9A9A9", $borderColor="#8A8A8A", $fontColor="#FFFFFF", $legendText="Внешняя система")
AddElementTag("staff", $bgColor="#1F4E8C", $borderColor="#143560", $fontColor="#FFFFFF", $legendText="Пользователь / сотрудник")
AddElementTag("outer", $bgColor="#A9A9A9", $borderColor="#8A8A8A", $fontColor="#FFFFFF", $legendText="Внешний пользователь")
AddRelTag("async", $lineStyle=DashedLine(), $lineColor="#000000", $legendText="Асинхронное взаимодействие (фоновая обработка)")
HIDE_STEREOTYPE()

title ИС ОСАГО — локальная диаграмма контекста (L1): продажа и оформление полисов (Романов Н.И.)

Person(guest, "Гость", "Рассчитывает стоимость\nполиса без входа", $tags="outer")
Person(client, "Клиент", "Оформляет полис,\nличный кабинет", $tags="staff")
Person(agent, "Страховой агент", "Оформляет полисы\nза клиентов", $tags="staff")
Person(manager, "Менеджер отдела продаж", "Контроль агентов,\nсложные случаи", $tags="staff")
Person(insured, "Застрахованный клиент", "Оплачивает полис", $tags="outer")

System(osago, "ИС ОСАГО", "Расчёт премии, оформление и оплата полиса,\nличный кабинет, рабочие места\nагента и менеджера", $tags="target")

System_Ext(payment, "Платёжная система", "Платёжная сессия,\nwebhook об оплате", $tags="ext")
System_Ext(sms, "SMS-шлюз", "Одноразовые коды входа", $tags="ext")
System_Ext(email, "E-mail система", "Электронный полис и чек", $tags="ext")
System_Ext(ais, "АИС ОСАГО (РСА)", "КБМ, проверка ТС и водителей,\nрегистрация договора", $tags="ext")

Rel_D(guest, osago, "Рассчитывает стоимость полиса", "HTTPS")
Rel_D(client, osago, "Оформляет полис, скачивает PDF", "HTTPS")
Rel_D(agent, osago, "Оформляет полис за клиента", "HTTPS")
Rel_D(manager, osago, "Смотрит продажи, утверждает\nсложные случаи", "HTTPS")
Rel_D(insured, payment, "Оплачивает полис", "HTTPS")

Rel_D(osago, payment, "Создаёт платёжную сессию", "HTTPS, JSON")
Rel_U(payment, osago, "Сообщает об оплате (webhook)", "HTTPS, JSON")
Rel_D(osago, sms, "Отправляет код входа", "HTTPS, JSON")
Rel_D(osago, email, "Отправляет полис и чек", "SMTP/STARTTLS 587", $tags="async")
Rel_D(osago, ais, "Получает КБМ, проверяет ТС\nи водителей", "HTTPS, JSON, mTLS")

Lay_R(guest, client)
Lay_R(client, agent)
Lay_R(agent, manager)
Lay_R(payment, sms)
Lay_R(sms, email)
Lay_R(email, ais)

SHOW_LEGEND()
@enduml
