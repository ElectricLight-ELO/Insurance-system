' Рисунок 4.21 — Локальный системный ландшафт: API, фиксация ДТП и осмотр, Киселев Д.А.
' Рендер: PlantUML 1.2024+ со встроенной библиотекой C4 (!include <C4/...>), интернет не нужен
@startuml
!include <C4/C4_Context>
skinparam defaultFontName Arial
AddElementTag("target", $bgColor="#2E86C1", $borderColor="#1F6391", $fontColor="#FFFFFF", $legendText="Целевой модуль разработчика")
AddElementTag("ext", $bgColor="#A9A9A9", $borderColor="#8A8A8A", $fontColor="#FFFFFF", $legendText="Внешняя система")
AddElementTag("staff", $bgColor="#1F4E8C", $borderColor="#143560", $fontColor="#FFFFFF", $legendText="Пользователь / сотрудник")
AddRelTag("async", $lineStyle=DashedLine(), $lineColor="#000000", $legendText="Асинхронное взаимодействие (фоновая обработка)")
HIDE_STEREOTYPE()

title ИС ОСАГО, фиксация ДТП. SYSTEM LANDSCAPE (L0) — модуль аварийного эксперта (Киселев Д.А.)

Person(dispatcher, "Диспетчер", "Оператор колл-центра: принимает\nзаявления о ДТП, назначает эксперта", $tags="staff")
Person(expert, "Аварийный эксперт", "Выезжает на место ДТП,\nпроводит осмотр, загружает фото", $tags="staff")
Person(client, "Клиент", "Участник ДТП: подписывает\nэлектронный протокол осмотра", $tags="staff")

Enterprise_Boundary(ent, "Корпоративная ИТ-инфраструктура страховой компании") {
    System(policy, "Подсистема оформления полисов", "Расчёт премии, договоры,\nплатежи и комиссия (КВ)")
    System(accident, "ИС ОСАГО: фиксация ДТП и осмотр", "Регистрация заявлений, назначение эксперта,\nприём фото и подписи, выдача PDF-протокола", $tags="target")
    System(iam, "Служба авторизации (IAM)", "Аутентификация сотрудников, RBAC,\nвыпуск и проверка токенов доступа")
}

System_Ext(payment, "Платёжная система", "Внешняя финансовая система:\nплатёжные сессии, сверки", $tags="ext")
System_Ext(email, "E-mail система", "Рассылка протоколов, полисов,\nчеков и уведомлений", $tags="ext")
System_Ext(ais, "АИС ОСАГО (РСА)", "Отраслевая система: проверка полиса,\nКБМ, регистрация договоров", $tags="ext")
System_Ext(sms, "SMS-шлюз", "Доставка одноразовых\nкодов авторизации", $tags="ext")

Rel(dispatcher, accident, "Регистрирует заявление о ДТП,\nназначает эксперта", "HTTPS")
Rel(expert, accident, "Загружает фото и результаты осмотра", "HTTPS")
Rel(client, accident, "Подписывает протокол осмотра", "HTTPS")

Rel(policy, accident, "Сведения о договоре ОСАГО\nпо номеру полиса", "HTTPS, JSON")
Rel(policy, payment, "Создание платёжной сессии,\nсверка поступлений", "HTTPS, JSON")
Rel(accident, iam, "Проверка учётных данных, ролей (RBAC)\nи токенов сессии", "HTTPS, JSON, OAuth2")
Rel(iam, sms, "Отправка одноразового кода\nдля авторизации", "HTTPS, JSON")
Rel(accident, email, "Отправка протокола осмотра\nи уведомлений", "SMTP / STARTTLS", $tags="async")
Rel(accident, ais, "Проверка наличия полиса ОСАГО\nпри регистрации заявления", "HTTPS, JSON, mTLS")
Rel(email, client, "Доставка протокола осмотра", "E-mail", $tags="async")

SHOW_LEGEND()
@enduml
