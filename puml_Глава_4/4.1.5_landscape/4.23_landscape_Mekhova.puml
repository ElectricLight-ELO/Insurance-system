' Рисунок 4.23 — Локальный системный ландшафт: Backoffice, администрирование и аудит, Мехова А.С.
' Рендер: PlantUML 1.2024+ со встроенной библиотекой C4 (!include <C4/...>), интернет не нужен
@startuml
!include <C4/C4_Context>
skinparam defaultFontName Arial

title ИС ОСАГО, Backoffice. SYSTEM LANDSCAPE (L0) — модуль администрирования и аудита (Мехова А.С.)

AddElementTag("target", $bgColor="#2E86C1", $borderColor="#1F6391", $fontColor="#FFFFFF", $legendText="Целевой модуль разработчика")
AddElementTag("ext", $bgColor="#A9A9A9", $borderColor="#8A8A8A", $fontColor="#FFFFFF", $legendText="Внешняя система")
AddElementTag("staff", $bgColor="#1F4E8C", $borderColor="#143560", $fontColor="#FFFFFF", $legendText="Пользователь / сотрудник")
AddRelTag("async", $lineStyle=DashedLine(), $legendText="Асинхронное взаимодействие")

Person(admin, "Администратор", "Пользователи, роли, тарифы,\nрегистрация договора по команде", $tags="staff")
Person(support, "Оператор поддержки", "Поиск полисов и платежей,\nперезапуск сбойных задач", $tags="staff")
Person(security, "Сотрудник ИБ", "Журнал аудита,\nрасследования инцидентов", $tags="staff")
Person(accountant, "Бухгалтер", "Маржа, оплаты,\nсчета и акты", $tags="staff")

Enterprise_Boundary(ent, "Корпоративная ИТ-инфраструктура страховой компании") {
    System(backoffice, "ИС ОСАГО: Backoffice\n(администрирование и аудит)", "Админ-панель: пользователи и роли, тарифы, задачи, поиск полисов, журнал аудита, финансовые отчёты", $tags="target")
    System(iam, "Служба авторизации (IAM)", "Аутентификация сотрудников,\nRBAC, выпуск и проверка токенов")
    System(policy, "Подсистема оформления\nполисов и урегулирования", "API и Worker: полисы, платежи,\nДТП, очередь задач (outbox), аудит")
    System(crm, "CRM страховой компании", "Карточки клиентов, история обращений")
}

System_Ext(ais, "АИС ОСАГО (РСА)", "Регистрация договоров, проверка полиса", $tags="ext")
System_Ext(email, "E-mail система", "Отчёты, счета и акты, уведомления о сбоях", $tags="ext")

Rel(admin, backoffice, "Управляет пользователями, ролями, тарифами", "HTTPS")
Rel(support, backoffice, "Ищет полисы и платежи, перезапускает задачи", "HTTPS")
Rel(security, backoffice, "Просматривает и выгружает журнал аудита", "HTTPS")

Rel(backoffice, iam, "Вход по коду, проверка ролей (RBAC), токены", "HTTPS, JSON, OAuth2")
Rel(backoffice, policy, "Административные операции, журнал аудита, статусы задач и платежей", "REST/HTTPS, JSON")
Rel(backoffice, crm, "Карточка клиента при обращении в поддержку", "HTTPS, JSON")

Rel(policy, ais, "Регистрирует договор, в т.ч. по команде администратора", "HTTPS, JSON, mTLS")
Rel(policy, email, "Отчёты, счета и акты, уведомления о сбоях", "SMTP / STARTTLS", $tags="async")
Rel(email, accountant, "Доставляет отчёты, счета и акты", "E-mail", $tags="async")
Rel(accountant, backoffice, "Смотрит маржу и оплаты, запрашивает счета", "HTTPS")

HIDE_STEREOTYPE()
SHOW_LEGEND()
@enduml
