@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title СЕРВИС ОФОРМЛЕНИЯ ПОЛИСОВ ОСАГО C4 CONTAINER

' === НАСТРОЙКА ЦВЕТОВ ===
' Темно-синий цвет для всех пользователей (акторов)
AddPersonTag("пользователь", $bgColor="#003366", $borderColor="#002244", $fontColor="#FFFFFF")
AddSystemTag("внешняя_система", $bgColor="#A9A9A9", $borderColor="#8A8A8A", $fontColor="#FFFFFF")
AddRelTag("пунктир", $lineStyle = DashedLine(), $lineColor = "#000000")

' === ЭЛЕМЕНТЫ ===

Person(agent, "Страховой агент", "Специалист страховой компании,\nработающий с клиентами", $tags="пользователь")
Person(client, "Клиент", "Участник ДТП (застрахованное лицо\nили потерпевшее третье лицо)", $tags="пользователь")
Person(manager, "Менеджер отдела продаж", "Контроль работы агентов,\nутверждение сложных случаев", $tags="пользователь")

' Центральный сервис
System_Boundary(osago_service, "Информационная система оформления полисов ОСАГО (ИС ОСАГО)") {

    Container(web_app, "Web App", "React SPA", "Клиентское веб-приложение. Предоставляет интерфейс для агента,\nотправляет REST/HTTPS+JSON запросы к API")

    Container(api, "API", "FASTAPI", "Backend сервис. Принимает запросы от Web App,\nвзаимодействует с БД, создаёт задачи для Worker")

    Container(worker, "Worker", "Celery / Python / Redis", "Асинхронная обработка:\nгенерация PDF-протокола, отправка email,\nповторная регистрация полиса при сбое")

    ContainerDb(db_audit, "DB_AUDIT", "PostgreSQL / Redis", "Журнал событий аудита и очередь асинхронных задач")
    
    ContainerDb(db_dtp, "DB_DTP", "PostgreSQL / Object Storage", "Хранит фото ДТП, подписи и файлы документов")
}

' Внешние системы (серые)
System_Ext(ais_osago, "АИС ОСАГО", "Автоматизированная информационная\nсистема страхования", $tags="внешняя_система")
System_Ext(email_sys, "E-mail система", "Внутренняя система обмена письмами", $tags="внешняя_система")

' === СВЯЗИ ===

' Страховой агент -> Web App
Rel(agent, web_app, "Составляет и заполняет договора,\nоформляет полис ОСАГО")

' Клиент -> Web App
Rel(client, web_app, "Подаёт заявку на оформление полиса,\nполучает готовый полис")

' Менеджер -> Web App (аналитика и управление)
Rel(manager, web_app, "Просматривает отчёты по продажам,\nуправляет списком агентов,\nутверждает сложные случаи")

' Web App -> API
Rel(web_app, api, "REST/HTTPS+JSON — проверка корректности\nи актуальности данных")

' API -> DB_AUDIT
Rel(api, db_audit, "Чтение/запись полисов, платежей,\nжурнал аудита, SQL")

' API -> DB_DTP
Rel(api, db_dtp, "Загрузка и чтение файлов документов,\nподписей, фото ДТП")

' API -> Worker
Rel(api, worker, "Создание задач на асинхронную обработку")

' Worker -> DB_AUDIT (поллинг очереди задач)
Rel(worker, db_audit, "Читает и обновляет\nстатусы задач и журнал аудита")

' Worker -> DB_DTP (для прикрепления файлов к письмам)
Rel(worker, db_dtp, "Чтение файлов для прикрепления\nк email-уведомлениям", $tags="пунктир")

' Worker -> АИС ОСАГО (пунктир — повтор при сбое)
Rel(worker, ais_osago, "Повторная регистрация полиса\nпри ошибке/таймауте", $tags="пунктир")

' Worker -> E-mail система (пунктир)
Rel(worker, email_sys, "Отправка электронного полиса\nи уведомлений", $tags="пунктир")

' API -> E-mail система (для оперативных вопросов)
Rel(api, email_sys, "Отправка вопросов и корректировок,\nSMTP/HTTP")

' E-mail система -> Клиент (пунктир)
Rel(email_sys, client, "Доставка информации и договоров\nКлиенту", $tags="пунктир")

' === УПРАВЛЕНИЕ LAYOUT (скрытые связи) ===

' Акторы сверху в ряд
agent -[hidden]right- client
client -[hidden]right- manager

' Спуск к приложению
agent -[hidden]down- web_app

' Контейнеры внутри boundary
web_app -[hidden]right- api
api -[hidden]down- db_audit
db_audit -[hidden]right- db_dtp
db_audit -[hidden]down- worker

' Внешние системы внизу
osago_service -[hidden]down- ais_osago
ais_osago -[hidden]right- email_sys

@enduml
