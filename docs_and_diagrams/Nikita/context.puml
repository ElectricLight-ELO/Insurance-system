@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title СИСТЕМА ОФОРМЛЕНИЯ ПОЛИСОВ ОСАГО — C4 CONTEXT

' === НАСТРОЙКА ЦВЕТОВ (как в Container диаграмме) ===
AddSystemTag("внешняя_система", $bgColor="#A9A9A9", $borderColor="#8A8A8A", $fontColor="#FFFFFF")
AddPersonTag("сотрудник", $bgColor="#438DD5", $borderColor="#316CA5", $fontColor="#FFFFFF")
AddRelTag("пунктир", $lineStyle = DashedLine(), $lineColor = "#000000")

' === ЭЛЕМЕНТЫ ===

Person(agent, "Страховой агент", "Специалист страховой компании,\nработающий с клиентами", $tags="сотрудник")
Person(client, "Клиент", "Участник ДТП (застрахованное лицо\nили потерпевшее третье лицо)")
Person(manager, "Менеджер отдела продаж", "Контроль работы агентов,\nутверждение сложных случаев", $tags="сотрудник")

' Центральная система
System(osago_system, "Система оформления полисов", "Главная разрабатываемая информационная система\nдля оформления страховых полисов ОСАГО")

' Внешние системы (серые)
System_Ext(email_sys, "E-mail система", "Внутренняя система обмена письмами", $tags="внешняя_система")
System_Ext(ais_osago, "АИС ОСАГО", "Автоматизированная информационная\nсистема страхования (РСА / единая база)", $tags="внешняя_система")

' === СВЯЗИ ===

' Страховой агент -> Система оформления полисов
Rel(agent, osago_system, "Заполняет документы\nи оформляет полис ОСАГО")

' Клиент -> Система оформления полисов
Rel(client, osago_system, "Клиент оставил заявку\nна оформление полиса")

' Менеджер -> Система оформления полисов
Rel(manager, osago_system, "Контролирует работу агентов,\nутверждает сложные случаи,\nпросматривает отчёты")

' Система оформления полисов -> E-mail система
Rel(osago_system, email_sys, "Отправляет письма,\nиспользуя")

' E-mail система -> Клиент (пунктир — доставка)
Rel(email_sys, client, "Отправка полиса", $tags="пунктир")

' АИС ОСАГО -> Система оформления полисов
Rel(ais_osago, osago_system, "Предоставляет данные о полисах ОСАГО\nили Проверяет действительность полисов")

' === УПРАВЛЕНИЕ LAYOUT (скрытые связи) ===

' Акторы сверху в ряд
agent -[hidden]right- manager
manager -[hidden]right- client

' Спуск к центральной системе
agent -[hidden]down- osago_system

' Внешние системы по бокам
osago_system -[hidden]right- email_sys
osago_system -[hidden]down- ais_osago

@enduml
