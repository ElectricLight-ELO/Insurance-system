@startuml
!include <C4/C4_Dynamic>
!include ../common.inc
LAYOUT_TOP_DOWN()
title Динамическая диаграмма — расчёт, оформление и оплата полиса ОСАГО в Web App

Person(client, "Клиент или агент", "Оформляет полис")
Person(payer, "Застрахованный клиент", "Оплачивает полис")
Container_Boundary(web, "Web App (React SPA)") {
  Component(p_calc, "CalculatorPage", "React Page", "Расчёт стоимости")
  Component(p_buy, "CheckoutPage", "React Page", "Оформление и оплата")
  Component(l_pol, "PolicyLogic", "React Hooks", "Расчёт, оформление, оплата")
  Component(a_pol, "PolicyApiClient", "TypeScript", "Расчёт, оформление, оплата, PDF")
  Component(http, "HttpClient", "axios", "Токен в каждом запросе, 401/403, повторы")
  Component(l_auth, "AuthLogic", "React Context", "Токен и роль пользователя")
}
Container_Boundary(api, "API (FastAPI)") {
  Component(c_pol, "PolicyController", "FastAPI Router", "Расчёт и оформление полиса")
  Component(c_pay, "PaymentController", "FastAPI Router", "Оплата, webhook")
  Component(s_acc, "AccessService", "Python · Strategy", "Проверка прав (RBAC)")
  Component(s_pol, "PolicyService", "Python", "Премия, полис")
  Component(s_pay, "PaymentService", "Python", "Сессия, обработка webhook")
  Component(r_tar, "TariffRepository", "SQLAlchemy", "Тарифы и коэффициенты")
  Component(f_ais, "AisOsagoFacade", "HTTP Client", "КБМ, проверки, регистрация")
  Component(r_user, "UserRepository", "SQLAlchemy", "Пользователи, полисы")
  Component(f_pay, "PaymentGatewayFacade", "HTTP Client", "Платёжные сессии")
  Component(f_task, "TaskQueueFacade", "SQL Client", "Задачи в очередь для Worker")
  Component(r_acc, "AccidentRepository", "SQLAlchemy", "Транзакции, очередь задач")
}
ContainerDb(db_tar, "DB_TARIFS", "PostgreSQL", "Тарифы, коэффициенты")
ContainerDb(db_usr, "DB_USERS", "PostgreSQL", "Пользователи, полисы")
ContainerDb(db_aud, "DB_AUDIT", "PostgreSQL", "Транзакции, outbox")
Container(worker, "Worker", "Python / Celery", "Регистрация договора, PDF, письма")
System_Ext(ais, "АИС ОСАГО (РСА)", "КБМ, проверки, регистрация", $tags="ext")
System_Ext(pay, "Платёжная система", "Платёжные сессии", $tags="ext")
System_Ext(email, "E-mail система", "Доставка полиса", $tags="ext")

Rel(client, p_calc, "Вводит данные ТС, водителей и регион", "HTTPS")
Rel(p_calc, l_pol, "calculate(data)", "React Hooks")
Rel(l_pol, a_pol, "calculate(data)", "TypeScript call")
Rel(a_pol, http, "POST /api/policies/calculate", "TypeScript call")
Rel(http, c_pol, "calculate_premium(payload)", "REST/HTTPS, JSON")
Rel(c_pol, s_pol, "calculate_premium(data)", "Python Call")
Rel(s_pol, r_tar, "get_coefficients()", "Python Call")
Rel(r_tar, db_tar, "Читает тариф и коэффициенты региона", "SQL")
Rel(s_pol, f_ais, "get_kbm(), check_vehicle(), check_drivers()", "Python Call")
Rel(f_ais, ais, "Запрос КБМ и проверка ТС и водителей", "HTTPS, JSON, mTLS")
Rel(client, p_buy, "Подтверждает оформление", "HTTPS")
Rel(p_buy, l_pol, "issue(draft)", "React Hooks")
Rel(l_pol, a_pol, "issue(draft)", "TypeScript call")
Rel(a_pol, http, "POST /api/policies", "TypeScript call")
Rel(http, l_auth, "getToken()", "React Context")
Rel(http, c_pol, "issue_policy(payload)", "REST/HTTPS, JSON")
Rel(c_pol, s_acc, "check_permission(token, «policy.issue»)", "Python Call")
Rel(c_pol, s_pol, "issue_policy(draft)", "Python Call")
Rel(s_pol, r_user, "save_policy(policy)", "Python Call")
Rel(r_user, db_usr, "Сохраняет полис (status = awaiting_payment)", "SQL")
Rel(p_buy, l_pol, "pay(policyId)", "React Hooks")
Rel(l_pol, a_pol, "pay(policyId)", "TypeScript call")
Rel(a_pol, http, "POST /api/payments/session", "TypeScript call")
Rel(http, c_pay, "create_session(payload)", "REST/HTTPS, JSON")
Rel(c_pay, s_pay, "create_session(policy_id, amount)", "Python Call")
Rel(s_pay, f_pay, "create_session(policy_id, amount)", "Python Call")
Rel(f_pay, pay, "Создаёт платёжную сессию, возвращает ссылку", "HTTPS, JSON")
Rel(payer, pay, "Оплачивает полис", "HTTPS")
Rel(pay, c_pay, "POST /api/payments/webhook — handle_webhook()", "HTTPS, JSON")
Rel(c_pay, s_pay, "handle_webhook(event)", "Python Call")
Rel(s_pay, r_acc, "save_transaction(tx)", "Python Call")
Rel(s_pay, f_task, "enqueue(CONTRACT_REG), enqueue(PDF_POLICY)", "Python Call")
Rel(f_task, r_acc, "save_task(task)", "Python Call")
Rel(r_acc, db_aud, "Транзакция и две задачи в outbox (pending)", "SQL")
Rel(worker, db_aud, "list_pending_tasks(): CONTRACT_REG, PDF_POLICY", "SQL")
Rel(worker, ais, "register_policy(policy_data)", "HTTPS, JSON, mTLS", $tags="async")
Rel(worker, email, "Отправляет PDF полиса и чек", "SMTP / STARTTLS", $tags="async")
Rel(email, client, "Доставляет электронный полис", "E-mail", $tags="async")
SHOW_LEGEND()
@enduml
