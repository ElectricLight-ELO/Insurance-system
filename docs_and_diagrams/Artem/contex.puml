@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
 
title КЛИЕНТ C4 CONTEXT
 
' === НАСТРОЙКА ЦВЕТОВ ===
' Создаем тег для серых внешних систем (как на фото)
AddSystemTag("внешняя_система", $bgColor="#A9A9A9", $borderColor="#8A8A8A", $fontColor="#FFFFFF")
 
' Создаем тег для фиолетового центрального сервиса (как на фото)
AddSystemTag("фиолетовый_сервис", $bgColor="#B39DDB", $borderColor="#9575CD", $fontColor="#000000")
 
' Создаем тег для пунктирной линии
AddRelTag("пунктир", $lineStyle = DashedLine(), $lineColor = "#000000")
 
' === ЭЛЕМЕНТЫ ===
 
Person(client, "Клиент", "Пользователь, оформляющий полис")
 
' Применяем фиолетовый тег к центральному сервису
System(service, "Информационная система оформления ОСАГО (ИС ОСАГО)", "Cервис Осаго")
 
' Применяем серый тег к внешним системам
System(payment_sys, "Платежная система", "Внешняя система проведения платежей", $tags="внешняя_система")
System(email_sys, "E-mail система", "Внутренняя система обмена письмами", $tags="внешняя_система")
System(ais_osago, "АИС ОСАГО", "Автоматизированная информационная система", $tags="внешняя_система")
 
' === СВЯЗИ ===
 
' Связь Клиент -> Сервис
Rel(client, service, "Вводит данные, выбирает опции,\nоплачивает и получает полис ОСАГО")
 
' Связь Сервис -> Платежная система
Rel(service, payment_sys, "Инициирует платеж,\nполучает статус оплаты")
 
' Связь Сервис -> E-mail система
Rel(service, email_sys, "Отправляет сведения на\nполис и чека")
 
' Связь Сервис -> АИС ОСАГО
Rel(service, ais_osago, "Передача КЗМ, регистрация полиса")
 
' Пунктирная связь E-mail система -> Клиент
Rel(email_sys, client, "Доставка письма со ссылкой на полис и чеком", $tags="пунктир")
 
@enduml