@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title Сервис оформления ОСАГО для физлиц. C4 Context

' === НАСТРОЙКА ЦВЕТОВ ===
AddSystemTag("внешняя_система", $bgColor="#A9A9A9", $borderColor="#8A8A8A", $fontColor="#FFFFFF", $legendText="Внешняя система")
AddSystemTag("фиолетовый_сервис", $bgColor="#B39DDB", $borderColor="#9575CD", $fontColor="#000000", $legendText="Сервис оформления ОСАГО")
AddRelTag("пунктир", $lineStyle=DashedLine(), $lineColor="#000000", $legendText="Асинхронное взаимодействие (фоновая обработка)")

' === ЭЛЕМЕНТЫ ===

Person(guest, "Гость", "Неавторизованный посетитель,\nрассчитывает стоимость полиса")
Person(client, "Клиент", "Страхователь: оформляет и\nоплачивает полис")
Person(support, "Оператор поддержки", "Отслеживает статусы полисов и платежей,\nперезапускает зависшие задачи")

System(service, "Информационная система оформления ОСАГО (ИС ОСАГО)", "Сервис оформления ОСАГО для физлиц", $tags="фиолетовый_сервис")

System_Ext(payment_sys, "Платежная система", "Проведение платежей", $tags="внешняя_система")
System_Ext(email_sys, "E-mail сервис", "Почтовый сервис рассылки", $tags="внешняя_система")
System_Ext(ais_osago, "АИС ОСАГО (РСА)", "КБМ, проверка ТС и водителей,\nрегистрация договоров", $tags="внешняя_система")
System_Ext(sms_sys, "SMS-шлюз", "Отправка одноразовых кодов", $tags="внешняя_система")

' === СВЯЗИ ===

' Персоны -> Сервис
Rel(guest, service, "Рассчитывает стоимость\nбез регистрации")
Rel(client, service, "Вводит данные, загружает фото,\nоплачивает, получает полис ОСАГО")
Rel(support, service, "Ищет полисы, смотрит статусы,\nперезапускает задачи")

' Сервис -> внешние системы
Rel(service, payment_sys, "Создает платежную сессию,\nполучает уведомление об оплате")
Rel(service, sms_sys, "Отправляет одноразовый код\nдля авторизации клиента")
Rel(service, ais_osago, "Запрашивает КБМ, проверяет ТС и водителей,\nрегистрирует договор после оплаты")
Rel(service, email_sys, "Отправляет клиенту письмо со ссылкой\nна полис и чек (повтор при сбое)", $tags="пунктир")

' === УПРАВЛЕНИЕ LAYOUT (скрытые связи) ===

' Персоны в один ряд
guest -[hidden]right- client
client -[hidden]right- support

' Сервис под персонами
client -[hidden]down- service

' Внешние системы в один ряд внизу
service -[hidden]down- email_sys
payment_sys -[hidden]right- email_sys
email_sys -[hidden]right- ais_osago
ais_osago -[hidden]right- sms_sys

SHOW_LEGEND()
@enduml
