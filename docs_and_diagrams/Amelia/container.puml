@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title АДМИНИСТРАТОР C4 CONTAINER (Microservices DB Partitioning)

AddSystemTag("внешняя_система", $bgColor="#A9A9A9", $borderColor="#8A8A8A", $fontColor="#FFFFFF")
AddPersonTag("сотрудник", $bgColor="#438DD5", $borderColor="#316CA5", $fontColor="#FFFFFF")
AddRelTag("пунктир", $lineStyle = DashedLine(), $lineColor = "#000000")
AddPersonTag("персона_синяя", $bgColor="#1F4E8C", $borderColor="#143560", $fontColor="#FFFFFF")

Person(admin, "Администратор", "Системный администратор ИС ОСАГО,\nимеет права всех ролей", $tags="персона_синяя")
Person(accountant, "Бухгалтер", "Финансовый специалист страховой компании,\nпроверяет маржу, подписывает отчеты", $tags="персона_синяя")
Person(auditor, "Сотрудник ИБ", "Изучает журнал аудита,\nрасследует инциденты", $tags="персона_синяя")

System_Boundary(osago_service, "Информационная система оформления ОСАГО (ИС ОСАГО)") {

    Container(web_app, "Web App", "React SPA", "Админ-панель: пользователи, роли,\nтарифы, журнал аудита, задачи")

    Container(api, "API", "FASTAPI", "REST/HTTPS JSON — авторизация (RBAC),\nадминистрирование, управление тарифами")

    ContainerDb(db_users, "BD_USERS", "PostgreSQL", "Хранит пользователей, роли, права доступа (RBAC)")
    ContainerDb(db_tarifs, "BD_TARIFS", "PostgreSQL", "Хранит тарифные сетки, коэффициенты и правила расчета")
    ContainerDb(db_audit, "BD_AUDIT", "PostgreSQL", "Журнал событий аудита и очередь асинхронных задач")
    ContainerDb(object_storage, "BD_DTP", "MongoDB", "Хранит фото ДТП, подписи и файлы документов")

    Container(worker, "Worker", "Python", "Асинхронная обработка: повтор сбойных\nзадач, проверка интеграций, отчеты")
}

System_Ext(payment_sys, "Платежная система", "Внешняя система проведения платежей", $tags="внешняя_система")
System_Ext(email_sys, "E-mail система", "Внутренняя система обмена письмами", $tags="внешняя_система")
System_Ext(ais_osago, "АИС ОСАГО", "Автоматизированная информационная система", $tags="внешняя_система")
System_Ext(sms_sys, "SMS-шлюз", "Отправка одноразовых кодов", $tags="внешняя_система")


Rel(admin, web_app, "Управляет пользователями и ролями,\nнастраивает тарифы, смотрит аудит", "HTTPS")
Rel(accountant, web_app, "Проверяет статусы оплат,\nформирует счета и закрывающие акты", "HTTPS")
Rel(auditor, web_app, "Изучает журнал аудита\nи расследует инциденты", "HTTPS")

Rel(web_app, api, "REST/HTTPS JSON — администрирование,\nуправление задачами")

Rel(api, db_users, "Аутентификация, управление\nпользователями и ролями (SQL)")
Rel(api, db_tarifs, "Чтение и изменение\nтарифов и коэффициентов (SQL)")
Rel(api, db_audit, "Запись событий безопасности\nи системных логов (SQL)")
Rel(api, object_storage, "Просматривает и удаляет\nдокументы и фото (GridFS/BSON)")

Rel(api, worker, "Ставит задачи на повторную\nобработку и формирование отчетов", "SQL, очередь задач в BD_AUDIT")

Rel(api, sms_sys, "Отправляет одноразовый код\nдля входа в систему", "HTTPS, JSON")

Rel(worker, db_audit, "Забирает задачи из очереди\nв статусе pending/failed (SQL)")
Rel(worker, object_storage, "Удаляет устаревшие файлы\nпо политике хранения", "GridFS/BSON")

Rel(worker, payment_sys, "HTTP(S), JSON — проверяет зависшие\nплатежи (по расписанию)", $tags="пунктир")
Rel(worker, ais_osago, "HTTP(S), JSON — повторно регистрирует\nполис (по команде администратора)", $tags="пунктир")
Rel(worker, email_sys, "Отправляет уведомления\nо сбоях и отчеты", "SMTP", $tags="пунктир")

Rel(email_sys, admin, "Доставка уведомлений о сбоях\nи отчетов о работе системы", "E-mail", $tags="пунктир")
Rel(email_sys, accountant, "Доставка счетов, закрывающих актов\nи финансовых отчетов", "E-mail", $tags="пунктир")


auditor -[hidden]right- admin
admin -[hidden]right- accountant

Lay_D(payment_sys, ais_osago)
Lay_D(ais_osago, email_sys)

@enduml
