@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title АДМИНИСТРАТОР C4 CONTEXT

' ============================================================
' Локальное представление: личный кабинет Администратора (сис. админ).
' Администратор обладает правами всех ролей (Клиент, Бухгалтер,
' Аварийный эксперт, Страховой агент), но обособлен от них:
' его задача — управление системой, а не бизнес-операции.
' ============================================================

' === НАСТРОЙКА ЦВЕТОВ (как в общей диаграмме) ===
AddSystemTag("внешняя_система", $bgColor="#A9A9A9", $borderColor="#8A8A8A", $fontColor="#FFFFFF")
AddSystemTag("фиолетовый_сервис", $bgColor="#B39DDB", $borderColor="#9575CD", $fontColor="#000000")
AddPersonTag("сотрудник", $bgColor="#438DD5", $borderColor="#316CA5", $fontColor="#FFFFFF")
AddRelTag("пунктир", $lineStyle = DashedLine(), $lineColor = "#000000")

' === ЭЛЕМЕНТЫ ===

Person(admin, "Администратор", "Системный администратор ИС ОСАГО:\nуправляет пользователями, ролями\nи настройками, имеет права всех ролей", $tags="сотрудник")

System(service, "Информационная система оформления ОСАГО (ИС ОСАГО)", "Cервис Осаго")

System(payment_sys, "Платежная система", "Внешняя система проведения платежей", $tags="внешняя_система")
System(email_sys, "E-mail система", "Внутренняя система обмена письмами", $tags="внешняя_система")
System(ais_osago, "АИС ОСАГО", "Автоматизированная информационная система", $tags="внешняя_система")

' === СВЯЗИ ===

' Администратор -> Сервис
Rel_D(admin, service, "Управляет учетными записями и ролями,\nнастраивает тарифы и справочники,\nпросматривает журнал аудита,\nперезапускает сбойные задачи")

' Сервис -> внешние системы
Rel_D(service, payment_sys, "Сверяет статусы платежей,\nпроверяет доступность")
Rel_D(service, email_sys, "Отправляет уведомления\nоб ошибках и отчеты")
Rel_D(service, ais_osago, "Повторная регистрация полисов,\nпроверка доступности")

' Пунктирная связь E-mail система -> Администратор
Rel_U(email_sys, admin, "Доставка уведомлений о сбоях\nи отчетов о работе системы", $tags="пунктир")

' === УПРАВЛЕНИЕ LAYOUT ===
' Администратор сверху, сервис в центре, внешние системы снизу в ряд
Lay_R(payment_sys, email_sys)
Lay_R(email_sys, ais_osago)

@enduml
