@startuml
title Динамическая диаграмма — Расчет маржи, комиссий и сверка зависших платежей

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

AddSystemTag("внешняя_система", $bgColor="#A9A9A9", $borderColor="#8A8A8A", $fontColor="#FFFFFF")
AddComponentTag("api", $bgColor="#6cc2f5", $borderColor="#3A9BD8", $fontColor="#000000", $legendText="Слой API: контроллеры (FastAPI)")
AddComponentTag("service", $bgColor="#6cc2f5", $borderColor="#2E86C1", $fontColor="#000000", $legendText="Слой бизнес-логики: сервисы")
AddComponentTag("integration", $bgColor="#6cc2f5", $borderColor="#247FB0", $fontColor="#000000", $legendText="Слой интеграции: фасады")
AddComponentTag("data", $bgColor="#6cc2f5", $borderColor="#1B6E9C", $fontColor="#000000", $legendText="Слой данных: репозитории")


Container(web_app, "Web App", "React SPA", "Рабочее место бухгалтера\nи финансового менеджера,\nуправление отчетами")

System_Boundary(api, "API (FastAPI)") {
    Component(c_margin, "MarginController", "FastAPI Router", "Приём REST-запросов:\nрасчет маржи и КВ\nза период", $tags="api")
    Component(c_recon, "ReconciliationController", "FastAPI Router", "Приём REST-запросов:\nзапуск сверки платежей", $tags="api")
    Component(s_margin, "MarginService", "Python Service", "Бизнес-логика расчета маржи,\nагентских комиссий (КВ),\nсобытия аудита", $tags="service")
    Component(s_recon, "ReconciliationService", "Python Service", "Бизнес-логика сверки\nзависших транзакций\nс эквайрингом", $tags="service")
    Component(f_bank, "PaymentGatewayFacade", "HTTP Client", "Изоляция вызова:\nзапрос статусов транзакций\nв Платежной системе", $tags="integration")
    Component(f_task, "TaskQueueFacade", "SQL Client", "Постановка задач\nв очередь outbox", $tags="integration")
    Component(r_audit, "AuditRepository", "SQLAlchemy", "Доступ к аудиту,\nтранзакциям и очереди\nв PostgreSQL", $tags="data")
    Component(r_tariff, "TariffRepository", "SQLAlchemy", "Доступ к тарифным сеткам\nи коэффициентам\nв PostgreSQL", $tags="data")
}

ContainerDb(db_audit, "BD_AUDIT", "PostgreSQL", "Финансовые транзакции,\nсобытия аудита, очередь задач")
ContainerDb(db_tariffs, "BD_TARIFS", "PostgreSQL", "Тарифные сетки и\nставки комиссий (КВ)")

Container(worker, "Worker", "Python / Celery", "Фоновая обработка:\nфоновый расчет маржи,\nпериодическая сверка (Beat)")

System_Ext(bank_sys, "Платежная система / Эквайринг", "Внешний банковский шлюз,\nстатусы платежей", $tags="внешняя_система")
System_Ext(email_sys, "E-mail система", "Доставка финансовых\nотчетов бухгалтеру", $tags="внешняя_система")


' === СЦЕНАРИЙ: ХРОНОЛОГИЯ ВЫЗОВОВ (СКВОЗНОЙ ПРОЦЕСС БУХГАЛТЕРИИ) ===

Rel(web_app, c_margin, "1. Запрос расчета маржи за период — trigger_margin", "REST/HTTPS, JSON")
Rel(c_margin, s_margin, "2. Вызов calculate_period_margin() — инициация расчета", "Python Function Call")
Rel(s_margin, r_tariff, "3. Вызов get_tariffs() — получение тарифных ставок и КВ", "Python Function Call")
Rel(r_tariff, db_tariffs, "4. Чтение тарифных коэффициентов из БД", "SQL / TCP")
Rel(s_margin, r_audit, "5. Вызов get_transactions() — чтение портфеля полисов", "Python Function Call")
Rel(r_audit, db_audit, "6. Чтение финансовых транзакций за период", "SQL / TCP")

Rel(web_app, c_recon, "7. Ручной запуск сверки платежей — trigger_reconciliation", "REST/HTTPS, JSON")
Rel(c_recon, s_recon, "8. Вызов reconcile_payments() — обработка зависших оплат", "Python Function Call")
Rel(s_recon, r_audit, "9. Вызов get_pending_transactions() — поиск зависших оплат", "Python Function Call")
Rel(r_audit, db_audit, "10. Выборка платежей со статусом PENDING", "SQL / TCP")

Rel(s_recon, f_bank, "11. Вызов check_transaction_status() — запрос в банк", "Python Function Call")
Rel(f_bank, bank_sys, "12. Запрос актуальных статусов транзакций", "HTTPS, JSON")

Rel(s_margin, f_task, "13. Вызов enqueue() — постановка фоновой задачи MARGIN_CALC", "Python Function Call")
Rel(f_task, r_audit, "14. Вызов save_task() — запись задачи в очередь outbox", "SQL / TCP")

Rel(worker, db_audit, "15. Celery Beat/Worker: выборка задач и обновление статусов", "SQL / TCP")
Rel(worker, email_sys, "16. Отправка итогового финансового отчета бухгалтеру", "SMTP / HTTPS")


' === УПРАВЛЕНИЕ LAYOUT (СКРЫТЫЕ СВЯЗИ) ===
web_app -[hidden]down- c_margin

c_margin -[hidden]right- c_recon
c_margin -[hidden]down- s_margin
c_recon -[hidden]down- s_recon

s_margin -[hidden]right- s_recon
s_margin -[hidden]down- f_bank
s_recon -[hidden]down- f_task

f_bank -[hidden]right- f_task
f_bank -[hidden]down- r_audit
f_task -[hidden]down- r_tariff

r_audit -[hidden]right- r_tariff
r_audit -[hidden]down- db_audit
r_tariff -[hidden]down- db_tariffs

db_audit -[hidden]right- db_tariffs
db_audit -[hidden]down- worker
worker -[hidden]right- email_sys
db_tariffs -[hidden]down- bank_sys


SHOW_LEGEND()

@enduml