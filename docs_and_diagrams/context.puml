@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title ОБЩАЯ C4 CONTEXT — ИС ОСАГО/КАСКО



' === НАСТРОЙКА ЦВЕТОВ ===

' Серые внешние системы
AddSystemTag("внешняя_система", $bgColor="#A9A9A9", $borderColor="#8A8A8A", $fontColor="#FFFFFF")

' Голубая центральная система
AddSystemTag("основная_система", $bgColor="#438DD5", $borderColor="#316CA5", $fontColor="#FFFFFF")

' Тёмно-синие люди (клиенты и сотрудники)
AddPersonTag("человек", $bgColor="#1F4E8C", $borderColor="#143560", $fontColor="#FFFFFF")

' Серый неавторизованный посетитель
AddPersonTag("гость", $bgColor="#A9A9A9", $borderColor="#8A8A8A", $fontColor="#FFFFFF")

' Пунктирная линия
AddRelTag("пунктир", $lineStyle = DashedLine(), $lineColor = "#000000")

' === ЭЛЕМЕНТЫ ===

' --- Клиенты (по умолчанию тёмно-синие, гость — серый) ---
Person(guest, "Гость", "Неавторизованный посетитель:\nизучает тарифы и считает премию", $tags="гость")
Person(client, "Клиент", "Страхователь: оформляет полис,\nучастник ДТП", $tags="человек")

' --- Сотрудники страховой ---
Person(admin, "Администратор", "Системный администратор ИС ОСАГО,\nимеет права всех ролей", $tags="человек")
Person(accountant, "Бухгалтер", "Контролирует оплаты и маржу,\nформирует счета и закрывающие акты", $tags="человек")
Person(auditor, "Сотрудник ИБ", "Изучает журнал аудита,\nрасследует инциденты", $tags="человек")
Person(support, "Оператор поддержки", "Отслеживает статусы полисов и платежей,\nперезапускает зависшие задачи", $tags="человек")
Person(dispatcher, "Диспетчер", "Оператор колл-центра: принимает\nзаявления о ДТП, назначает эксперта", $tags="человек")
Person(expert, "Аварийный эксперт", "Выезжает на место ДТП,\nфотографирует осмотр", $tags="человек")
Person(agent, "Страховой агент", "Оформляет полисы клиентам,\nведет базу страхователей", $tags="человек")
Person(manager, "Менеджер отдела продаж", "Контролирует работу агентов,\nутверждает сложные случаи", $tags="человек")

' --- Центральная система ---
System(service, "Информационная система оформления ОСАГО (ИС ОСАГО)", "Модули оформления полисов, продаж,\nадминистрирования и фиксации ДТП", $tags="основная_система")

' --- Внешние системы ---
System(payment_sys, "Платежная система", "Внешняя система проведения платежей", $tags="внешняя_система")
System(email_sys, "E-mail система", "Внутренняя система обмена письмами", $tags="внешняя_система")
System(sms_sys, "SMS-шлюз", "Отправка одноразовых кодов", $tags="внешняя_система")
System(ais_osago, "АИС ОСАГО", "Автоматизированная информационная система", $tags="внешняя_система")

' === СВЯЗИ ===

' Гость и Клиент -> Сервис
Rel(guest, service, "Изучает тарифы, считает премию\nв калькуляторе, регистрируется")
Rel(client, service, "Оформляет и оплачивает полис ОСАГО/КАСКО,\nзаявляет о ДТП, подписывает\nэлектронный протокол осмотра")

' Сотрудники -> Сервис
Rel(admin, service, "Управляет пользователями и ролями,\nнастраивает тарифы, смотрит аудит")
Rel(accountant, service, "Проверяет статусы оплат и маржу,\nформирует счета, акты и отчеты")
Rel(auditor, service, "Изучает журнал аудита,\nрасследует инциденты")
Rel(support, service, "Отслеживает статусы полисов и платежей,\nперезапускает зависшие задачи")
Rel(dispatcher, service, "Регистрирует заявления о ДТП,\nназначает эксперта, отслеживает статус")
Rel(expert, service, "Загружает фотографии осмотра\nи сведения о ДТП, формирует протокол")
Rel(agent, service, "Оформляет полисы от имени клиентов,\nпередает данные по комиссии (КВ)")
Rel(manager, service, "Смотрит отчёты по продажам, управляет\nагентами, утверждает сложные случаи")

' Сервис -> внешние системы
Rel(service, payment_sys, "Инициирует платеж,\nполучает статус оплаты")
Rel(service, sms_sys, "Отправляет одноразовые коды\nавторизации")
Rel(service, email_sys, "Отправляет полис, чек,\nсчета и протокол осмотра")
Rel(service, ais_osago, "Проверка КБМ, ТС и водителей,\nрегистрация договора")

' E-mail система -> получатели (пунктир)
Rel(email_sys, client, "Доставка письма со ссылкой на полис,\nчеком и протоколом осмотра", $tags="пунктир")
Rel(email_sys, accountant, "Доставка счетов\nи закрывающих актов", $tags="пунктир")
Rel(email_sys, admin, "Доставка уведомлений о сбоях\nи отчетов о работе системы", $tags="пунктир")

' === УПРАВЛЕНИЕ LAYOUT (скрытые связи) ===

' Клиенты слева
guest -[hidden]down- client
client -[hidden]right- service

' Сотрудники справа, двумя колонками
service -[hidden]right- admin
admin -[hidden]down- accountant
accountant -[hidden]down- auditor
auditor -[hidden]down- support
admin -[hidden]right- dispatcher
dispatcher -[hidden]down- expert
expert -[hidden]down- agent
agent -[hidden]down- manager

' Внешние системы снизу в ряд
service -[hidden]down- payment_sys
payment_sys -[hidden]right- email_sys
email_sys -[hidden]right- sms_sys
sms_sys -[hidden]right- ais_osago

@enduml
