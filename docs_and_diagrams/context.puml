@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title Сервис оформления ОСАГО для физлиц. C4 Context

' === НАСТРОЙКА ЦВЕТОВ ===
AddSystemTag("внешняя_система", $bgColor="#A9A9A9", $borderColor="#8A8A8A", $fontColor="#FFFFFF", $legendText="Внешняя система")
AddSystemTag("фиолетовый_сервис", $bgColor="#B39DDB", $borderColor="#9575CD", $fontColor="#000000", $legendText="Сервис оформления ОСАГО")
AddPersonTag("серый_персона", $bgColor="#A9A9A9", $borderColor="#8A8A8A", $fontColor="#FFFFFF", $legendText="Застрахованный клиент")
AddRelTag("пунктир", $lineStyle=DashedLine(), $lineColor="#000000", $legendText="Асинхронное взаимодействие (фоновая обработка)")

' === ЭЛЕМЕНТЫ ===

Person(guest, "Гость", "Неавторизованный посетитель,\nрассчитывает стоимость полиса", $tags="серый_персона")
Person(client, "Клиент", "Страхователь: оформляет и\nоплачивает полис")
Person(support, "Оператор поддержки", "Отслеживает статусы полисов и платежей,\nперезапускает зависшие задачи")
Person(insured, "Застрахованный клиент", "Застрахованное лицо,\nсовершающее оплату полиса", $tags="серый_персона")

Person(agent, "Страховой агент", "Специалист страховой компании,\nработающий с клиентами")
Person(manager, "Менеджер отдела продаж", "Контроль работы агентов,\nутверждение сложных случаев")
Person(accountant, "Бухгалтер", "Финансовый специалист страховой компании,\nпроверяет маржу, подписывает отчеты")

System(service, "Информационная система оформления ОСАГО (ИС ОСАГО)", "Сервис оформления ОСАГО для физлиц", $tags="фиолетовый_сервис")

System_Ext(payment_sys, "Платежная система", "Проведение платежей, чистые поступления, комиссии", $tags="внешняя_система")
System_Ext(email_sys, "E-mail сервис", "Почтовый сервис рассылки", $tags="внешняя_система")
System_Ext(ais_osago, "АИС ОСАГО (РСА)", "КБМ, проверка ТС и водителей,\nтарифы, регистрация договоров", $tags="внешняя_система")
System_Ext(sms_sys, "SMS-шлюз", "Отправка одноразовых кодов", $tags="внешняя_система")

' === СВЯЗИ ===

' Персоны -> Сервис
Rel(guest, service, "Рассчитывает стоимость\nбез регистрации")
Rel(client, service, "Вводит данные, загружает фото,\nподаёт заявку, оплачивает,\nполучает полис ОСАГО")
Rel(support, service, "Ищет полисы, смотрит статусы,\nперезапускает задачи")
Rel(agent, service, "Составляет договоры, оформляет полисы,\nпередаёт данные о полисах\nи размере комиссии (КВ)")
Rel(manager, service, "Просматривает отчёты по продажам,\nуправляет списком агентов,\nутверждает сложные случаи")
Rel(accountant, service, "Запрашивает финансовую статистику,\nпроверяет маржу, подписывает отчеты")

' Застрахованный клиент -> Платежная система
Rel(insured, payment_sys, "Оплачивает полис")

' Сервис -> внешние системы
Rel(service, payment_sys, "Создает платежную сессию, получает уведомление\nоб оплате и отчеты о чистых поступлениях\nи комиссиях, сверяет зависшие платежи")
Rel(service, sms_sys, "Отправляет одноразовый код\nдля авторизации клиента")
Rel(service, ais_osago, "Запрашивает КБМ, тарифы, проверяет ТС и водителей,\nрегистрирует договор после оплаты\n(повтор при ошибке/таймауте)")
Rel(service, email_sys, "Отправляет письмо со ссылкой на полис,\nчек, уведомления и отчеты (повтор при сбое)", $tags="пунктир")

' Внешние системы -> Персоны
Rel(email_sys, client, "Доставляет информацию\nи договоры клиенту", $tags="пунктир")

' === УПРАВЛЕНИЕ LAYOUT (скрытые связи) ===

' Первый ряд персон
guest -[hidden]right- client
client -[hidden]right- support
support -[hidden]right- insured

' Второй ряд персон
agent -[hidden]right- manager
manager -[hidden]right- accountant

' Ряды друг под другом, сервис под ними
guest -[hidden]down- agent
client -[hidden]down- manager
manager -[hidden]down- service

' Внешние системы в один ряд внизу
service -[hidden]down- email_sys
payment_sys -[hidden]right- email_sys
email_sys -[hidden]right- ais_osago
ais_osago -[hidden]right- sms_sys

@enduml