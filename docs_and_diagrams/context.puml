@startuml
!include <C4/C4_Context>
title ОБЩАЯ C4 CONTEXT — ИС ОСАГО/КАСКО

' ============================================================
' НАВИГАЦИЯ ДЛЯ КОМАНДЫ (5 участников = 5 контейнеров на C2):
' 1. Web App        (React SPA)  — публичный портал + рабочие места сотрудников
' 2. API            (FastAPI)    — точка входа, бизнес-логика, авторизация
' 3. Worker         (Python)     — PDF, рассылки, регистрация полисов, сверка оплат
' 4. Database       (PostgreSQL) — полисы, страхователи, пользователи, акты ДТП
' 5. Object Storage (S3 / MinIO) — фото ДТП, сканы документов, подписи
' Роли на этой диаграмме сгруппированы так, чтобы каждый контейнер
' имел своего заказчика-актора:
'   Web App        <- Гость, Клиент, Агент, Бухгалтер, Эксперт
'   API            <- все роли + внешние системы
'   Worker         <- Бухгалтер (счета/сверки), Эксперт (протокол), Клиент (полис)
'   Database       <- Агент (база страхователей), Бухгалтер (платежи)
'   Object Storage <- Эксперт (фото ДТП), Клиент (сканы/подписи)
' ============================================================

' === НАСТРОЙКА ЦВЕТОВ ===
' Серые внешние системы
AddSystemTag("внешняя_система", $bgColor="#A9A9A9", $borderColor="#8A8A8A", $fontColor="#FFFFFF")

' Фиолетовый центральный сервис
AddSystemTag("фиолетовый_сервис", $bgColor="#B39DDB", $borderColor="#9575CD", $fontColor="#000000")

' Голубой оттенок для сотрудников страховой
AddPersonTag("сотрудник", $bgColor="#438DD5", $borderColor="#316CA5", $fontColor="#FFFFFF")

' Пунктирная линия
AddRelTag("пунктир", $lineStyle = DashedLine(), $lineColor = "#000000")

' === ЭЛЕМЕНТЫ ===

' --- Клиентская часть ---
Person(guest, "Гость", "Неавторизованный посетитель:\nизучает тарифы и считает премию")
Person(client, "Клиент", "Страхователь: оформляет полис,\nучастник ДТП")

' --- Сотрудники страховой ---
Person(agent, "Страховой агент", "Оформляет полисы клиентам,\nведет базу страхователей", $tags="сотрудник")
Person(accountant, "Бухгалтер", "Контролирует оплаты,\nформирует счета и акты", $tags="сотрудник")
Person(expert, "Аварийный эксперт", "Выезжает на место ДТП,\nфотографирует осмотр", $tags="сотрудник")

' --- Центральная система ---
System(service, "Информационная система оформления ОСАГО (ИС ОСАГО)", "Cервис Осаго")

' --- Внешние системы ---
System(payment_sys, "Платежная система", "Внешняя система проведения платежей", $tags="внешняя_система")
System(email_sys, "E-mail система", "Внутренняя система обмена письмами", $tags="внешняя_система")
System(ais_osago, "АИС ОСАГО", "Автоматизированная информационная система", $tags="внешняя_система")

' === СВЯЗИ ===

' Гость -> Сервис
Rel(guest, service, "Изучает тарифы, считает премию\nв калькуляторе, регистрируется")

' Клиент -> Сервис
Rel(client, service, "Оформляет и оплачивает полис ОСАГО/КАСКО,\nпродлевает его; заявляет о ДТП,\nподписывает электронный протокол осмотра")

' Страховой агент -> Сервис
Rel(agent, service, "Оформляет полисы от имени клиентов,\nведет базу страхователей,\nвидит свои комиссии")

' Бухгалтер -> Сервис
Rel(accountant, service, "Проверяет статусы оплат,\nформирует счета и закрывающие акты")

' Аварийный эксперт -> Сервис
Rel(expert, service, "Загружает фотографии осмотра\nи сведения о ДТП, формирует протокол")

' Сервис -> Платежная система
Rel(service, payment_sys, "Инициирует платеж,\nполучает статус оплаты")

' Сервис -> E-mail система
Rel(service, email_sys, "Отправляет полис, чек,\nсчета и протокол осмотра")

' Сервис -> АИС ОСАГО
Rel(service, ais_osago, "Передача КЗМ, проверка\nи регистрация полиса")

' Пунктирные связи E-mail система -> получатели
Rel(email_sys, client, "Доставка письма со ссылкой на полис,\nчеком и протоколом осмотра", $tags="пунктир")
Rel(email_sys, accountant, "Доставка счетов\nи закрывающих актов", $tags="пунктир")

' === УПРАВЛЕНИЕ LAYOUT (скрытые связи) ===
' Клиентская группа — слева
guest -[hidden]down- client
client -[hidden]right- service
' Сотрудники — справа столбиком
service -[hidden]right- agent
agent -[hidden]down- accountant
accountant -[hidden]down- expert
' Внешние системы — снизу в ряд
service -[hidden]down- payment_sys
payment_sys -[hidden]right- email_sys
email_sys -[hidden]right- ais_osago


@enduml
