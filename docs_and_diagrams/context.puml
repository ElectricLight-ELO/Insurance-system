@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title Информационная система оформления ОСАГО (ИС ОСАГО). System Context

skinparam nodesep 50
skinparam ranksep 100

' === НАСТРОЙКА ЦВЕТОВ ===
AddSystemTag("внешняя_система", $bgColor="#A9A9A9", $borderColor="#8A8A8A", $fontColor="#FFFFFF")
AddPersonTag("сотрудник", $bgColor="#1F4E8C", $borderColor="#143560", $fontColor="#FFFFFF")
AddPersonTag("внешний", $bgColor="#A9A9A9", $borderColor="#8A8A8A", $fontColor="#FFFFFF")
AddRelTag("пунктир", $lineStyle=DashedLine(), $lineColor="#000000", $legendText="Асинхронное взаимодействие (фоновая обработка)")

' === ПЕРСОНЫ (11) ===
Person(guest, "Гость", "Неавторизованный посетитель,\nрассчитывает стоимость полиса", $tags="внешний")
Person(agent, "Страховой агент", "Специалист, оформляющий полисы,\nработает с клиентами, передает данные\nпо комиссии (КВ)", $tags="сотрудник")
Person(manager, "Менеджер отдела продаж", "Контроль работы агентов, отчеты по продажам,\nутверждение сложных случаев", $tags="сотрудник")
Person(dispatcher, "Диспетчер", "Оператор колл-центра: принимает заявления о ДТП,\nназначает эксперта, отслеживает статус", $tags="сотрудник")
Person(expert, "Аварийный эксперт", "Выезжает на место ДТП, загружает\nфото осмотра и сведения о ДТП", $tags="сотрудник")
Person(support, "Оператор поддержки", "Отслеживает статусы полисов и платежей,\nперезапускает зависшие задачи", $tags="сотрудник")
Person(auditor, "Сотрудник ИБ", "Изучает журнал аудита,\nрасследует инциденты", $tags="сотрудник")
Person(accountant, "Бухгалтер", "Проверяет маржу и статусы оплат,\nформирует счета и акты, подписывает отчеты", $tags="сотрудник")
Person(admin, "Администратор", "Права всех ролей: пользователи,\nроли, тарифы, аудит, задачи", $tags="сотрудник")
Person(client, "Клиент", "Участник ДТП (страхователь или потерпевший):\nподает заявку, загружает фото, получает полис,\nставит подпись на протоколе осмотра", $tags="сотрудник")
Person(payer, "Застрахованный клиент", "Застрахованное лицо,\nсовершающее оплату полиса", $tags="внешний")

' === ЦЕНТРАЛЬНАЯ СИСТЕМА ===
System(osago, "Информационная система оформления ОСАГО (ИС ОСАГО)", "Расчет премии, оформление и оплата полисов, фиксация ДТП и осмотр,\nавторизация (RBAC), администрирование и тарифы, аудит,\nфинансовый контроль и верификация маржи, фоновая обработка задач")

' === ВНЕШНИЕ СИСТЕМЫ ===
System_Ext(email_sys, "E-mail система", "Рассылка и обмен письмами: полисы, чеки, протоколы,\nсчета, акты, отчеты, уведомления о сбоях", $tags="внешняя_система")
System_Ext(payment_sys, "Платежная система", "Платежные сессии, webhook об оплате,\nпоступления, комиссии, сверка платежей", $tags="внешняя_система")
System_Ext(ais_osago, "АИС ОСАГО (РСА)", "КБМ, проверка ТС, водителей и полиса,\nрегистрация договоров, актуальные тарифы", $tags="внешняя_система")
System_Ext(sms_sys, "SMS-шлюз", "Отправка одноразовых кодов", $tags="внешняя_система")

' === ПЕРСОНЫ -> СИСТЕМА ===
Rel_D(guest, osago, "Рассчитывает стоимость без регистрации", "HTTPS")
Rel_D(agent, osago, "Оформляет полисы и договоры,\nпередает данные о продажах и КВ", "HTTPS, REST")
Rel_D(manager, osago, "Смотрит отчеты, управляет агентами,\nутверждает сложные случаи", "HTTPS")
Rel_D(dispatcher, osago, "Регистрирует заявления о ДТП,\nназначает эксперта", "HTTPS")
Rel_D(expert, osago, "Загружает фото осмотра\nи сведения о ДТП", "HTTPS")
Rel_D(support, osago, "Ищет полисы, смотрит статусы,\nперезапускает задачи", "HTTPS")
Rel_D(auditor, osago, "Изучает журнал аудита,\nрасследует инциденты", "HTTPS")
Rel_D(accountant, osago, "Проверяет маржу и оплаты,\nформирует счета и акты", "HTTPS")
Rel_D(admin, osago, "Управляет пользователями, ролями,\nтарифами, задачами", "HTTPS")
Rel_D(client, osago, "Вводит данные, подает заявку, загружает фото,\nскачивает полис, подписывает протокол", "HTTPS")

' === СИСТЕМА <-> ВНЕШНИЕ СИСТЕМЫ ===
Rel_R(osago, email_sys, "Отправляет полисы, чеки, протоколы, счета,\nотчеты, уведомления о сбоях, вопросы", "SMTP / HTTPS", $tags="пунктир")

Rel_D(osago, payment_sys, "Создает платежную сессию,\nполучает отчеты о поступлениях", "HTTPS, JSON")
Rel_U(payment_sys, osago, "Уведомляет об оплате (webhook)", "HTTPS, JSON")
Rel_D(osago, payment_sys, "Сверяет зависшие платежи\n(по расписанию)", "HTTPS, JSON", $tags="пунктир")

Rel_D(osago, ais_osago, "Запрашивает КБМ и тарифы, проверяет ТС, водителей и полис;\nрегистрирует договор после оплаты", "HTTPS, JSON")
Rel_D(osago, sms_sys, "Отправляет одноразовый код\nдля авторизации", "HTTPS, JSON")

' Оплата — единственная связь застрахованного клиента
Rel_R(payer, payment_sys, "Оплачивает полис", "HTTPS")

' E-mail -> получатели
Rel_U(email_sys, client, "Доставляет полисы, чеки,\nпротоколы осмотра", "E-mail", $tags="пунктир")
Rel_U(email_sys, accountant, "Доставляет счета, акты,\nфинансовые отчеты", "E-mail", $tags="пунктир")
Rel_U(email_sys, admin, "Доставляет уведомления о сбоях\nи отчеты о работе системы", "E-mail", $tags="пунктир")

' === LAYOUT ===
' Персоны одним рядом; клиент, бухгалтер и админ ближе к E-mail системе
Lay_R(guest, agent)
Lay_R(agent, manager)
Lay_R(manager, dispatcher)
Lay_R(dispatcher, expert)
Lay_R(expert, support)
Lay_R(support, auditor)
Lay_R(auditor, accountant)
Lay_R(accountant, admin)
Lay_R(admin, client)

' Нижний ряд внешних систем
Lay_R(payer, payment_sys)
Lay_R(payment_sys, ais_osago)
Lay_R(ais_osago, sms_sys)

@enduml
