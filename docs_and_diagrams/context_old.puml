@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title ОБЩАЯ C4 CONTEXT — ИС ОСАГО/КАСКО

' === НАСТРОЙКА ЦВЕТОВ ===
' Создаем тег для серых внешних систем
AddSystemTag("внешняя_система", $bgColor="#A9A9A9", $borderColor="#8A8A8A", $fontColor="#FFFFFF")

' Создаем тег для фиолетового центрального сервиса
AddSystemTag("фиолетовый_сервис", $bgColor="#B39DDB", $borderColor="#9575CD", $fontColor="#000000")

' Создаем тег для пунктирной линии
AddRelTag("пунктир", $lineStyle = DashedLine(), $lineColor = "#000000")

' === ЭЛЕМЕНТЫ ===

Person(client, "Клиент", "Страхователь: оформляет полис,\nучастник ДТП")

Person_Ext(expert, "Аварийный эксперт", "Сотрудник, выезжающий\nна место ДТП")

' Применяем фиолетовый тег к центральному сервису
System(service, "Информационная система страхования\nОСАГО/КАСКО (ИС ОСАГО-КАСКО)", "Онлайн-оформление полисов\nи фиксация ДТП")

' Применяем серый тег к внешним системам
System(payment_sys, "Платежная система", "Внешняя система проведения платежей", $tags="внешняя_система")
System(email_sys, "E-mail система", "Внутренняя система обмена письмами", $tags="внешняя_система")
System(ais_osago, "АИС ОСАГО", "Автоматизированная информационная система", $tags="внешняя_система")

' === СВЯЗИ ===

' Связь Клиент -> Сервис
Rel(client, service, "Вводит данные, выбирает опции, оплачивает\nи получает полис ОСАГО/КАСКО;\nсообщает о ДТП, подписывает\nэлектронный протокол осмотра")

' Связь Аварийный эксперт -> Сервис
Rel(expert, service, "Загружает фотографии\nрезультатов осмотра и информацию")

' Связь Сервис -> Платежная система
Rel(service, payment_sys, "Инициирует платеж,\nполучает статус оплаты")

' Связь Сервис -> E-mail система
Rel(service, email_sys, "Отправляет сведения на полис,\nчек и протокол осмотра")

' Связь Сервис -> АИС ОСАГО
Rel(service, ais_osago, "Передача КЗМ, регистрация полиса,\nпроверка наличия ОСАГО при ДТП")

' Пунктирная связь E-mail система -> Клиент
Rel(email_sys, client, "Доставка письма со ссылкой на полис,\nчеком и протоколом осмотра", $tags="пунктир")

' === УПРАВЛЕНИЕ LAYOUT (скрытые связи) ===
' Размещаем внешние системы справа от центрального сервиса
service -[hidden]right- payment_sys
payment_sys -[hidden]down- email_sys
email_sys -[hidden]down- ais_osago
' Аварийного эксперта размещаем над клиентом
expert -[hidden]up- client

@enduml
