@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title Информационная система оформления ОСАГО (ИС ОСАГО). System Context

' === НАСТРОЙКА ЦВЕТОВ ===
AddSystemTag("внешняя_система", $bgColor="#A9A9A9", $borderColor="#8A8A8A", $fontColor="#FFFFFF")
AddPersonTag("сотрудник", $bgColor="#1F4E8C", $borderColor="#143560", $fontColor="#FFFFFF")
AddPersonTag("внешний", $bgColor="#A9A9A9", $borderColor="#8A8A8A", $fontColor="#FFFFFF")
AddRelTag("пунктир", $lineStyle=DashedLine(), $lineColor="#000000", $legendText="Асинхронное взаимодействие (фоновая обработка)")

' === ПЕРСОНЫ ===
Person(guest, "Гость", "Неавторизованный посетитель,\nрассчитывает стоимость полиса", $tags="внешний")
Person(client, "Клиент", "Страхователь, застрахованное лицо или потерпевший:\nучастник ДТП, оформляет и оплачивает полис,\nставит электронную подпись на протоколе осмотра", $tags="внешний")

Person(agent, "Страховой агент", "Специалист, оформляющий полисы,\nработает с клиентами и передает данные\nпо комиссии (КВ)", $tags="сотрудник")
Person(manager, "Менеджер отдела продаж", "Контроль работы агентов,\nотчеты по продажам, утверждение сложных случаев", $tags="сотрудник")
Person(dispatcher, "Диспетчер", "Оператор колл-центра: принимает заявления о ДТП,\nназначает эксперта, отслеживает статус", $tags="сотрудник")
Person(expert, "Аварийный эксперт", "Выезжает на место ДТП, загружает\nфото осмотра и сведения о ДТП", $tags="сотрудник")
Person(support, "Оператор поддержки", "Отслеживает статусы полисов и платежей,\nперезапускает зависшие задачи", $tags="сотрудник")
Person(accountant, "Бухгалтер", "Финансовый специалист: проверяет маржу и статусы оплат,\nформирует счета и акты, подписывает отчеты", $tags="сотрудник")
Person(auditor, "Сотрудник ИБ", "Изучает журнал аудита,\nрасследует инциденты", $tags="сотрудник")
Person(admin, "Администратор", "Системный администратор ИС ОСАГО, имеет права всех ролей:\nпользователи, роли, тарифы, аудит, задачи", $tags="сотрудник")

' === ЦЕНТРАЛЬНАЯ СИСТЕМА ===
System(osago, "Информационная система оформления ОСАГО (ИС ОСАГО)", "Расчет премии, оформление и оплата полисов, фиксация ДТП и осмотр,\nавторизация (RBAC), администрирование и тарифы, аудит,\nфинансовый контроль и верификация маржи, фоновая обработка задач")

' === ВНЕШНИЕ СИСТЕМЫ ===
System_Ext(payment_sys, "Платежная система", "Проведение платежей, чистые поступления, комиссии;\nплатежные сессии, уведомления об оплате (webhook),\nсверка зависших платежей", $tags="внешняя_система")
System_Ext(ais_osago, "АИС ОСАГО (РСА)", "Автоматизированная информационная система:\nКБМ, проверка ТС, водителей и наличия полиса,\nрегистрация договоров, актуальные тарифы", $tags="внешняя_система")
System_Ext(email_sys, "E-mail система", "Почтовый сервис рассылки и обмена письмами:\nполисы, чеки, протоколы осмотра, счета, акты,\nотчеты и уведомления о сбоях", $tags="внешняя_система")
System_Ext(sms_sys, "SMS-шлюз", "Отправка одноразовых кодов", $tags="внешняя_система")

' === СВЯЗИ: ПЕРСОНЫ -> СИСТЕМА ===
Rel_D(guest, osago, "Рассчитывает стоимость без регистрации", "HTTPS")
Rel_D(client, osago, "Подает заявку, вводит данные, загружает фото,\nоплачивает, скачивает полис, подписывает протокол", "HTTPS")
Rel_D(agent, osago, "Оформляет полисы и договоры,\nпередает данные о продажах и комиссии (КВ)", "HTTPS, REST")
Rel_D(manager, osago, "Просматривает отчеты по продажам,\nуправляет агентами, утверждает сложные случаи", "HTTPS")
Rel_D(dispatcher, osago, "Регистрирует заявления о ДТП,\nназначает эксперта", "HTTPS")
Rel_D(expert, osago, "Загружает фото осмотра\nи сведения о ДТП", "HTTPS")
Rel_D(support, osago, "Ищет полисы, смотрит статусы,\nперезапускает задачи", "HTTPS")
Rel_D(accountant, osago, "Проверяет маржу и оплаты,\nформирует счета и акты, подписывает отчеты", "HTTPS")
Rel_D(auditor, osago, "Изучает журнал аудита,\nрасследует инциденты", "HTTPS")
Rel_D(admin, osago, "Управляет пользователями, ролями,\nтарифами, задачами, смотрит аудит", "HTTPS")

' === СВЯЗИ: СИСТЕМА <-> ВНЕШНИЕ СИСТЕМЫ ===
' Платежная система
Rel(osago, payment_sys, "Создает платежную сессию,\nполучает отчеты о поступлениях и комиссиях", "HTTPS, JSON")
Rel(payment_sys, osago, "Уведомляет об оплате (webhook)", "HTTPS, JSON")
Rel(osago, payment_sys, "Сверяет зависшие платежи и транзакции\n(по расписанию)", "HTTPS, JSON", $tags="пунктир")
Rel(client, payment_sys, "Оплачивает полис", "HTTPS")

' АИС ОСАГО
Rel(osago, ais_osago, "Запрашивает КБМ и тарифы, проверяет ТС,\nводителей и наличие полиса", "HTTPS, JSON")
Rel(osago, ais_osago, "Регистрирует договор/полис после оплаты\n(повтор при ошибке или таймауте)", "HTTPS, JSON", $tags="пунктир")

' SMS
Rel(osago, sms_sys, "Отправляет одноразовый код\nдля авторизации клиента", "HTTPS, JSON")

' E-mail
Rel(osago, email_sys, "Отправляет полисы, чеки, протоколы осмотра,\nсчета, отчеты и уведомления о сбоях,\nвопросы и корректировки", "SMTP / HTTPS", $tags="пунктир")
Rel(email_sys, client, "Доставляет полисы, договоры, чеки\nи электронные протоколы осмотра", "E-mail", $tags="пунктир")
Rel(email_sys, accountant, "Доставляет счета, акты\nи финансовые отчеты", "E-mail", $tags="пунктир")
Rel(email_sys, admin, "Доставляет уведомления о сбоях\nи отчеты о работе системы", "E-mail", $tags="пунктир")

' === LAYOUT ===
guest -[hidden]right- client
client -[hidden]right- agent
agent -[hidden]right- manager
manager -[hidden]right- dispatcher

expert -[hidden]right- support
support -[hidden]right- accountant
accountant -[hidden]right- auditor
auditor -[hidden]right- admin

guest -[hidden]down- expert
osago -[hidden]down- ais_osago
ais_osago -[hidden]right- payment_sys
payment_sys -[hidden]right- email_sys
email_sys -[hidden]right- sms_sys

@enduml