@startuml
!include <C4/C4_Component>
LAYOUT_TOP_DOWN()
skinparam wrapWidth 220
skinparam maxMessageSize 220
skinparam nodesep 40
skinparam ranksep 60

title API (FastAPI) — компоненты

AddElementTag("changed", $borderColor="#E8590C", $borderThickness="4", $legendText="Изменено / добавлено на ревью")
AddRelTag("async", $lineStyle=DashedLine(), $legendText="Асинхронная связь (уровень 2)")
AddRelTag("rbac", $lineColor="#7048E8", $lineStyle=DashedLine(), $legendText="Проверка прав (RBAC)")
AddRelTag("audit", $lineColor="#8C96A0", $lineStyle=DashedLine(), $legendText="Запись в аудит")

Container_Ext(bo, "Backoffice", "React SPA", "Админ-панель: пользователи, роли, тарифы,\nаудит, задачи; поиск полисов, статусы\nплатежей; аналитика маржи, отчеты")
Container_Ext(web, "Web App", "React SPA", "Расчет, оформление и оплата полиса,\nличный кабинет; рабочие места агента,\nменеджера, диспетчера и эксперта")

Container_Boundary(bnd, "API — FastAPI") {
  ' --- Контроллеры ---
  Component(c_adm, "AdminController", "FastAPI Router", "Пользователи, тарифы,\nаудит, задачи", $tags="changed")
  Component(c_auth, "AuthController", "FastAPI Router", "Вход по\nодноразовому коду", $tags="changed")
  Component(c_insp, "InspectionController", "FastAPI Router", "Результаты осмотра,\nфото, подпись")
  Component(c_acc, "AccidentController", "FastAPI Router", "Заявления о ДТП,\nназначение эксперта")
  Component(c_pay, "PaymentController", "FastAPI Router", "Оплата, webhook", $tags="changed")
  ' --- Сервисы ---
  Component(s_adm, "AdminService", "Python", "Учетные записи, тарифы,\nвопросы клиентам", $tags="changed")
  Component(acc, "AccessService", "Python · Strategy", "Выпуск токена и\nпроверка прав (RBAC)", $tags="changed")
  Component(aud, "AuditService", "Python", "Запись событий аудита\nпо каждому действию")
  Component(s_insp, "InspectionService", "Python", "Акт осмотра, подпись,\nзадача на PDF")
  Component(s_acc, "AccidentService", "Python", "Заявление, проверка\nполиса, назначение", $tags="changed")
  Component(s_pay, "PaymentService", "Python", "Платежная сессия,\nобработка webhook", $tags="changed")
  ' --- Фасады и репозитории ---
  Component(r_tar, "TariffRepository", "SQLAlchemy", "Тарифы, лог отчетов", $tags="changed")
  Component(f_mail, "EmailFacade", "SMTP Client", "Вопросы\nи корректировки", $tags="changed")
  Component(r_user, "UserRepository", "SQLAlchemy", "Пользователи, роли,\nклиенты, полисы", $tags="changed")
  Component(f_sms, "SmsGatewayFacade", "HTTP Client", "Отправка кода", $tags="changed")
  Component(r_acc, "AccidentRepository", "SQLAlchemy", "Заявления, акты,\nаудит и очередь")
  Component(r_file, "FileRepository", "PyMongo", "Фото, подписи,\nPDF")
  Component(f_task, "TaskQueueFacade", "SQL Client", "Задачи в очередь\nдля Worker")
  Component(f_ais, "AisOsagoFacade", "HTTP Client", "КБМ, ТС, водители,\nналичие полиса")
  Component(f_pay, "PaymentGatewayFacade", "HTTP Client", "Сессии, отчеты\nо поступлениях", $tags="changed")
}

ContainerDb_Ext(db_tarifs, "DB_TARIFS", "PostgreSQL", "Тарифные сетки,\nкоэффициенты, правила\nрасчета, результаты\nрасчета маржи")
ContainerDb_Ext(db_users, "DB_USERS", "PostgreSQL", "Пользователи, роли,\nправа (RBAC), клиенты,\nномера полисов")
ContainerDb_Ext(db_audit, "DB_AUDIT", "PostgreSQL", "Аудит, транзакции,\nплатежи, акты ДТП,\nочередь асинхронных\nзадач (outbox)")
ContainerDb_Ext(db_files, "DB_FILES", "MongoDB", "Фото ДТП, подписи,\nдокументы (PDF полисов\nи протоколов)")
System_Ext(email, "E-mail система", "Рассылка и обмен\nписьмами: полисы, чеки,\nпротоколы, счета, акты,\nотчеты, уведомления\nо сбоях")
System_Ext(sms, "SMS-шлюз", "Отправка одноразовых кодов")
Container_Ext(worker, "Worker", "Python / Celery", "Фоновая обработка: PDF,\nрегистрация договора,\nписьма, сверка платежей,\nрасчет маржи, отчеты")
System_Ext(ais, "АИС ОСАГО (РСА)", "КБМ, проверка ТС,\nводителей и полиса,\nрегистрация договоров,\nактуальные тарифы")
System_Ext(pay, "Платежная система", "Платежные сессии,\nwebhook об оплате,\nпоступления, комиссии,\nсверка платежей")

Rel_D(web, c_auth, "")
Rel_D(web, c_insp, "Расчет, оформление, оплата,\nрезультаты осмотра, скачивание полиса", "REST/HTTPS, JSON")
Rel_D(web, c_acc, "")
Rel_D(web, c_pay, "")
Rel_D(bo, c_adm, "Администрирование, тарифы, аудит,\nдашборд, управление задачами", "REST/HTTPS, JSON")
Rel_D(bo, c_auth, "")
Rel_U(pay, c_pay, "Уведомляет об оплате (webhook)", "HTTPS, JSON")
Rel_D(c_pay, s_pay, "")
Rel_D(c_adm, s_adm, "")
Rel_D(c_auth, acc, "")
Rel_D(c_acc, s_acc, "")
Rel_D(c_insp, s_insp, "")
Rel_D(c_adm, acc, "Проверка прав (RBAC)", $tags="rbac")
Rel_D(c_insp, acc, "", $tags="rbac")
Rel_D(c_acc, acc, "", $tags="rbac")
Rel_D(c_pay, acc, "", $tags="rbac")
Rel_R(s_adm, aud, "", $tags="audit")
Rel_L(s_insp, aud, "События аудита", $tags="audit")
Rel_L(s_acc, aud, "", $tags="audit")
Rel_L(s_pay, aud, "", $tags="audit")
Rel_D(s_adm, r_tar, "")
Rel_D(s_adm, r_user, "")
Rel_D(s_adm, f_mail, "")
Rel_D(acc, r_user, "")
Rel_D(acc, f_sms, "")
Rel_D(aud, r_acc, "")
Rel_D(s_insp, r_file, "")
Rel_D(s_insp, f_task, "")
Rel_D(s_acc, r_acc, "")
Rel_D(s_acc, f_ais, "")
Rel_D(s_pay, f_pay, "")
Rel_D(s_pay, f_task, "")
Rel_D(s_adm, f_task, "")
Rel_L(f_task, r_acc, "")
Rel_D(f_pay, pay, "Создает платежную сессию,\nполучает отчеты о поступлениях", "HTTPS, JSON")
Rel_D(f_ais, ais, "Запрашивает КБМ и тарифы, проверяет\nТС, водителей и наличие полиса", "HTTPS, JSON")
Rel_D(f_mail, email, "Отправляет вопросы\nи корректировки", "SMTP / HTTPS")
Rel_D(r_tar, db_tarifs, "Чтение и изменение тарифов,\nзапись лога отчетов", "SQL")
Rel_D(r_user, db_users, "Аутентификация, пользователи,\nроли, клиенты, полисы", "SQL")
Rel_D(f_sms, sms, "Отправляет одноразовый код\nдля авторизации", "HTTPS, JSON")
Rel_D(r_file, db_files, "Фото, подписи, документы; просмотр и\nудаление; выдача PDF по ссылке", "MongoDB driver")
Rel_D(r_acc, db_audit, "Аудит, транзакции, акты ДТП,\nзадачи в outbox", "SQL")
Rel_D(f_task, worker, "Ставит задачи: повтор, отчеты,\nрасчет маржи")

Lay_R(bo, web)
Lay_R(db_tarifs, db_users)
Lay_R(db_users, db_audit)
Lay_R(db_audit, db_files)
Lay_R(db_files, email)
Lay_R(email, sms)
Lay_R(sms, worker)
Lay_R(worker, ais)
Lay_R(ais, pay)
Lay_R(c_adm, c_auth)
Lay_R(c_auth, c_insp)
Lay_R(c_insp, c_acc)
Lay_R(c_acc, c_pay)
Lay_R(s_adm, acc)
Lay_R(acc, aud)
Lay_R(aud, s_insp)
Lay_R(s_insp, s_acc)
Lay_R(s_acc, s_pay)
Lay_R(r_tar, f_mail)
Lay_R(f_mail, r_user)
Lay_R(r_user, f_sms)
Lay_R(f_sms, r_acc)
Lay_R(r_acc, r_file)
Lay_R(r_file, f_task)
Lay_R(f_task, f_ais)
Lay_R(f_ais, f_pay)
SHOW_LEGEND()
@enduml