@startuml
!include <C4/C4_Component>
LAYOUT_TOP_DOWN()
skinparam wrapWidth 220
skinparam maxMessageSize 220
skinparam nodesep 40
skinparam ranksep 60

title Worker (Python / Celery) — компоненты

AddElementTag("changed", $borderColor="#E8590C", $borderThickness="4", $legendText="Изменено / добавлено на ревью")
AddRelTag("async", $lineStyle=DashedLine(), $legendText="Асинхронная связь (уровень 2)")
AddRelTag("rbac", $lineColor="#7048E8", $lineStyle=DashedLine(), $legendText="Проверка прав (RBAC)")
AddRelTag("audit", $lineColor="#8C96A0", $lineStyle=DashedLine(), $legendText="Запись в аудит")

Container_Ext(api, "API", "FastAPI", "REST/HTTPS JSON — расчет премии, оформление,\nоплата, RBAC, фиксация ДТП, администрирование,\nтарифы, финансовый контроль, выдача PDF")

Container_Boundary(bnd, "Worker — Python / Celery") {
  ' --- Прием задач ---
  Component(poll, "OutboxPoller", "Celery Task", "Забирает задачи\nиз outbox", $tags="changed")
  Component(beat, "Scheduler", "Celery Beat", "Задачи\nпо расписанию", $tags="changed")
  ' --- Задачи ---
  Component(t_con, "RegistrationTask", "Celery Task", "Регистрация договора,\nповторная проверка", $tags="changed")
  Component(t_pdf, "PdfTask", "Celery Task", "PDF полисов\nи протоколов", $tags="changed")
  Component(t_cln, "FileCleanupTask", "Celery Task", "Удаление\nустаревших файлов", $tags="changed")
  Component(t_ntf, "NotificationTask", "Celery Task", "Письма: полисы, чеки,\nпротоколы, сбои", $tags="changed")
  Component(t_mar, "MarginCalculationTask", "Celery Task", "Расчет маржи")
  Component(t_rep, "ReportTask", "Celery Task", "Отчеты, счета\nи акты", $tags="changed")
  Component(t_rec, "GatewayReconciliationTask", "Celery Task", "Сверка платежей")
  ' --- Сервисы ---
  Component(s_con, "ContractService", "Python", "Регистрация договора\nв АИС после оплаты", $tags="changed")
  Component(s_doc, "DocumentService", "Python", "Сборка PDF,\nочистка файлов", $tags="changed")
  Component(s_ntf, "NotificationService", "Python", "Шаблоны писем\nи вложения", $tags="changed")
  Component(s_mar, "MarginService", "Python", "Агрегация, расчет\nмаржи и КВ")
  Component(s_rep, "ReportService", "Python", "Отчеты по марже,\nсчета и акты", $tags="changed")
  Component(s_rec, "ReconciliationService", "Python", "Сопоставление\nпоступлений")
  Component(s_aud, "AuditService", "Python", "Статусы задач\nи логи")
  ' --- Фасады и репозитории ---
  Component(f_ais, "AisOsagoFacade", "HTTP Client", "Регистрация договора,\nпроверка полиса", $tags="changed")
  Component(r_file, "FileRepository", "PyMongo", "Фото, подписи, PDF", $tags="changed")
  Component(f_mail, "EmailFacade", "SMTP Client", "Полисы, чеки, счета,\nотчеты, уведомления", $tags="changed")
  Component(r_tar, "TariffRepository", "SQLAlchemy", "Данные для расчета,\nрезультаты маржи", $tags="changed")
  Component(r_tx, "TransactionRepository", "SQLAlchemy", "Транзакции,\nплатежи, КВ", $tags="changed")
  Component(f_pay, "PaymentGatewayFacade", "HTTP Client", "Статусы платежей")
  Component(r_aud, "AuditRepository", "SQLAlchemy", "Outbox, статусы\nзадач, аудит")
}

ContainerDb_Ext(db_files, "DB_FILES", "MongoDB", "Фото ДТП, подписи,\nдокументы (PDF полисов\nи протоколов)")
ContainerDb_Ext(db_tarifs, "DB_TARIFS", "PostgreSQL", "Тарифные сетки,\nкоэффициенты, правила\nрасчета, результаты\nрасчета маржи")
ContainerDb_Ext(db_audit, "DB_AUDIT", "PostgreSQL", "Аудит, транзакции,\nплатежи, акты ДТП,\nочередь асинхронных\nзадач (outbox)")
System_Ext(ais, "АИС ОСАГО (РСА)", "КБМ, проверка ТС,\nводителей и полиса,\nрегистрация договоров,\nактуальные тарифы")
System_Ext(email, "E-mail система", "Рассылка и обмен\nписьмами: полисы, чеки,\nпротоколы, счета, акты,\nотчеты, уведомления\nо сбоях")
System_Ext(pay, "Платежная система", "Платежные сессии,\nwebhook об оплате,\nпоступления, комиссии,\nсверка платежей")

Rel_D(api, poll, "Ставит задачи: повтор, отчеты,\nрасчет маржи")
Rel_D(poll, t_con, "")
Rel_D(poll, t_pdf, "")
Rel_D(poll, t_ntf, "")
Rel_D(poll, t_mar, "")
Rel_D(poll, t_rep, "")
Rel_D(beat, t_cln, "")
Rel_D(beat, t_rep, "")
Rel_D(beat, t_rec, "")
Rel_D(t_con, s_con, "")
Rel_D(t_pdf, s_doc, "")
Rel_D(t_cln, s_doc, "")
Rel_D(t_ntf, s_ntf, "")
Rel_D(t_mar, s_mar, "")
Rel_D(t_rep, s_rep, "")
Rel_D(t_rec, s_rec, "")
Rel_R(s_con, s_aud, "", $tags="audit")
Rel_R(s_doc, s_aud, "", $tags="audit")
Rel_R(s_ntf, s_aud, "", $tags="audit")
Rel_R(s_mar, s_aud, "", $tags="audit")
Rel_R(s_rep, s_aud, "", $tags="audit")
Rel_R(s_rec, s_aud, "Статусы выполнения", $tags="audit")
Rel_D(s_con, f_ais, "")
Rel_D(s_doc, r_file, "")
Rel_D(s_ntf, f_mail, "")
Rel_D(s_ntf, r_file, "")
Rel_D(s_mar, r_tar, "")
Rel_D(s_mar, r_tx, "")
Rel_D(s_rep, r_tar, "")
Rel_D(s_rep, f_mail, "")
Rel_D(s_rec, f_pay, "")
Rel_D(s_rec, r_tx, "")
Rel_D(s_aud, r_aud, "")
Rel_D(poll, r_aud, "Чтение outbox")
Rel_D(f_ais, ais, "Регистрирует договор после оплаты (в т.ч. по команде\nадминистратора), повторная проверка полиса", "HTTPS, JSON", $tags="async")
Rel_D(r_file, db_files, "Читает фото и подписи, сохраняет PDF,\nудаляет устаревшие файлы", "MongoDB driver")
Rel_D(f_mail, email, "Отправляет полисы, чеки, протоколы,\nсчета, отчеты, уведомления о сбоях", "SMTP / HTTPS", $tags="async")
Rel_D(r_tar, db_tarifs, "Читает данные для расчета,\nзаписывает результаты маржи", "SQL")
Rel_D(f_pay, pay, "Сверяет зависшие платежи\n(по расписанию)", "HTTPS, JSON", $tags="async")
Rel_D(r_tx, db_audit, "")
Rel_D(r_aud, db_audit, "Забирает задачи из outbox,\nобновляет статусы, сверяет оплаты", "SQL")

Lay_R(db_files, db_tarifs)
Lay_R(db_tarifs, db_audit)
Lay_R(db_audit, ais)
Lay_R(ais, email)
Lay_R(email, pay)
Lay_R(poll, beat)
Lay_R(t_con, t_pdf)
Lay_R(t_pdf, t_cln)
Lay_R(t_cln, t_ntf)
Lay_R(t_ntf, t_mar)
Lay_R(t_mar, t_rep)
Lay_R(t_rep, t_rec)
Lay_R(s_con, s_doc)
Lay_R(s_doc, s_ntf)
Lay_R(s_ntf, s_mar)
Lay_R(s_mar, s_rep)
Lay_R(s_rep, s_rec)
Lay_R(s_rec, s_aud)
Lay_R(f_ais, r_file)
Lay_R(r_file, f_mail)
Lay_R(f_mail, r_tar)
Lay_R(r_tar, r_tx)
Lay_R(r_tx, f_pay)
Lay_R(f_pay, r_aud)
SHOW_LEGEND()
@enduml