ReconciliationTask&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Celery Task]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;br&gt;Сверка платежей" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D9CD6;strokeWidth=1;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1440" y="388" width="180" height="76" as="geometry"/></mxCell><mxCell id="n_s_con" value="&lt;b&gt;ContractService&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Python]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;br&gt;Регистрация договора&lt;br&gt;в АИС после оплаты" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#E8590C;strokeWidth=3;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="240" y="524" width="180" height="80" as="geometry"/></mxCell><mxCell id="n_s_doc" value="&lt;b&gt;DocumentService&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Python]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;br&gt;Сборка PDF,&lt;br&gt;очистка файлов" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#E8590C;strokeWidth=3;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="524" width="180" height="80" as="geometry"/></mxCell><mxCell id="n_s_ntf" value="&lt;b&gt;NotificationService&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Python]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;br&gt;Шаблоны писем&lt;br&gt;и вложения" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#E8590C;strokeWidth=3;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="840" y="524" width="180" height="80" as="geometry"/></mxCell><mxCell id="n_s_mar" value="&lt;b&gt;MarginService&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Python]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;br&gt;Агрегация, расчет&lt;br&gt;маржи и КВ" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D9CD6;strokeWidth=1;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1040" y="524" width="180" height="80" as="geometry"/></mxCell><mxCell id="n_s_rep" value="&lt;b&gt;ReportService&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Python]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;br&gt;Отчеты по марже,&lt;br&gt;счета и акты" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#E8590C;strokeWidth=3;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1240" y="524" width="180" height="80" as="geometry"/></mxCell><mxCell id="n_s_rec" value="&lt;b&gt;ReconciliationService&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Python]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;br&gt;Сопоставление&lt;br&gt;поступлений" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D9CD6;strokeWidth=1;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1440" y="524" width="180" height="80" as="geometry"/></mxCell><mxCell id="n_s_aud" value="&lt;b&gt;AuditService&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Python]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;br&gt;Статусы задач&lt;br&gt;и логи" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D9CD6;strokeWidth=1;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1640" y="524" width="180" height="80" as="geometry"/></mxCell><mxCell id="n_f_ais" value="&lt;b&gt;AisOsagoFacade&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[HTTP Client]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;br&gt;Регистрация договора,&lt;br&gt;проверка полиса" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#E8590C;strokeWidth=3;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="240" y="742" width="180" height="76" as="geometry"/></mxCell><mxCell id="n_r_file" value="&lt;b&gt;FileRepository&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[PyMongo]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;br&gt;Фото, подписи, PDF" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#E8590C;strokeWidth=3;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="742" width="180" height="76" as="geometry"/></mxCell><mxCell id="n_f_mail" value="&lt;b&gt;EmailFacade&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[SMTP Client]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;br&gt;Полисы, чеки, счета,&lt;br&gt;отчеты, уведомления" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#E8590C;strokeWidth=3;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="840" y="742" width="180" height="76" as="geometry"/></mxCell><mxCell id="n_r_tar" value="&lt;b&gt;TariffRepository&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[SQLAlchemy]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;br&gt;Данные для расчета,&lt;br&gt;результаты маржи" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#E8590C;strokeWidth=3;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1040" y="742" width="180" height="76" as="geometry"/></mxCell><mxCell id="n_r_tx" value="&lt;b&gt;TransactionRepository&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[SQLAlchemy]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;br&gt;Транзакции,&lt;br&gt;платежи, КВ" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#E8590C;strokeWidth=3;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1240" y="742" width="180" height="76" as="geometry"/></mxCell><mxCell id="n_f_pay" value="&lt;b&gt;PaymentGatewayFacade&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[HTTP Client]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;br&gt;Статусы платежей" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D9CD6;strokeWidth=1;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1440" y="742" width="180" height="76" as="geometry"/></mxCell><mxCell id="n_r_aud" value="&lt;b&gt;AuditRepository&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[SQLAlchemy]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;br&gt;Outbox, статусы&lt;br&gt;задач, аудит" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D9CD6;strokeWidth=1;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1640" y="742" width="180" height="76" as="geometry"/></mxCell><mxCell id="n_ais" value="&lt;b&gt;АИС ОСАГО (РСА)&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Внешняя система]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;br&gt;КБМ, проверка ТС,&lt;br&gt;водителей и полиса,&lt;br&gt;регистрация договоров,&lt;br&gt;актуальные тарифы" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#8A8A8A;strokeWidth=1;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="240" y="1085" width="180" height="125" as="geometry"/></mxCell><mxCell id="n_db_files" value="&lt;b&gt;DB_FILES&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[MongoDB]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;br&gt;Фото ДТП, подписи,&lt;br&gt;документы (PDF полисов&lt;br&gt;и протоколов)" style="shape=cylinder3;boundedLbl=1;size=10;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;strokeWidth=1;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="1077" width="180" height="140" as="geometry"/></mxCell><mxCell id="n_email" value="&lt;b&gt;E-mail система&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Внешняя система]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;br&gt;Рассылка и обмен&lt;br&gt;письмами: полисы, чеки,&lt;br&gt;протоколы, счета, акты,&lt;br&gt;отчеты, уведомления&lt;br&gt;о сбоях" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#8A8A8A;strokeWidth=1;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="840" y="1085" width="180" height="125" as="geometry"/></mxCell><mxCell id="n_db_tarifs" value="&lt;b&gt;DB_TARIFS&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[PostgreSQL]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;br&gt;Тарифные сетки,&lt;br&gt;коэффициенты, правила&lt;br&gt;расчета, результаты&lt;br&gt;расчета маржи" style="shape=cylinder3;boundedLbl=1;size=10;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;strokeWidth=1;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1040" y="1077" width="180" height="140" as="geometry"/></mxCell><mxCell id="n_db_audit" value="&lt;b&gt;DB_AUDIT&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[PostgreSQL]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;br&gt;Аудит, транзакции,&lt;br&gt;платежи, акты ДТП,&lt;br&gt;очередь асинхронных&lt;br&gt;задач (outbox)" style="shape=cylinder3;boundedLbl=1;size=10;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;strokeWidth=1;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1240" y="1077" width="180" height="140" as="geometry"/></mxCell><mxCell id="n_pay" value="&lt;b&gt;Платежная система&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Внешняя система]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;br&gt;Платежные сессии,&lt;br&gt;webhook об оплате,&lt;br&gt;поступления, комиссии,&lt;br&gt;сверка платежей" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#8A8A8A;strokeWidth=1;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1440" y="1085" width="180" height="125" as="geometry"/></mxCell><mxCell id="e7" value="Ставит задачи: повтор, отчеты,&lt;br&gt;расчет маржи" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block