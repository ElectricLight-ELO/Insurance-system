<mxfile host="app.diagrams.net"><diagram name="Worker (Python / Celery) — компоненты"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1880" pageHeight="1240"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Worker (Python / Celery) — компоненты" style="text;html=1;fontSize=20;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="0" y="10" width="1880" height="30" as="geometry"/></mxCell><mxCell id="e2" value="&lt;b&gt;Worker — Python / Celery&lt;/b&gt;&lt;br&gt;[Container]" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=10;fontSize=14;" vertex="1" parent="1"><mxGeometry x="195" y="205" width="1655" height="650" as="geometry"/></mxCell><mxCell id="e3" value="Прием задач" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F4F8FC;strokeColor=#C5D5E6;horizontal=0;align=center;verticalAlign=top;fontStyle=1;fontColor=#5A6B7C;fontSize=12;" vertex="1" parent="1"><mxGeometry x="205" y="242" width="1630" height="96" as="geometry"/></mxCell><mxCell id="e4" value="Задачи" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F4F8FC;strokeColor=#C5D5E6;horizontal=0;align=center;verticalAlign=top;fontStyle=1;fontColor=#5A6B7C;fontSize=12;" vertex="1" parent="1"><mxGeometry x="205" y="378" width="1630" height="96" as="geometry"/></mxCell><mxCell id="e5" value="Сервисы" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F4F8FC;strokeColor=#C5D5E6;horizontal=0;align=center;verticalAlign=top;fontStyle=1;fontColor=#5A6B7C;fontSize=12;" vertex="1" parent="1"><mxGeometry x="205" y="514" width="1630" height="100" as="geometry"/></mxCell><mxCell id="e6" value="Фасады и репозитории" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F4F8FC;strokeColor=#C5D5E6;horizontal=0;align=center;verticalAlign=top;fontStyle=1;fontColor=#5A6B7C;fontSize=12;" vertex="1" parent="1"><mxGeometry x="205" y="690" width="1630" height="140" as="geometry"/></mxCell><mxCell id="n_api" value="&lt;b&gt;API&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[FastAPI]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;br&gt;REST/HTTPS JSON — расчет премии, оформление,&lt;br&gt;оплата, RBAC, фиксация ДТП, администрирование,&lt;br&gt;тарифы, финансовый контроль, выдача PDF" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;strokeWidth=1;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="570.0" y="62" width="320" height="100" as="geometry"/></mxCell><mxCell id="n_poll" value="&lt;b&gt;OutboxPoller&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Celery Task]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;br&gt;Забирает задачи&lt;br&gt;из outbox" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#E8590C;strokeWidth=3;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="252" width="180" height="76" as="geometry"/></mxCell><mxCell id="n_beat" value="&lt;b&gt;Scheduler&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Celery Beat]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;br&gt;Задачи&lt;br&gt;по расписанию" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#E8590C;strokeWidth=3;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1240" y="252" width="180" height="76" as="geometry"/></mxCell><mxCell id="n_t_con" value="&lt;b&gt;RegistrationTask&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Celery Task]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;br&gt;Регистрация договора,&lt;br&gt;повторная проверка" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#E8590C;strokeWidth=3;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="240" y="388" width="180" height="76" as="geometry"/></mxCell><mxCell id="n_t_pdf" value="&lt;b&gt;PdfTask&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quo