<mxfile host="app.diagrams.net"><diagram name="API (FastAPI) — компоненты"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="2400" pageHeight="1230"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="API (FastAPI) — компоненты" style="text;html=1;fontSize=20;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="0" y="10" width="2400" height="30" as="geometry"/></mxCell><mxCell id="e2" value="&lt;b&gt;API — FastAPI&lt;/b&gt;&lt;br&gt;[Container]" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=10;fontSize=14;" vertex="1" parent="1"><mxGeometry x="195" y="228" width="1870" height="625" as="geometry"/></mxCell><mxCell id="e3" value="Контроллеры" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F4F8FC;strokeColor=#C5D5E6;horizontal=0;align=center;verticalAlign=top;fontStyle=1;fontColor=#5A6B7C;fontSize=12;" vertex="1" parent="1"><mxGeometry x="205" y="268" width="1850" height="96" as="geometry"/></mxCell><mxCell id="e4" value="Сервисы" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F4F8FC;strokeColor=#C5D5E6;horizontal=0;align=center;verticalAlign=top;fontStyle=1;fontColor=#5A6B7C;fontSize=12;" vertex="1" parent="1"><mxGeometry x="205" y="404" width="1850" height="110" as="geometry"/></mxCell><mxCell id="e5" value="Фасады и репозитории" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F4F8FC;strokeColor=#C5D5E6;horizontal=0;align=center;verticalAlign=top;fontStyle=1;fontColor=#5A6B7C;fontSize=12;" vertex="1" parent="1"><mxGeometry x="205" y="664" width="1850" height="170" as="geometry"/></mxCell><mxCell id="n_bo" value="&lt;b&gt;Backoffice&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[React SPA]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;br&gt;Админ-панель: пользователи, роли, тарифы,&lt;br&gt;аудит, задачи; поиск полисов, статусы&lt;br&gt;платежей; аналитика маржи, отчеты" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;strokeWidth=1;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="580.0" y="62" width="300" height="100" as="geometry"/></mxCell><mxCell id="n_web" value="&lt;b&gt;Web App&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[React SPA]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;br&gt;Расчет, оформление и оплата полиса,&lt;br&gt;личный кабинет; рабочие места агента,&lt;br&gt;менеджера, диспетчера и эксперта" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;strokeWidth=1;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1370.0" y="62" width="320" height="100" as="geometry"/></mxCell><mxCell id="n_c_adm" value="&lt;b&gt;AdminController&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[FastAPI Router]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;br&gt;Пользователи, тарифы,&lt;br&gt;аудит, задачи" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#E8590C;strokeWidth=3;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="278" width="180" height="76" as="geometry"/></mxCell><mxCell id="n_c_auth" value="&lt;b&gt;AuthController&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[FastAPI Router]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;br&gt;Вход по&lt;br&gt;одноразовому коду" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#E8590C;strokeWidth=3;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="840" y="278" width="180" height="76" as="geometry"/></mxCell><mxCell id="n_c_insp" value="&lt;b&gt;InspectionController&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[FastAPI Router]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;br&gt;Результаты осмотра,&lt;br&gt;фото, подпись" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D9CD6;strokeWidth=1;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1240" y="278" width="180" height="76" as="geometry"/></mxCell><mxCell id="n_c_acc" value="&lt;b&gt;AccidentController&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[FastAPI Router]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;br&gt;Заявления о ДТП,&lt;br&gt;назначение эксперта" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D9CD6;strokeWidth=1;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1640" y="278" width="180" height="76" as="geometry"/></mxCell><mxCell id="n_c_pay" value="&lt;b&gt;PaymentController&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[FastAPI Router]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;br&gt;Оплата, webhook" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#E8590C;strokeWidth=3;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1840" y="278" width="180" height="76" as="geometry"/></mxCell><mxCell id="n_s_adm" value="&lt;b&gt;AdminService&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Python]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;br&gt;Учетные записи, тарифы,&lt;br&gt;вопросы клиентам" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#E8590C;strokeWidth=3;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="420" width="180" height="82" as="geometry"/></mxCell><mxCell id="n_acc" value="&lt;b&gt;AccessService&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Python · Strategy]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;br&gt;Выпуск токена и&lt;br&gt;проверка прав (RBAC)" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#E8590C;strokeWidth=3;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="840" y="420" width="180" height="82" as="geometry"/></mxCell><mxCell id="n_aud" value="&lt;b&gt;AuditService&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Python]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;br&gt;Запись событий аудита&lt;br&gt;по каждому действию" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D9CD6;strokeWidth=1;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1040" y="420" width="180" height="82" as="geometry"/></mxCell><mxCell id="n_s_insp" value="&lt;b&gt;InspectionService&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Python]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;br&gt;Акт осмотра, подпись,&lt;br&gt;задача на PDF" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D9CD6;strokeWidth=1;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1240" y="420" width="180" height="82" as="geometry"/></mxCell><mxCell id="n_s_acc" value="&lt;b&gt;AccidentService&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Python]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;br&gt;Заявление, проверка&lt;br&gt;полиса, назначение" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#E8590C;strokeWidth=3;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1640" y="420" width="180" height="82" as="geometry"/></mxCell><mxCell id="n_s_pay" value="&lt;b&gt;PaymentService&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Python]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;br&gt;Платежная сессия,&lt;br&gt;обработка webhook" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#E8590C;strokeWidth=3;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1840" y="420" width="180" height="82" as="geometry"/></mxCell><mxCell id="n_r_tar" value="&lt;b&gt;TariffRepository&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[SQLAlchemy]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;br&gt;Тарифы, лог отчетов" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#E8590C;strokeWidth=3;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="240" y="712" width="180" height="76" as="geometry"/></mxCell><mxCell id="n_f_mail" value="&lt;b&gt;EmailFacade&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[SMTP Client]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;br&gt;Вопросы&lt;br&gt;и корректировки" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#E8590C;strokeWidth=3;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="712" width="180" height="76" as="geometry"/></mxCell><mxCell id="n_r_user" value="&lt;b&gt;UserRepository&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[SQLAlchemy]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;br&gt;Пользователи, роли,&lt;br&gt;клиенты, полисы" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#E8590C;strokeWidth=3;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="712" width="180" height="76" as="geometry"/></mxCell><mxCell id="n_f_sms" value="&lt;b&gt;SmsGatewayFacade&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[HTTP Client]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;br&gt;Отправка кода" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#E8590C;strokeWidth=3;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="840" y="712" width="180" height="76" as="geometry"/></mxCell><mxCell id="n_r_acc" value="&lt;b&gt;AccidentRepository&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[SQLAlchemy]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;br&gt;Заявления, акты,&lt;br&gt;аудит и очередь" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D9CD6;strokeWidth=1;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1040" y="712" width="180" height="76" as="geometry"/></mxCell><mxCell id="n_r_file" value="&lt;b&gt;FileRepository&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[PyMongo]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;br&gt;Фото, подписи,&lt;br&gt;PDF" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D9CD6;strokeWidth=1;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1240" y="712" width="180" height="76" as="geometry"/></mxCell><mxCell id="n_f_task" value="&lt;b&gt;TaskQueueFacade&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[SQL Client]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;br&gt;Задачи в очередь&lt;br&gt;для Worker" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D9CD6;strokeWidth=1;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1440" y="712" width="180" height="76" as="geometry"/></mxCell><mxCell id="n_f_ais" value="&lt;b&gt;AisOsagoFacade&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[HTTP Client]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;br&gt;КБМ, ТС, водители,&lt;br&gt;наличие полиса" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D9CD6;strokeWidth=1;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1640" y="712" width="180" height="76" as="geometry"/></mxCell><mxCell id="n_f_pay" value="&lt;b&gt;PaymentGatewayFacade&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[HTTP Client]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;br&gt;Сессии, отчеты&lt;br&gt;о поступлениях" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#E8590C;strokeWidth=3;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1840" y="712" width="180" height="76" as="geometry"/></mxCell><mxCell id="n_db_tarifs" value="&lt;b&gt;DB_TARIFS&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[PostgreSQL]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;br&gt;Тарифные сетки,&lt;br&gt;коэффициенты, правила&lt;br&gt;расчета, результаты&lt;br&gt;расчета маржи" style="shape=cylinder3;boundedLbl=1;size=10;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;strokeWidth=1;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="240" y="1067" width="180" height="140" as="geometry"/></mxCell><mxCell id="n_email" value="&lt;b&gt;E-mail система&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Внешняя система]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;br&gt;Рассылка и обмен&lt;br&gt;письмами: полисы, чеки,&lt;br&gt;протоколы, счета, акты,&lt;br&gt;отчеты, уведомления&lt;br&gt;о сбоях" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#8A8A8A;strokeWidth=1;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="1075" width="180" height="125" as="geometry"/></mxCell><mxCell id="n_db_users" value="&lt;b&gt;DB_USERS&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[PostgreSQL]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;br&gt;Пользователи, роли,&lt;br&gt;права (RBAC), клиенты,&lt;br&gt;номера полисов" style="shape=cylinder3;boundedLbl=1;size=10;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;strokeWidth=1;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="1067" width="180" height="140" as="geometry"/></mxCell><mxCell id="n_sms" value="&lt;b&gt;SMS-шлюз&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Внешняя система]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;br&gt;Отправка одноразовых кодов" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#8A8A8A;strokeWidth=1;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="840" y="1075" width="180" height="125" as="geometry"/></mxCell><mxCell id="n_db_audit" value="&lt;b&gt;DB_AUDIT&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[PostgreSQL]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;br&gt;Аудит, транзакции,&lt;br&gt;платежи, акты ДТП,&lt;br&gt;очередь асинхронных&lt;br&gt;задач (outbox)" style="shape=cylinder3;boundedLbl=1;size=10;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;strokeWidth=1;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1040" y="1067" width="180" height="140" as="geometry"/></mxCell><mxCell id="n_db_files" value="&lt;b&gt;DB_FILES&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[MongoDB]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;br&gt;Фото ДТП, подписи,&lt;br&gt;документы (PDF полисов&lt;br&gt;и протоколов)" style="shape=cylinder3;boundedLbl=1;size=10;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;strokeWidth=1;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1240" y="1067" width="180" height="140" as="geometry"/></mxCell><mxCell id="n_worker" value="&lt;b&gt;Worker&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Python / Celery]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;br&gt;Фоновая обработка: PDF,&lt;br&gt;регистрация договора,&lt;br&gt;письма, сверка платежей,&lt;br&gt;расчет маржи, отчеты" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;strokeWidth=1;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1440" y="1075" width="180" height="125" as="geometry"/></mxCell><mxCell id="n_ais" value="&lt;b&gt;АИС ОСАГО (РСА)&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Внешняя система]&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;br&gt;КБМ, проверка ТС,&lt;br&gt;водителей и полиса,&lt;br&gt;регистрация договоров,&lt;br&gt;актуальные тарифы" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#8A8A8A;strokeWidth=1;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1640" y="1075" width="180" height="125" as="geometry"/></mxCell><mxCell id="n_pay" value="&lt;b&gt;Платежная система&lt;/b&gt;&lt;br&