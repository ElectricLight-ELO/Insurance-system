  "AuthLogic": [
   "same_role",
   "Одна и та же логика хранения токена и роли; допускается общий пакет фронта."
  ],
  "HttpClient": [
   "same_role",
   "Один и тот же axios-клиент; допускается общий пакет фронта."
  ],
  "AppRouter": [
   "different_role",
   "Разные наборы маршрутов и ролей (Web App — клиент/агент/эксперт, Backoffice — админ/поддержка/финансы)."
  ],
  "AuthApiClient": [
   "different_role",
   "Один и тот же endpoint входа по коду, но разные клиенты; тело запроса задаёт contracts.auth."
  ],
  "AuditService": [
   "different_role",
   "API пишет события аудита, Worker пишет статусы задач и логи."
  ],
  "AisOsagoFacade": [
   "same_interface",
   "API: КБМ, ТС, водители, полис. Worker: регистрация договора, повторная проверка. Нужен ОДИН интерфейс IAisOsagoGateway."
  ],
  "EmailFacade": [
   "same_interface",
   "API: вопросы и корректировки. Worker: полисы, чеки, отчёты. Нужен один интерфейс IEmailGateway."
  ],
  "PaymentGatewayFacade": [
   "same_interface",
   "API: создание сессии и отчёты о поступлениях. Worker: статусы платежей для сверки. Один интерфейс IPaymentGateway."
  ],
  "FileRepository": [
   "same_interface",
   "API пишет фото и подписи, Worker читает их и пишет PDF. Один интерфейс IFileRepository и одна схема документов DB_FILES."
  ],
  "TariffRepository": [
   "same_interface",
   "API читает и меняет тарифы, Worker читает данные для расчёта и пишет маржу. Одна схема DB_TARIFS."
  ]
 },
