@startuml
!include ../core/C4_Component.puml

title C4 COMPONENT — Worker (Python / Celery): Модуль бухгалтерии и финансового контроля

Container(api, "API", "FastAPI", "Приём запросов от Web App,\nзапись задач в очередь outbox")
ContainerDb(db_audit, "DB_AUDIT", "PostgreSQL", "Финансовые транзакции, аудит,\nочередь задач (outbox)")
ContainerDb(db_tarifs, "DB_TARIFS", "PostgreSQL", "Тарифные сетки и\nставки комиссий (КВ)")
ContainerDb(db_files, "DB_FILES", "MongoDB / GridFS", "Финансовые отчеты и акты")

Container_Boundary(worker, "Worker — Python / Celery") {
    Component(beat_poller, "OutboxConsumer / Beat", "Celery Beat & Worker", "Опрос очереди outbox и запуск\nпериодических/фоновых задач")
    Component(margin_worker, "MarginCalcTask", "Celery Task", "Фоновый расчет маржинальности\nпериода и агентских комиссий (КВ)")
    Component(recon_worker, "PaymentReconcileTask", "Celery Task", "Фоновая сверка зависших\nплатежей с эквайрингом")
    Component(report_worker, "ReportGeneratorTask", "Celery Task", "Формирование закрывающих\nфинансовых PDF-отчетов и актов")
    Component(notify_worker, "EmailNotifyTask", "Celery Task", "Отправка готовых отчетов\nи уведомлений бухгалтеру")

    Component(worker_audit_repo, "WorkerAuditRepository", "SQLAlchemy", "Чтение транзакций, обновление\nстатусов и запись аудита в DB_AUDIT")
    Component(worker_tariff_repo, "WorkerTariffRepository", "SQLAlchemy", "Чтение тарифов и ставок КВ\nиз DB_TARIFS")
    Component(worker_files_repo, "WorkerFileRepository", "PyMongo", "Сохранение PDF-отчетов\nв MongoDB / GridFS")
    Component(worker_bank_client, "AcquiringClient", "HTTP Client", "Запрос статусов транзакций\nв платежной системе")
    Component(worker_mail_client, "SmtpClient", "SMTP Client", "Отправка отчетов через\nпочтовый шлюз")
}

System_Ext(payment_sys, "Платежная система / Эквайринг", "Внешний банковский шлюз,\nстатусы платежей", $tags="ext")
System_Ext(email_sys, "E-mail система", "Доставка финансовых отчетов\nи уведомлений бухгалтеру", $tags="ext")

Rel(api, db_audit, "Постановка фоновых задач в outbox", "SQL/TCP 5432")
Rel(beat_poller, db_audit, "Выборка задач из outbox", "SQL/TCP 5432")

Rel(beat_poller, margin_worker, "Запуск задачи расчета маржи и КВ", "Celery / Python")
Rel(beat_poller, recon_worker, "Запуск задачи сверки платежей", "Celery / Python")
Rel(beat_poller, report_worker, "Запуск генерации отчета", "Celery / Python")
Rel(report_worker, notify_worker, "Постановка задачи отправки отчета", "Celery / Python")

Rel(margin_worker, worker_tariff_repo, "Чтение тарифов и ставок КВ", "Python (in-process)")
Rel(margin_worker, worker_audit_repo, "Чтение транзакций и запись аудита", "Python (in-process)")
Rel(recon_worker, worker_audit_repo, "Поиск PENDING и обновление статусов", "Python (in-process)")
Rel(recon_worker, worker_bank_client, "Запрос статуса транзакции", "Python (in-process)")
Rel(report_worker, worker_audit_repo, "Выборка данных для отчета", "Python (in-process)")
Rel(report_worker, worker_files_repo, "Сохранение PDF-отчета", "Python (in-process)")
Rel(notify_worker, worker_mail_client, "Передача отчета на отправку", "Python (in-process)")

Rel(worker_tariff_repo, db_tarifs, "Чтение тарифных сеток и КВ", "SQL/TCP 5432")
Rel(worker_audit_repo, db_audit, "Очередь outbox, транзакции, аудит", "SQL/TCP 5432")
Rel(worker_files_repo, db_files, "Запись PDF-отчетов и актов", "MongoDB/TCP 27017")
Rel(worker_bank_client, payment_sys, "Сверка статусов платежей", "HTTPS, JSON")
Rel(worker_mail_client, email_sys, "Отправка отчетов бухгалтеру", "SMTP / STARTTLS", $tags="async")

SHOW_LEGEND()
@enduml