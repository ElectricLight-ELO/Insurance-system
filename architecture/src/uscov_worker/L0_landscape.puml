@startuml
!include ../core/C4_Context.puml
LAYOUT_TOP_DOWN()
title ИС ОСАГО, фин. контроль и маржа. SYSTEM LANDSCAPE (L0) — модуль бухгалтерии и финансового контроля

Person(accountant, "Бухгалтер", "Ведет финансовый учет,\nконтролирует маржинальность, проверяет отчеты КВ", $tags="staff")
Person(auditor, "Финансовый аудитор", "Анализирует финансовые потоки,\nпроверяет результаты сверки платежей", $tags="staff")
Person(manager, "Руководитель отдела", "Контролирует общую прибыльность\nпортфеля и агентские выплаты", $tags="staff")

Enterprise_Boundary(enterprise, "Корпоративная ИТ-инфраструктура страховой компании") {
    System(mod_finance, "ИС ОСАГО: Фин. контроль и маржа", "Расчет маржинальности периода, выплата КВ,\nавтоматическая сверка транзакций, аудит", $tags="target")
    System(iam, "Служба авторизации (IAM)", "Аутентификация сотрудников, RBAC,\nвыпуск и проверка токенов доступа")
    System(osago_core, "Подсистема оформления полисов", "Договоры ОСАГО, страховые премии\nи данные о продажах")
    System(crm, "CRM страховой компании", "Карточки агентов, история договоров\nи партнерские соглашения")
}

System_Ext(ais_osago, "АИС ОСАГО (РСА)", "Отраслевая система: проверка договоров,\nсведения о полисах", $tags="ext")
System_Ext(payment_sys, "Платежная система / Эквайринг", "Внешний банковский шлюз,\nпроведение оплат, выписки, сверка", $tags="ext")
System_Ext(email_sys, "E-mail система", "Рассылка финансовых отчетов\nи уведомлений бухгалтеру", $tags="ext")
System_Ext(sms_sys, "SMS-шлюз", "Доставка одноразовых\nкодов авторизации", $tags="ext")
System_Ext(soc, "Городской центр мониторинга ИБ (SOC)", "Инциденты ИБ корпоративной сети", $tags="ext")

Rel(accountant, mod_finance, "Запускает расчет маржи, КВ,\nконтролирует сверку оплат", "HTTPS")
Rel(auditor, mod_finance, "Просматривает финансовые логи\nи отчеты аудита", "HTTPS")
Rel(manager, mod_finance, "Изучает сводные показатели\nприбыльности портфеля", "HTTPS")

Rel(mod_finance, iam, "Проверка учётных данных, ролей (RBAC)\nи токенов сессии", "HTTPS, OAuth2 / OIDC")
Rel(mod_finance, osago_core, "Передача данных о проданных\nполисах для расчета маржи", "HTTPS, JSON")
Rel(mod_finance, crm, "Сведения об агентах\nи комиссионных ставках", "HTTPS, JSON")

Rel(mod_finance, ais_osago, "Сверка данных по договорам\nпри финансовом аудите", "HTTPS, JSON, mTLS")
Rel(mod_finance, payment_sys, "Запрос статусов платежей,\nавтоматическая сверка оплат", "HTTPS, JSON")
Rel(mod_finance, email_sys, "Отправка закрывающих отчетов\nи уведомлений бухгалтеру", "SMTP / STARTTLS", $tags="async")
Rel(email_sys, accountant, "Доставка отчетов на e-mail", "E-mail", $tags="async")
Rel(iam, sms_sys, "Отправка одноразового кода\nдля авторизации", "HTTPS, JSON")
Rel(mod_finance, soc, "События ИБ из журнала аудита", "syslog over TLS", $tags="async")

SHOW_LEGEND()
@enduml