@startuml
!include ../core/C4_Context.puml

title ИС ОСАГО, фин. контроль и маржа. SYSTEM LANDSCAPE (L0) — модуль бухгалтерии и финансового контроля (Усков М.В.)

Person(auditor, "Финансовый аудитор", "Анализирует финансовые потоки,\nпроверяет результаты сверки платежей", $tags="staff")
Person(manager, "Руководитель отдела", "Контролирует общую прибыльность\nпортфеля и агентские выплаты", $tags="staff")
Person(accountant, "Бухгалтер", "Ведёт финансовый учёт, контролирует\nмаржинальность, проверяет отчёты КВ", $tags="staff")

Enterprise_Boundary(enterprise, "Корпоративная ИТ-инфраструктура страховой компании") {
    System(osago_core, "Подсистема оформления полисов", "Договоры ОСАГО, страховые премии\nи данные о продажах")
    System(mod_finance, "ИС ОСАГО: фин. контроль и маржа", "Расчёт маржинальности периода, выплата КВ,\nавтоматическая сверка транзакций, аудит", $tags="target")
    System(iam, "Служба авторизации (IAM)", "Аутентификация сотрудников, RBAC,\nвыпуск и проверка токенов доступа")
}

System_Ext(payment_sys, "Банк / Платёжный эквайринг", "Внешняя финансовая система:\nпроведение оплат, выписки, сверка", $tags="ext")
System_Ext(ais_osago, "АИС ОСАГО (РСА)", "Отраслевая система: проверка договоров,\nсведения о полисах", $tags="ext")
System_Ext(email_sys, "E-mail система", "Рассылка финансовых отчётов\nи уведомлений бухгалтеру", $tags="ext")
System_Ext(sms_sys, "SMS-шлюз", "Доставка одноразовых\nкодов авторизации", $tags="ext")

Rel(osago_core, mod_finance, "Передача данных о проданных\nполисах для расчёта маржи", "HTTPS, JSON")
Rel(auditor, mod_finance, "Просматривает финансовые логи\nи отчёты аудита", "HTTPS")
Rel(manager, mod_finance, "Изучает сводные показатели\nприбыльности портфеля", "HTTPS")
Rel(accountant, mod_finance, "Запускает расчёт маржи, КВ,\nконтролирует сверку оплат", "HTTPS")

Rel(mod_finance, iam, "Проверка учётных данных, ролей (RBAC)\nи токенов сессии", "HTTPS, JSON, OAuth2")
Rel(iam, sms_sys, "Отправка одноразового кода\nдля авторизации", "HTTPS, JSON")
Rel(mod_finance, payment_sys, "Запрос статусов платежей,\nавтоматическая сверка оплат", "HTTPS, JSON", $tags="async")
Rel(mod_finance, ais_osago, "Сверка данных по договорам\nпри финансовом аудите", "HTTPS, JSON, mTLS")
Rel(mod_finance, email_sys, "Отправка закрывающих отчётов\nи уведомлений бухгалтеру", "SMTP / STARTTLS", $tags="async")
Rel(email_sys, accountant, "Доставка отчётов на e-mail", "E-mail", $tags="async")

SHOW_LEGEND()
@enduml