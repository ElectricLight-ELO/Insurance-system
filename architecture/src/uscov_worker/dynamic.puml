@startuml
title Динамическая диаграмма — Расчет маржи, комиссий и сверка зависших платежей

!include ../core/C4_Dynamic.puml

Container(web_app, "Web App", "React SPA", "Рабочее место бухгалтера\nи финансового менеджера,\nуправление отчетами")

System_Boundary(api, "API (FastAPI)") {
    Component(c_margin, "MarginController", "FastAPI Router", "Приём REST-запросов:\nрасчет маржи и КВ\nза период", $tags="api")
    Component(c_recon, "ReconciliationController", "FastAPI Router", "Приём REST-запросов:\nзапуск сверки платежей", $tags="api")
    Component(s_margin, "MarginService", "Python Service", "Бизнес-логика расчета маржи,\nагентских комиссий (КВ),\nсобытия аудита", $tags="service")
    Component(s_recon, "ReconciliationService", "Python Service", "Бизнес-логика сверки\nзависших транзакций\nс эквайрингом", $tags="service")
    Component(f_bank, "PaymentGatewayFacade", "HTTP Client", "Изоляция вызова:\nзапрос статусов транзакций\nв Платежной системе", $tags="integration")
    Component(task_queue_comp, "TaskQueueFacade", "SQL Client", "Постановка задач\nв очередь outbox", $tags="integration")
    Component(r_audit, "AuditRepository", "SQLAlchemy", "Доступ к аудиту,\nтранзакциям и очереди\nв PostgreSQL", $tags="data")
    Component(r_tariff, "TariffRepository", "SQLAlchemy", "Доступ к тарифным сеткам\nи коэффициентам\nв PostgreSQL", $tags="data")
}

ContainerDb(db_audit, "DB_AUDIT", "PostgreSQL", "Финансовые транзакции,\nсобытия аудита, очередь задач")
ContainerDb(db_tarifs, "DB_TARIFS", "PostgreSQL", "Тарифные сетки и\nставки комиссий (КВ)")

Container(worker, "Worker", "Python / Celery", "Фоновая обработка:\nфоновый расчет маржи,\nпериодическая сверка (Beat)")

System_Ext(payment_sys, "Платежная система / Эквайринг", "Внешний банковский шлюз,\nстатусы платежей", $tags="ext")
System_Ext(email_sys, "E-mail система", "Доставка финансовых\nотчетов бухгалтеру", $tags="ext")


' === СЦЕНАРИЙ: ХРОНОЛОГИЯ ВЫЗОВОВ (СКВОЗНОЙ ПРОЦЕСС БУХГАЛТЕРИИ) ===

Rel(web_app, c_margin, "1. Запрос расчета маржи за период — trigger_margin", "REST/HTTPS, JSON")
Rel(c_margin, s_margin, "2. Вызов calculate_period_margin() — инициация расчета", "Python Function Call")
Rel(s_margin, r_tariff, "3. Вызов get_tariffs() — получение тарифных ставок и КВ", "Python Function Call")
Rel(r_tariff, db_tarifs, "4. Чтение тарифных коэффициентов из БД", "SQL/TCP 5432")
Rel(s_margin, r_audit, "5. Вызов get_transactions() — чтение портфеля полисов", "Python Function Call")
Rel(r_audit, db_audit, "6. Чтение финансовых транзакций за период", "SQL/TCP 5432")

Rel(web_app, c_recon, "7. Ручной запуск сверки платежей — trigger_reconciliation", "REST/HTTPS, JSON")
Rel(c_recon, s_recon, "8. Вызов reconcile_payments() — обработка зависших оплат", "Python Function Call")
Rel(s_recon, r_audit, "9. Вызов get_pending_transactions() — поиск зависших оплат", "Python Function Call")
Rel(r_audit, db_audit, "10. Выборка платежей со статусом PENDING", "SQL/TCP 5432")

Rel(s_recon, f_bank, "11. Вызов check_transaction_status() — запрос в банк", "Python Function Call")
Rel(f_bank, payment_sys, "12. Запрос актуальных статусов транзакций", "HTTPS, JSON")

Rel(s_margin, task_queue_comp, "13. Вызов enqueue() — постановка фоновой задачи MARGIN_CALC", "Python Function Call")
Rel(task_queue_comp, r_audit, "14. Вызов save_task() — запись задачи в очередь outbox", "SQL/TCP 5432")

Rel(worker, db_audit, "15. Celery Beat/Worker: выборка задач и обновление статусов", "SQL/TCP 5432")
Rel(worker, email_sys, "16. Отправка итогового финансового отчета бухгалтеру", "SMTP / HTTPS")


SHOW_LEGEND()

@enduml