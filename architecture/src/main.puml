@startuml
!include core/C4_Container.puml

title Информационная система оформления ОСАГО (ИС ОСАГО). Container

Person(guest, "Гость", "Неавторизованный посетитель,\nрассчитывает стоимость полиса", $tags="outsider")
Person(client, "Клиент", "Участник ДТП (страхователь или потерпевший):\nподает заявку, загружает фото,\nставит подпись на протоколе осмотра", $tags="staff")
Person(payer, "Застрахованный клиент", "Застрахованное лицо,\nсовершающее оплату полиса", $tags="outsider")
Person(agent, "Страховой агент", "Оформляет полисы, работает с клиентами,\nпередает данные по комиссии (КВ)", $tags="staff")
Person(manager, "Менеджер отдела продаж", "Контроль работы агентов,\nотчеты по продажам, утверждение сложных случаев", $tags="staff")
Person(dispatcher, "Диспетчер", "Оператор колл-центра: принимает заявления о ДТП,\nназначает эксперта, отслеживает статус", $tags="staff")
Person(expert, "Аварийный эксперт", "Выезжает на место ДТП, загружает\nфото осмотра и сведения о ДТП", $tags="staff")
Person(support, "Оператор поддержки", "Отслеживает статусы полисов и платежей,\nперезапускает зависшие задачи", $tags="staff")
Person(auditor, "Сотрудник ИБ", "Изучает журнал аудита,\nрасследует инциденты", $tags="staff")
Person(accountant, "Бухгалтер", "Проверяет маржу и статусы оплат,\nформирует счета и акты, подписывает отчеты", $tags="staff")
Person(admin, "Администратор", "Права всех ролей: пользователи,\nроли, тарифы, аудит, задачи", $tags="staff")

System_Boundary(osago_service, "Информационная система оформления ОСАГО (ИС ОСАГО)") {

    Container(web_app, "Web App", "React SPA", "Расчет, оформление и оплата полиса, личный кабинет;\nрабочие места агента, менеджера, диспетчера и эксперта")

    Container(backoffice, "Backoffice", "React SPA", "Админ-панель: пользователи, роли, тарифы, аудит, задачи;\nпоиск полисов, статусы платежей; аналитика маржи, отчеты")

    Container(api, "API", "FastAPI", "REST/HTTPS JSON — расчет премии, оформление, оплата,\nRBAC, фиксация ДТП, администрирование,\nтарифы, финансовый контроль, выдача PDF")

    ContainerDb(db_users, "DB_USERS", "PostgreSQL", "Пользователи, роли, права (RBAC),\nклиенты, номера полисов")
    ContainerDb(db_tarifs, "DB_TARIFS", "PostgreSQL", "Тарифные сетки, коэффициенты, правила\nрасчета, результаты расчета маржи")
    ContainerDb(db_audit, "DB_AUDIT", "PostgreSQL", "Аудит, транзакции, платежи, акты ДТП,\nочередь асинхронных задач (outbox)")
    ContainerDb(db_files, "DB_FILES", "MongoDB", "Фото ДТП, подписи, документы\n(PDF полисов и протоколов)")

    Container(worker, "Worker", "Python / Celery", "Фоновая обработка: PDF, регистрация договора,\nписьма, сверка платежей, расчет маржи, отчеты")
}

System_Ext(sms_sys, "SMS-шлюз", "Отправка одноразовых кодов", $tags="ext")
System_Ext(ais_osago, "АИС ОСАГО (РСА)", "КБМ, проверка ТС, водителей и полиса,\nрегистрация договоров, актуальные тарифы", $tags="ext")
System_Ext(payment_sys, "Платежная система", "Платежные сессии, webhook об оплате,\nпоступления, комиссии, сверка платежей", $tags="ext")
System_Ext(email_sys, "E-mail система", "Рассылка и обмен письмами: полисы, чеки, протоколы,\nсчета, акты, отчеты, уведомления о сбоях", $tags="ext")

Rel(guest, web_app, "Рассчитывает стоимость без регистрации", "HTTPS")
Rel(client, web_app, "Вводит данные, подает заявку, загружает фото,\nскачивает полис, подписывает протокол", "HTTPS")
Rel(agent, web_app, "Оформляет полисы и договоры", "HTTPS")
Rel(manager, web_app, "Смотрит отчеты, управляет агентами,\nутверждает сложные случаи", "HTTPS")
Rel(dispatcher, web_app, "Регистрирует заявления о ДТП,\nназначает эксперта", "HTTPS")
Rel(expert, web_app, "Загружает фото осмотра\nи сведения о ДТП", "HTTPS")
Rel(support, backoffice, "Ищет полисы, смотрит статусы,\nперезапускает задачи", "HTTPS")
Rel(auditor, backoffice, "Изучает журнал аудита,\nрасследует инциденты", "HTTPS")
Rel(accountant, backoffice, "Проверяет маржу и оплаты,\nформирует счета и акты", "HTTPS")
Rel(admin, backoffice, "Управляет пользователями, ролями,\nтарифами, задачами", "HTTPS")

Rel(web_app, api, "Расчет, оформление, оплата,\nрезультаты осмотра, скачивание полиса", "REST/HTTPS, JSON")
Rel(backoffice, api, "Администрирование, тарифы, аудит,\nдашборд, управление задачами", "REST/HTTPS, JSON")
Rel(agent, api, "Передает данные о продажах\nи комиссии (КВ)", "REST/HTTPS")

Rel(api, db_users, "Аутентификация, пользователи,\nроли, клиенты, полисы", "SQL")
Rel(api, db_tarifs, "Чтение и изменение тарифов,\nзапись лога отчетов", "SQL")
Rel(api, db_audit, "Аудит, транзакции, акты ДТП,\nзадачи в outbox", "SQL")
Rel(api, db_files, "Фото, подписи, документы; просмотр и\nудаление; выдача PDF по ссылке", "MongoDB driver")

Rel(payer, payment_sys, "Оплачивает полис", "HTTPS")

Rel(worker, db_tarifs, "Читает данные для расчета,\nзаписывает результаты маржи", "SQL")
Rel(worker, db_audit, "Забирает задачи из outbox,\nобновляет статусы, сверяет оплаты", "SQL")
Rel(worker, db_files, "Читает фото и подписи, сохраняет PDF,\nудаляет устаревшие файлы", "MongoDB driver")

Rel(api, worker, "Ставит задачи: повтор, отчеты,\nрасчет маржи (outbox в DB_AUDIT)", "SQL/TCP 5432 (outbox)")

Rel(api, sms_sys, "Отправляет одноразовый код\nдля авторизации", "HTTPS, JSON")
Rel(api, ais_osago, "Запрашивает КБМ и тарифы, проверяет\nТС, водителей и наличие полиса", "HTTPS, JSON")
Rel(api, payment_sys, "Создает платежную сессию,\nполучает отчеты о поступлениях", "HTTPS, JSON")
Rel(payment_sys, api, "Уведомляет об оплате (webhook)", "HTTPS, JSON")
Rel(api, email_sys, "Отправляет вопросы\nи корректировки", "SMTP / HTTPS")

Rel(worker, ais_osago, "Регистрирует договор после оплаты (в т.ч. по команде\nадминистратора), повторная проверка полиса", "HTTPS, JSON", $tags="async")
Rel(worker, payment_sys, "Сверяет зависшие платежи\n(по расписанию)", "HTTPS, JSON", $tags="async")
Rel(worker, email_sys, "Отправляет полисы, чеки, протоколы,\nсчета, отчеты, уведомления о сбоях", "SMTP / HTTPS", $tags="async")

Rel(email_sys, client, "Доставляет полисы, чеки,\nпротоколы осмотра", "E-mail", $tags="async")
Rel(email_sys, accountant, "Доставляет счета, акты,\nфинансовые отчеты", "E-mail", $tags="async")
Rel(email_sys, admin, "Доставляет уведомления о сбоях\nи отчеты о работе системы", "E-mail", $tags="async")

@enduml
