' Обновлённые диаграммы системного ландшафта (L0) без экосистемы Smart City
' Каждый блок @startuml ... @enduml — отдельная диаграмма

' ===== Мехова А.С. — рисунок 1 (landscape.puml) =====
@startuml landscape_Мехова
!include <C4/C4_Context>
skinparam defaultFontName Arial

title ИС ОСАГО, Backoffice. SYSTEM LANDSCAPE (L0) — модуль администрирования и аудита

AddElementTag("target", $bgColor="#2E86C1", $borderColor="#1F6391", $fontColor="#FFFFFF", $legendText="Целевой модуль")
AddElementTag("ext", $bgColor="#A9A9A9", $borderColor="#8A8A8A", $fontColor="#FFFFFF", $legendText="Внешняя система")
AddRelTag("async", $lineStyle=DashedLine(), $legendText="Асинхронное взаимодействие")

Person(admin, "Администратор", "Пользователи, роли, тарифы,\nрегистрация договора по команде")
Person(support, "Оператор поддержки", "Поиск полисов и платежей,\nперезапуск сбойных задач")
Person(security, "Сотрудник ИБ", "Журнал аудита,\nрасследования инцидентов")
Person(accountant, "Бухгалтер", "Маржа, оплаты,\nсчета и акты")

Enterprise_Boundary(ent, "Корпоративная ИТ-инфраструктура страховой компании") {
    System(backoffice, "ИС ОСАГО: Backoffice\n(администрирование и аудит)", "Админ-панель: пользователи и роли, тарифы, задачи, поиск полисов, журнал аудита, финансовые отчёты", $tags="target")
    System(iam, "Служба авторизации (IAM)", "Аутентификация сотрудников,\nRBAC, выпуск и проверка токенов")
    System(policy, "Подсистема оформления\nполисов и урегулирования", "API и Worker: полисы, платежи,\nДТП, очередь задач (outbox), аудит")
    System(crm, "CRM страховой компании", "Карточки клиентов, история обращений")
}

System_Ext(ais, "АИС ОСАГО (РСА)", "Регистрация договоров, проверка полиса", $tags="ext")
System_Ext(email, "E-mail система", "Отчёты, счета и акты, уведомления о сбоях", $tags="ext")

Rel(admin, backoffice, "Управляет пользователями, ролями, тарифами", "HTTPS")
Rel(support, backoffice, "Ищет полисы и платежи, перезапускает задачи", "HTTPS")
Rel(security, backoffice, "Просматривает и выгружает журнал аудита", "HTTPS")

Rel(backoffice, iam, "Вход по коду, проверка ролей (RBAC), токены", "HTTPS, JSON, OAuth2")
Rel(backoffice, policy, "Административные операции, журнал аудита, статусы задач и платежей", "REST/HTTPS, JSON")
Rel(backoffice, crm, "Карточка клиента при обращении в поддержку", "HTTPS, JSON")

Rel(policy, ais, "Регистрирует договор, в т.ч. по команде администратора", "HTTPS, JSON, mTLS")
Rel(policy, email, "Отчёты, счета и акты, уведомления о сбоях", "SMTP / STARTTLS", $tags="async")
Rel(email, accountant, "Доставляет отчёты, счета и акты", "E-mail", $tags="async")
Rel(accountant, backoffice, "Смотрит маржу и оплаты, запрашивает счета", "HTTPS")

SHOW_LEGEND()
@enduml

' ===== Романов Н.И. — рисунок 1 (landscape.puml) =====
@startuml landscape_Романов
!include <C4/C4_Context>
skinparam defaultFontName Arial

title ИС ОСАГО, продажа полисов. SYSTEM LANDSCAPE (L0) — модуль Web App (клиент, агент, менеджер)

AddElementTag("target", $bgColor="#2E86C1", $borderColor="#1F6391", $fontColor="#FFFFFF", $legendText="Целевой модуль")
AddElementTag("ext", $bgColor="#A9A9A9", $borderColor="#8A8A8A", $fontColor="#FFFFFF", $legendText="Внешняя система")
AddRelTag("async", $lineStyle=DashedLine(), $legendText="Асинхронное взаимодействие")

Person(guest, "Гость", "Считает стоимость полиса\nбез регистрации")
Person(agent, "Страховой агент", "Оформляет полисы клиентам,\nпередаёт данные о продажах")
Person(manager, "Менеджер отдела продаж", "Отчёты по продажам,\nагенты, сложные случаи")
Person(insured, "Застрахованный клиент", "Оплачивает полис")
Person(client, "Клиент", "Оформляет полис,\nличный кабинет")

Enterprise_Boundary(ent, "Корпоративная ИТ-инфраструктура страховой компании") {
    System(webapp, "ИС ОСАГО: продажа и оформление полисов (Web App)", "Расчёт премии, оформление и оплата полиса, личный кабинет, рабочие места агента и менеджера", $tags="target")
    System(iam, "Служба авторизации (IAM)", "Вход по одноразовому коду, RBAC,\nтокены")
    System(policy, "Подсистема расчёта и учёта полисов", "API и Worker: тарифы, полисы,\nплатежи, регистрация договоров, PDF")
    System(crm, "CRM страховой компании", "Клиенты и лиды агентов, история продаж")
}

System_Ext(sms, "SMS-шлюз", "Одноразовые коды входа", $tags="ext")
System_Ext(ais, "АИС ОСАГО (РСА)", "КБМ, проверка ТС и водителей,\nрегистрация договоров", $tags="ext")
System_Ext(email, "E-mail система", "Электронный полис и чек", $tags="ext")
System_Ext(payment, "Платёжная система", "Платёжные сессии, уведомления об оплате", $tags="ext")

Rel(guest, webapp, "Считает стоимость полиса", "HTTPS")
Rel(agent, webapp, "Оформляет полисы, передаёт продажи и КВ", "HTTPS")
Rel(manager, webapp, "Смотрит отчёты по продажам", "HTTPS")
Rel(client, webapp, "Оформляет полис, скачивает его", "HTTPS")

Rel(webapp, iam, "Вход по коду, роль, токен", "HTTPS, JSON, OAuth2")
Rel(webapp, policy, "Расчёт, оформление, оплата, PDF полиса, продажи агента", "REST/HTTPS, JSON")
Rel(webapp, crm, "Данные о продажах агента и клиенте", "HTTPS, JSON", $tags="async")

Rel(iam, sms, "Отправляет одноразовый код", "HTTPS, JSON")
Rel(policy, ais, "КБМ, проверки ТС и водителей, регистрация договора", "HTTPS, JSON, mTLS")
Rel(policy, email, "Отправляет полис и чек", "SMTP / STARTTLS", $tags="async")
Rel(policy, payment, "Создаёт платёжную сессию", "HTTPS, JSON")
Rel(payment, policy, "Уведомляет об оплате (webhook)", "HTTPS, JSON", $tags="async")
Rel(insured, payment, "Оплачивает полис", "HTTPS")
Rel(email, client, "Доставляет электронный полис", "E-mail", $tags="async")

SHOW_LEGEND()
@enduml

' ===== Таган (тимлид) — рисунок 1 (landscape_global.puml) =====
@startuml landscape_global
!include <C4/C4_Context>
skinparam defaultFontName Arial

title ИС ОСАГО. SYSTEM LANDSCAPE (L0) — глобальный ландшафт: интеграция с корпоративной ИТ-инфраструктурой (тимлид)

AddElementTag("target", $bgColor="#2E86C1", $borderColor="#1F6391", $fontColor="#FFFFFF", $legendText="Целевой модуль")
AddElementTag("ext", $bgColor="#A9A9A9", $borderColor="#8A8A8A", $fontColor="#FFFFFF", $legendText="Внешняя система")
AddRelTag("async", $lineStyle=DashedLine(), $legendText="Асинхронное взаимодействие")

Person(citizens, "Граждане и клиенты", "Гость, клиент, застрахованный\nклиент (3 роли L1)")
Person(front, "Сотрудники фронт-офиса", "Страховой агент, менеджер продаж,\nдиспетчер, аварийный эксперт (4 роли L1)")
Person(back, "Сотрудники бэк-офиса", "Оператор поддержки, сотрудник ИБ,\nбухгалтер, администратор (4 роли L1)")

Enterprise_Boundary(ent, "Корпоративная ИТ-инфраструктура страховой компании") {
    System(osago, "ИС ОСАГО", "Продажа и оформление полисов, оплата, регистрация договоров, фиксация ДТП и осмотр, финансовый контроль, администрирование и аудит", $tags="target")
    System(email, "E-mail система", "Корпоративная почта и рассылки")
    System(iam, "Служба авторизации (IAM)", "Единые учётные записи сотрудников,\nSSO, роли, выпуск и проверка токенов")
    System(crm, "CRM страховой компании", "Карточки клиентов, лиды и продажи\nагентов, история обращений")
    System(sms, "SMS-шлюз", "Одноразовые коды")
}

System_Ext(payment, "Платёжная система", "Платёжные сессии, webhook, сверка", $tags="ext")
System_Ext(ais, "АИС ОСАГО (РСА)", "КБМ, проверки ТС, водителей и\nполиса, регистрация договоров", $tags="ext")

Rel(citizens, osago, "Расчёт и оформление полиса, личный кабинет, заявление о ДТП, подпись протокола", "HTTPS")
Rel(front, osago, "Продажи и КВ, отчёты, заявления о ДТП, осмотр и фото", "HTTPS")
Rel(back, osago, "Администрирование, задачи, журнал аудита, финансы", "HTTPS через VPN")

Rel(osago, email, "Полисы, чеки, протоколы, счета, отчёты", "SMTP / STARTTLS", $tags="async")
Rel(osago, iam, "Вход сотрудников (SSO), роли, проверка токенов", "HTTPS, OAuth2 / OIDC")
Rel(osago, crm, "Клиенты, продажи агентов, обращения в поддержку", "HTTPS, JSON", $tags="async")
Rel(osago, sms, "Одноразовые коды", "HTTPS, JSON")

Rel(osago, payment, "Платёжная сессия, сверка", "HTTPS, JSON")
Rel(payment, osago, "Уведомление об оплате (webhook)", "HTTPS, JSON", $tags="async")
Rel(citizens, payment, "Оплачивает полис", "HTTPS")
Rel(email, citizens, "Доставляет документы", "E-mail", $tags="async")
Rel(osago, ais, "КБМ, проверки, регистрация договора", "HTTPS, JSON, mTLS")

SHOW_LEGEND()
@enduml
