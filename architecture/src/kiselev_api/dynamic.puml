@startuml
!include ../core/C4_Component.puml

title Динамическая диаграмма — Регистрация заявления о ДТП и формирование протокола осмотра

Container(web_app, "Web App", "React SPA", "Рабочее место диспетчера\nи аварийного эксперта,\nэлектронная подпись клиента")

System_Boundary(api, "API (FastAPI)") {
    Component(accident_comp, "AccidentController", "FastAPI Router", "Приём REST-запросов:\nзаявления о ДТП,\nназначение эксперта", $tags="layer_api")
    Component(inspection_comp, "InspectionController", "FastAPI Router", "Приём REST-запросов:\nрезультаты осмотра, фото,\nэлектронная подпись", $tags="layer_api")
    Component(s_acc, "AccidentService", "Python Service", "Бизнес-логика заявления,\nназначение эксперта,\nсобытия аудита", $tags="layer_service")
    Component(s_insp, "InspectionService", "Python Service", "Бизнес-логика осмотра,\nприём фото и подписи,\nпостановка задач", $tags="layer_service")
    Component(f_ais, "AisOsagoFacade", "HTTP Client", "Изоляция вызова:\nпроверка полиса\nчерез АИС ОСАГО", $tags="layer_integration")
    Component(task_queue_comp, "TaskQueueFacade", "SQL Client", "Постановка задач\nв очередь outbox", $tags="layer_integration")
    Component(r_acc, "AccidentRepository", "SQLAlchemy", "Доступ к заявлениям,\nаудиту и очереди\nв PostgreSQL", $tags="layer_data")
    Component(r_file, "FileRepository", "PyMongo", "Доступ к фото, подписям\nи PDF-документам\nв MongoDB", $tags="layer_data")
}

ContainerDb(db_audit, "DB_AUDIT", "PostgreSQL", "Заявления, события аудита,\nочередь задач (outbox)")
ContainerDb(db_files, "DB_FILES", "MongoDB", "Фото осмотра, подписи,\nPDF-протоколы")

Container(worker, "Worker", "Python / Celery", "Фоновая обработка:\nгенерация PDF-протокола,\nотправка клиенту")

System_Ext(ais_osago, "АИС ОСАГО (РСА)", "Проверка полиса ОСАГО,\nсведения о договоре", $tags="ext")
System_Ext(email_sys, "E-mail система", "Доставка документов\nи уведомлений", $tags="ext")

' === СЦЕНАРИЙ: ХРОНОЛОГИЯ ВЫЗОВОВ (СКОЗНОЙ ПРОЦЕСС) ===

Rel(web_app, accident_comp, "1. Регистрация заявления о ДТП — register_claim", "REST/HTTPS, JSON")
Rel(accident_comp, s_acc, "2. Вызов register_claim() — создание заявления", "Python (in-process)")
Rel(s_acc, f_ais, "3. Вызов check_policy() — проверка полиса", "Python (in-process)")
Rel(f_ais, ais_osago, "4. Запрос сведений о полисе ОСАГО", "HTTPS, JSON, mTLS")
Rel(s_acc, r_acc, "5. assign_expert() — выбор эксперта (AssignmentStrategy) и сохранение", "Python (in-process)")
Rel(r_acc, db_audit, "6. Запись заявления, статуса ASSIGNED и события аудита", "SQL/TCP 5432")

Rel(web_app, inspection_comp, "7. Приём результатов осмотра — submit_results", "REST/HTTPS, JSON")
Rel(inspection_comp, s_insp, "8. Вызов submit_results() — обработка результатов осмотра", "Python (in-process)")
Rel(s_insp, r_file, "9. Вызов upload_photos() и accept_signature() — фото и подпись клиента", "Python (in-process)")
Rel(r_file, db_files, "10. Сохранение фотографий осмотра и подписи (GridFS)", "MongoDB Wire/TCP 27017")

Rel(s_insp, task_queue_comp, "11. Вызов enqueue() — постановка задачи PDF_PROTOCOL", "Python (in-process)")
Rel(task_queue_comp, r_acc, "12. Вызов save_task() — запись задачи в очередь outbox", "Python (in-process)")

Rel(worker, db_audit, "13. Выборка задач из очереди и обновление статусов", "SQL/TCP 5432")
Rel(worker, db_files, "14. Чтение фотографий, генерация и сохранение PDF-протокола", "MongoDB Wire/TCP 27017")
Rel(worker, email_sys, "15. Отправка протокола осмотра клиенту", "SMTP / STARTTLS", $tags="async")

SHOW_LEGEND()
@enduml
