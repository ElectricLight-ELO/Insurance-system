@startuml
!include ../core/C4_Context.puml

title ИС ОСАГО, фиксация ДТП. SYSTEM LANDSCAPE (L0) — модуль аварийного эксперта

Person(dispatcher, "Диспетчер", "Оператор колл-центра: принимает\nзаявления о ДТП, назначает эксперта", $tags="staff")
Person(expert, "Аварийный эксперт", "Выезжает на место ДТП,\nпроводит осмотр, загружает фото", $tags="staff")
Person(client, "Клиент", "Участник ДТП: подписывает\nэлектронный протокол осмотра", $tags="staff")

Enterprise_Boundary(enterprise, "Корпоративная ИТ-инфраструктура страховой компании") {
    System(mod_accident, "ИС ОСАГО: фиксация ДТП и осмотр", "Регистрация заявлений, назначение эксперта,\nприём фото и подписи, выдача PDF-протокола", $tags="target")
    System(iam, "Служба авторизации (IAM)", "Аутентификация сотрудников, RBAC,\nвыпуск и проверка токенов доступа")
    System(osago_core, "Остальная часть ИС ОСАГО", "Оформление полисов, платежи,\nфинансовый контроль, администрирование")
}

System_Ext(ais_osago, "АИС ОСАГО (РСА)", "Отраслевая система: проверка полиса,\nКБМ, регистрация договоров", $tags="ext")
System_Ext(payment_sys, "Платёжная система", "Внешний финансовый контур:\nплатёжные сессии, сверки", $tags="ext")
System_Ext(sms_sys, "SMS-шлюз", "Отправка одноразовых\nкодов авторизации", $tags="ext")
System_Ext(email_sys, "E-mail система", "Рассылка протоколов, полисов,\nчеков и уведомлений", $tags="ext")

Rel(dispatcher, mod_accident, "Регистрирует заявление о ДТП,\nназначает эксперта", "HTTPS")
Rel(expert, mod_accident, "Загружает фото и результаты\nосмотра", "HTTPS")
Rel(client, mod_accident, "Подписывает протокол\nосмотра", "HTTPS")
Rel(mod_accident, iam, "Проверка учётных данных, ролей (RBAC)\nи токенов сессии", "HTTPS, OAuth2 / OIDC")
Rel(osago_core, mod_accident, "Сведения о договоре ОСАГО\nпо номеру полиса", "HTTPS, JSON")
Rel(iam, sms_sys, "Отправка одноразового кода\nдля авторизации", "HTTPS, JSON")
Rel(osago_core, payment_sys, "Создание платёжной сессии,\nсверка поступлений", "HTTPS, JSON")
Rel(mod_accident, ais_osago, "Проверка наличия полиса ОСАГО\nпри регистрации заявления", "HTTPS, JSON, mTLS")
Rel(mod_accident, email_sys, "Отправка протокола осмотра\nи уведомлений", "SMTP / STARTTLS", $tags="async")
Rel(email_sys, client, "Доставка протокола осмотра", "E-mail", $tags="async")

SHOW_LEGEND()
@enduml
