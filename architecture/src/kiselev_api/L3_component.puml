@startuml
!include ../core/C4_Component.puml

title C4 COMPONENT — API (FASTAPI): ИС ОСАГО, фиксация ДТП

Container(web_app, "Web App", "React SPA", "Рабочее место диспетчера и эксперта,\nэлектронная подпись клиента")
Container(backoffice, "Backoffice", "React SPA", "Рабочее место администратора\nи поддержки")

Container_Boundary(api, "API — FASTAPI") {

    ' --- Слой API / представления ---
    together {
        Component(auth_comp, "AuthController", "FastAPI Router", "Вход по одноразовому коду:\nзапрос кода, проверка кода,\nвыдача токена доступа", $tags="layer_api")
        Component(policy_comp, "PolicyController", "FastAPI Router", "Расчёт премии и оформление полиса,\nпроверка ТС и водителей", $tags="layer_api")
        Component(payment_comp, "PaymentController", "FastAPI Router", "Создание платёжной сессии\nи приём webhook об оплате", $tags="layer_api")
        Component(accident_comp, "AccidentController", "FastAPI Router", "Принимает REST-запросы:\nрегистрация заявления о ДТП,\nназначение эксперта, статусы", $tags="layer_api")
        Component(inspection_comp, "InspectionController", "FastAPI Router", "Принимает REST-запросы:\nрезультаты осмотра, фото,\nэлектронная подпись клиента", $tags="layer_api")
        Component(admin_comp, "AdminController", "FastAPI Router", "Администрирование пользователей,\nжурнала аудита и задач", $tags="layer_api")
    }

    ' --- Слой бизнес-логики ---
    together {
        Component(access_comp, "AccessService", "Python Service", "Проверка прав доступа (RBAC)\nпо подменяемой политике (Strategy)", $tags="layer_service")
        Component(audit_comp, "AuditService", "Python Service", "Запись событий аудита\nпо каждому действию\nс системой", $tags="layer_service")
        Component(s_acc, "AccidentService", "Python Service", "Бизнес-правила заявления:\nсоздание, назначение эксперта,\nсмена статусов", $tags="layer_service")
        Component(s_insp, "InspectionService", "Python Service", "Формирование акта фиксации ДТП,\nпроверка подписи, постановка\nзадачи на генерацию PDF", $tags="layer_service")
    }

    ' --- Слой интеграции ---
    together {
        Component(task_queue_comp, "TaskQueueFacade", "SQL Client", "Постановка асинхронных задач\nв очередь для Worker\n(генерация PDF-протокола)", $tags="layer_integration")
        Component(f_ais, "AisOsagoFacade", "HTTP Client", "Изоляция внешнего вызова:\nпроверка наличия полиса ОСАГО\nчерез АИС ОСАГО", $tags="layer_integration")
    }

    ' --- Слой доступа к данным ---
    together {
        Component(r_acc, "AccidentRepository", "SQLAlchemy", "Доступ к заявлениям, актам,\nсобытиям аудита и очереди\nв PostgreSQL", $tags="layer_data")
        Component(r_file, "FileRepository", "PyMongo", "Доступ к фото ДТП, подписям\nи PDF-документам\nв MongoDB", $tags="layer_data")
    }
}

' === ВНЕШНИЕ СИСТЕМЫ И БД (СНИЗУ) ===
together {
    ContainerDb(db_audit, "DB_AUDIT", "PostgreSQL", "Заявления о ДТП, акты фиксации,\nаудит, очередь задач")
    ContainerDb(db_files, "DB_FILES", "MongoDB", "Фото ДТП, подписи,\nPDF-документы")
}
together {
    System_Ext(ais_osago, "АИС ОСАГО", "Автоматизированная информационная система", $tags="ext")
    System_Ext(payment_sys, "Платёжная система", "Платёжные сессии, webhook об оплате", $tags="ext")
}

' === СВЯЗИ (RELATIONSHIPS) ===

' Web App / Backoffice -> Контроллеры
Rel(web_app, auth_comp, "Вход по одноразовому коду", "REST/HTTPS, JSON")
Rel(web_app, policy_comp, "Расчёт и оформление полиса", "REST/HTTPS, JSON")
Rel(web_app, payment_comp, "Оплата полиса", "REST/HTTPS, JSON")
Rel(web_app, accident_comp, "Регистрация заявления", "REST/HTTPS, JSON")
Rel(web_app, inspection_comp, "Результаты осмотра", "REST/HTTPS, multipart")
Rel(backoffice, admin_comp, "Администрирование", "REST/HTTPS, JSON")

' Контроллеры -> Сервисы
Rel(accident_comp, s_acc, "Вызов логики", "Python (in-process)")
Rel(inspection_comp, s_insp, "Вызов логики", "Python (in-process)")

' Контроллеры -> Проверка прав (RBAC, FastAPI Depends)
Rel(auth_comp, access_comp, "Проверка кода и выпуск токена", "Python (in-process)")
Rel(accident_comp, access_comp, "Проверка ролей диспетчера", "Python (in-process)", $tags="rbac")
Rel(inspection_comp, access_comp, "Проверка ролей эксперта", "Python (in-process)", $tags="rbac")
Rel(policy_comp, access_comp, "Проверка прав перед расчётом", "Python (in-process)", $tags="rbac")
Rel(payment_comp, access_comp, "Проверка прав перед оплатой", "Python (in-process)", $tags="rbac")
Rel(admin_comp, access_comp, "Проверка ролей администратора", "Python (in-process)", $tags="rbac")

' Сервисы -> Аудит
Rel(s_acc, audit_comp, "События аудита", "Python (in-process)", $tags="audit")
Rel(s_insp, audit_comp, "События аудита", "Python (in-process)", $tags="audit")
Rel(admin_comp, audit_comp, "Просмотр журнала аудита", "Python (in-process)", $tags="audit")

' Сервисы -> Фасады
Rel(s_insp, task_queue_comp, "Задача на PDF", "Python (in-process)")
Rel(s_insp, f_ais, "Проверка полиса", "Python (in-process)")

' Сервисы -> Репозитории
Rel(s_acc, r_acc, "Чтение/запись", "Python (in-process)")
Rel(s_insp, r_file, "Сохранение фото", "Python (in-process)")
Rel(audit_comp, r_acc, "Запись аудита", "Python (in-process)")

' Фасад -> Репозиторий
Rel(task_queue_comp, r_acc, "Очередь задач", "SQL/TCP 5432")

' Репозитории -> БД
Rel(r_acc, db_audit, "Данные", "SQL/TCP 5432")
Rel(r_file, db_files, "Файлы", "MongoDB Wire/TCP 27017")

' Фасад -> Внешние системы
Rel(f_ais, ais_osago, "Проверка ОСАГО", "HTTPS, JSON, mTLS")
Rel(payment_comp, payment_sys, "Создание платёжной сессии", "HTTPS, JSON")
Rel(payment_sys, payment_comp, "Уведомление об оплате (webhook)", "HTTPS, JSON")

SHOW_LEGEND()
@enduml
