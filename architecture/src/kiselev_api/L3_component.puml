@startuml
!include ../core/C4_Component.puml

title C4 COMPONENT — API (FastAPI): ИС ОСАГО (Киселев Д.А.)

Container(web_app, "Web App", "React SPA", "Рабочие места диспетчера,\nэксперта и клиента")
Container(backoffice, "Backoffice", "React SPA", "Рабочее место администратора\nи поддержки")
Container(worker, "Worker", "Python / Celery", "Фоновая обработка задач\nиз очереди outbox")

Container_Boundary(api, "API — FastAPI") {

    Component(auth_comp, "AuthController", "FastAPI Router", "Вход по одноразовому коду:\nзапрос кода, проверка кода,\nвыдача токена доступа", $tags="layer_api")
    Component(access_comp, "AccessService", "Python Service", "Проверка прав доступа (RBAC)\nпо подменяемой политике (Strategy)", $tags="layer_service")
    Component(policy_comp, "PolicyController", "FastAPI Router", "Расчёт премии и оформление полиса,\nпроверка ТС и водителей", $tags="layer_api")
    Component(payment_comp, "PaymentController", "FastAPI Router", "Создание платёжной сессии\nи приём webhook об оплате", $tags="layer_api")
    Component(accident_comp, "AccidentController", "FastAPI Router", "Регистрация заявления о ДТП,\nназначение эксперта, статусы", $tags="layer_api")
    Component(inspection_comp, "InspectionController", "FastAPI Router", "Приём результатов осмотра,\nфотографий и электронной подписи", $tags="layer_api")
    Component(admin_comp, "AdminController", "FastAPI Router", "Администрирование пользователей,\nтарифов, журнала аудита и задач", $tags="layer_api")

    Component(claim_service, "AccidentService", "Python Service", "Бизнес-правила заявления:\nсоздание, назначение эксперта,\nсмена статусов", $tags="layer_service")
    Component(inspection_service, "InspectionService", "Python Service", "Формирование акта фиксации ДТП,\nпроверка подписи, постановка\nзадачи на генерацию PDF", $tags="layer_service")
    Component(audit_comp, "AuditService", "Python Service", "Запись событий аудита\nпо каждому действию,\nпоиск по журналу", $tags="layer_service")
    Component(task_queue_comp, "TaskQueueFacade", "SQL Client", "Постановка асинхронных задач\nв очередь outbox для Worker", $tags="layer_integration")
    Component(ais_gateway, "AisOsagoFacade", "HTTP Client", "Изоляция внешнего вызова:\nпроверка наличия полиса ОСАГО\nчерез АИС ОСАГО", $tags="layer_integration")

    Component(users_repo, "UserRepository", "SQLAlchemy", "Доступ к пользователям, ролям,\nправам и одноразовым кодам\nв PostgreSQL", $tags="layer_data")
    Component(claims_repo, "AccidentRepository", "SQLAlchemy", "Доступ к заявлениям, актам,\naудиту и очереди в PostgreSQL", $tags="layer_data")
    Component(files_repo, "FileRepository", "PyMongo", "Доступ к фото ДТП, подписям\nи PDF-документам в MongoDB", $tags="layer_data")
}

ContainerDb(db_users, "DB_USERS", "PostgreSQL", "Пользователи, роли,\nправа доступа (RBAC)")
ContainerDb(db_audit, "DB_AUDIT", "PostgreSQL", "Заявления, аудит,\nочередь задач (outbox)")
ContainerDb(db_files, "DB_FILES", "MongoDB", "Фото осмотра, подписи,\nPDF-протоколы")

System_Ext(ais_osago, "АИС ОСАГО (РСА)", "Проверка полиса ОСАГО,\nсведения о договоре", $tags="ext")
System_Ext(payment_sys, "Платёжная система", "Платёжные сессии,\nwebhook об оплате", $tags="ext")

Rel(web_app, auth_comp, "Вход по одноразовому коду", "REST/HTTPS, JSON")
Rel(web_app, policy_comp, "Расчёт и оформление полиса", "REST/HTTPS, JSON")
Rel(web_app, payment_comp, "Оплата полиса", "REST/HTTPS, JSON")
Rel(web_app, accident_comp, "Регистрация заявления о ДТП,\nназначение эксперта, статусы", "REST/HTTPS, JSON")
Rel(web_app, inspection_comp, "Результаты осмотра,\nфото, подпись клиента", "REST/HTTPS, multipart")
Rel(backoffice, admin_comp, "Администрирование, тарифы,\nаудит, управление задачами", "REST/HTTPS, JSON")

Rel(auth_comp, access_comp, "Проверка кода и выпуск токена", "Python (in-process)")
Rel(policy_comp, access_comp, "Проверка прав перед расчётом", "Python (in-process)", $tags="rbac")
Rel(payment_comp, access_comp, "Проверка прав перед оплатой", "Python (in-process)", $tags="rbac")
Rel(accident_comp, access_comp, "Проверка ролей диспетчера", "Python (in-process)", $tags="rbac")
Rel(inspection_comp, access_comp, "Проверка ролей эксперта и клиента", "Python (in-process)", $tags="rbac")
Rel(admin_comp, access_comp, "Проверка ролей администратора", "Python (in-process)", $tags="rbac")

Rel(accident_comp, claim_service, "Вызов бизнес-логики заявления", "Python (in-process)")
Rel(inspection_comp, inspection_service, "Вызов бизнес-логики осмотра", "Python (in-process)")
Rel(admin_comp, audit_comp, "Поиск и просмотр журнала аудита", "Python (in-process)", $tags="audit")

Rel(claim_service, ais_gateway, "Проверка наличия полиса ОСАГО", "Python (in-process)")
Rel(claim_service, claims_repo, "Чтение и запись заявлений,\nназначение эксперта", "Python (in-process)")
Rel(claim_service, audit_comp, "События аудита заявления", "Python (in-process)", $tags="audit")
Rel(inspection_service, files_repo, "Сохранение фото и подписи", "Python (in-process)")
Rel(inspection_service, task_queue_comp, "Постановка задачи PDF_PROTOCOL\nв очередь outbox", "Python (in-process)")
Rel(inspection_service, audit_comp, "События аудита осмотра", "Python (in-process)", $tags="audit")

Rel(auth_comp, users_repo, "Учётные записи и одноразовые коды", "Python (in-process)")
Rel(access_comp, users_repo, "Роли и права (RBAC)", "Python (in-process)")
Rel(policy_comp, users_repo, "Чтение клиентов и полисов", "Python (in-process)")
Rel(payment_comp, payment_sys, "Создание платёжной сессии", "HTTPS, JSON")
Rel(payment_sys, payment_comp, "Уведомление об оплате (webhook)", "HTTPS, JSON")
Rel(task_queue_comp, claims_repo, "Запись задачи в очередь outbox", "Python (in-process)")

Rel(claims_repo, db_audit, "Заявления, акты, аудит,\nочередь задач", "SQL/TCP 5432")
Rel(users_repo, db_users, "Пользователи, роли, права", "SQL/TCP 5432")
Rel(files_repo, db_files, "Фото, подписи, PDF-документы", "MongoDB/TCP 27017")
Rel(ais_gateway, ais_osago, "Проверка полиса ОСАГО", "HTTPS, JSON, mTLS")
Rel(worker, task_queue_comp, "Выборка задач из очереди\nи обновление статусов", "SQL/TCP 5432")

SHOW_LEGEND()
@enduml
