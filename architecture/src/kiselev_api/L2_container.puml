@startuml
!include ../core/C4_Container.puml

title ИС ОСАГО, фиксация ДТП. Container (L2) — модуль аварийного эксперта (Киселев Д.А.)

Person(dispatcher, "Диспетчер", "Оператор колл-центра: принимает\nзаявления о ДТП, назначает эксперта", $tags="staff")
Person(expert, "Аварийный эксперт", "Сотрудник, выезжающий\nна место ДТП", $tags="staff")
Person(client, "Участник ДТП", "Подписывает электронный\nпротокол осмотра", $tags="staff")

System_Boundary(osago_service, "Информационная система оформления ОСАГО (ИС ОСАГО)") {

    Container(web_app, "Web App", "React SPA", "Рабочее место диспетчера и эксперта:\nзагрузка фото осмотра, сведения о ДТП,\nэлектронная подпись клиента")

    Container(api, "API", "FastAPI", "REST/HTTPS JSON — регистрация заявлений,\nназначение эксперта, осмотр, проверка полиса ОСАГО,\nвыдача PDF-протокола")

    Container(worker, "Worker", "Python / Celery", "Асинхронная обработка:\nгенерация PDF-протокола, рассылка")

    ContainerDb(db_users, "DB_USERS", "PostgreSQL", "Пользователи, роли, права доступа (RBAC)")

    ContainerDb(db_audit, "DB_AUDIT", "PostgreSQL", "Заявления о ДТП, акты фиксации, статусы осмотра,\nжурнал аудита и очередь асинхронных задач (outbox)")

    ContainerDb(db_files, "DB_FILES", "MongoDB", "Фото ДТП, подписи\nи файлы документов")
}

System_Ext(ais_osago, "АИС ОСАГО (РСА)", "Проверка наличия полиса ОСАГО,\nсведения о договоре", $tags="ext")
System_Ext(email_sys, "E-mail система", "Доставка протоколов осмотра\nи уведомлений", $tags="ext")

Rel(dispatcher, web_app, "Регистрирует заявление о ДТП,\nназначает эксперта, отслеживает статус", "HTTPS")
Rel(expert, web_app, "Загружает фотографии осмотра\nи сведения о ДТП", "HTTPS")
Rel(client, web_app, "Ставит электронную подпись\nна протоколе осмотра", "HTTPS")

Rel(web_app, api, "Отправка заявлений, результатов осмотра,\nфото и подписи", "REST/HTTPS, JSON")

Rel(api, db_users, "Аутентификация, роли диспетчера,\nэксперта и клиента", "SQL/TCP 5432")
Rel(api, db_audit, "Чтение и запись актов фиксации,\nстатусов осмотра, событий аудита, задач в outbox", "SQL/TCP 5432")
Rel(api, db_files, "Сохранение фото\nи подписей", "MongoDB/TCP 27017")

Rel(api, ais_osago, "Проверка наличия полиса ОСАГО\nпри регистрации заявления", "HTTPS, JSON, mTLS")

Rel(worker, db_audit, "Выборка задач из очереди\nи обновление статусов", "SQL/TCP 5432")
Rel(worker, db_files, "Чтение фото и подписей для протокола,\nсохранение PDF-протокола", "MongoDB/TCP 27017")
Rel(worker, ais_osago, "Повторная проверка наличия\nполиса при сбое", "HTTPS, JSON, mTLS", $tags="async")
Rel(worker, email_sys, "Отправка протокола\nосмотра", "SMTP / STARTTLS", $tags="async")
Rel(email_sys, client, "Доставка электронного\nпротокола осмотра", "E-mail", $tags="async")

SHOW_LEGEND()
@enduml
