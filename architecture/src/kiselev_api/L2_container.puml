@startuml
!include ../core/C4_Container.puml

title АВАРИЙНЫЙ ЭКСПЕРТ C4 CONTAINER

Person(dispatcher, "Диспетчер", "Оператор колл-центра: принимает\nзаявления о ДТП, назначает эксперта", $tags="staff")
Person(expert, "Аварийный эксперт", "Сотрудник, выезжающий\nна место ДТП", $tags="staff")
Person(client, "Участник ДТП", "Подписывает электронный\nпротокол осмотра", $tags="staff")

System_Boundary(osago_service, "Информационная система оформления ОСАГО (ИС ОСАГО)") {

    Container(web_app, "Web App", "React SPA", "Рабочее место эксперта: загрузка фото осмотра,\nсведения о ДТП, электронная подпись клиента")

    Container(api, "API", "FASTAPI", "REST/HTTPS JSON — акты фиксации ДТП,\nосмотр, проверка полиса ОСАГО")

    Container(worker, "Worker", "Python", "Асинхронная обработка:\nгенерация PDF-протокола, рассылка")

    ContainerDb(db_audit, "DB_AUDIT", "PostgreSQL", "Заявления о ДТП, акты фиксации, статусы осмотра,\nжурнал аудита и очередь асинхронных задач")

    ContainerDb(db_files, "DB_FILES", "MongoDB", "Хранит фото ДТП, подписи\nи файлы документов")
}

System_Ext(ais_osago, "АИС ОСАГО", "Автоматизированная информационная система", $tags="ext")
System_Ext(email_sys, "E-mail система", "Внутренняя система обмена письмами", $tags="ext")

Rel(dispatcher, web_app, "Регистрирует заявление о ДТП,\nназначает эксперта, отслеживает статус", "HTTPS")
Rel(expert, web_app, "Загружает фотографии осмотра\nи сведения о ДТП", "HTTPS")
Rel(client, web_app, "Ставит электронную подпись\nна протоколе осмотра", "HTTPS")

Rel(web_app, api, "Отправка\nрезультатов осмотра", "REST/HTTPS, JSON")

Rel(api, db_audit, "Читает и записывает акты фиксации,\nстатусы осмотра, события аудита", "SQL/TCP 5432")
Rel(api, db_files, "Сохраняет фото\nи подписи", "MongoDB Wire/TCP 27017")

Rel(api, ais_osago, "Проверяет наличие полиса ОСАГО", "HTTPS, JSON, mTLS", $tags="async")

Rel(worker, db_audit, "Читает и обновляет\nстатусы задач", "SQL/TCP 5432")
Rel(worker, db_files, "Чтение фото и подписей для протокола,\nсохранение PDF-протокола", "MongoDB Wire/TCP 27017")
Rel(worker, ais_osago, "Повторная проверка наличия\nполиса при сбое", "HTTPS, JSON, mTLS", $tags="async")
Rel(worker, email_sys, "Отправляет протокол\nосмотра", "SMTP / STARTTLS", $tags="async")
Rel(email_sys, client, "Доставка электронного\nпротокола осмотра", "E-mail", $tags="async")

SHOW_LEGEND()
@enduml
