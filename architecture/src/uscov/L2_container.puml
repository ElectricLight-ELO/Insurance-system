@startuml
!include ../core/C4_Container.puml

title ИС ОСАГО, фин. контроль и маржа. Container Diagram (L2) — модуль бухгалтерии и финансового контроля

LAYOUT_TOP_DOWN()

Person(accountant, "Бухгалтер", "Ведет финансовый учет,\nконтролирует маржинальность периода,\nпроверяет расчеты КВ", $tags="staff")
Person(auditor, "Финансовый аудитор", "Анализирует финансовые потоки компании,\nпроверяет результаты сверки платежей", $tags="staff")

System_Boundary(osago_service, "ИС ОСАГО: Фин. контроль и маржа") {
    Container(web_app, "Web App", "React SPA", "Рабочее место бухгалтера и финансового менеджера,\nуправление расчетами маржи, КВ и отчетами", $tags="target")
    Container(api, "API", "FastAPI", "REST/HTTPS JSON API — расчет маржи, КВ,\nинициация сверки платежей, выдача отчетов", $tags="target")
    Container(worker, "Worker", "Python / Celery", "Фоновый процессор: периодический расчет маржи,\nсверка зависших транзакций, генерация отчетов", $tags="target")

    ContainerDb(db_tariffs, "DB_TARIFS", "PostgreSQL", "Хранение тарифных сеток,\nкоэффициентов и ставок КВ")
    ContainerDb(db_audit, "DB_AUDIT", "PostgreSQL", "Хранение финансовых транзакций,\nлогов аудита и очереди задач (outbox)")
    ContainerDb(db_files, "DB_FILES", "MongoDB / GridFS", "Хранение сгенерированных финансовых актов\nи PDF-документов")
}

System_Ext(ais_osago, "АИС ОСАГО (РСА)", "Проверка договоров страхования,\nсведения о полисах", $tags="ext")
System_Ext(payment_sys, "Платежная система / Эквайринг", "Внешний банковский шлюз:\nпроведение оплат и сверка статусов", $tags="ext")
System_Ext(email_sys, "E-mail система", "Доставка закрывающих финансовых отчетов\nи уведомлений бухгалтеру", $tags="ext")

Rel(accountant, web_app, "Работает с интерфейсом системы,\nзапускает расчеты и сверки", "HTTPS")
Rel(auditor, web_app, "Просматривает финансовые отчеты\nи журналы аудита", "HTTPS")

Rel(web_app, api, "Отправляет запросы к REST API", "HTTPS, JSON")

Rel(api, db_tariffs, "Читает тарифные сетки и ставки КВ", "SQL, TCP 5432")
Rel(api, db_audit, "Читает финансовые транзакции,\nзаписывает события аудита, пишет в outbox", "SQL, TCP 5432")
Rel(api, db_files, "Сохраняет и запрашивает финансовые PDF-документы", "MongoDB, TCP 27017")

Rel(worker, db_audit, "Опрашивает очередь outbox,\nобновляет статусы транзакций", "SQL, TCP 5432")
Rel(worker, db_tariffs, "Читает тарифные сетки при фоновом расчете", "SQL, TCP 5432")
Rel(worker, db_files, "Сохраняет сгенерированные отчеты в GridFS", "MongoDB, TCP 27017")

Rel(api, ais_osago, "Сверяет данные по договорам\nпри расчете маржи", "HTTPS, JSON, mTLS")
Rel(worker, payment_sys, "Запрашивает статусы зависших платежей\nдля автоматической сверки", "HTTPS, JSON")
Rel(worker, email_sys, "Отправляет итоговые финансовые отчеты\nбухгалтеру", "SMTP / STARTTLS", $tags="async")
Rel(email_sys, accountant, "Доставляет отчеты на e-mail", "E-mail", $tags="async")

SHOW_LEGEND()
@enduml