@startuml
!include ../core/C4_Context.puml

title ИС ОСАГО, фин. контроль и маржа. System Context (L1) — модуль бухгалтерии и финансового контроля

Person(accountant, "Бухгалтер", "Ведет финансовый учет,\nконтролирует маржинальность периода,\nпроверяет расчеты КВ", $tags="staff")
Person(auditor, "Финансовый аудитор", "Анализирует финансовые потоки компании,\nпроверяет результаты сверки платежей", $tags="staff")

System(mod_finance, "ИС ОСАГО: Фин. контроль и маржа", "Расчет маржинальности периода и агентских комиссий (КВ),\nавтоматическая сверка зависших транзакций с эквайрингом,\nформирование финансовых отчетов и аудит", $tags="target")

System_Ext(ais_osago, "АИС ОСАГО (РСА)", "Проверка договоров страхования,\nсведения о полисах", $tags="ext")
System_Ext(bank_sys, "Платежная система / Эквайринг", "Внешний банковский шлюз:\nпроведение оплат и сверка статусов", $tags="ext")
System_Ext(email_sys, "E-mail система", "Доставка закрывающих финансовых отчетов\nи уведомлений бухгалтеру", $tags="ext")

Rel(accountant, mod_finance, "Запускает расчет маржи и КВ,\nконтролирует сверку оплат", "HTTPS")
Rel(auditor, mod_finance, "Проверяет финансовые логи,\nотчеты и результаты сверки", "HTTPS")

Rel(mod_finance, ais_osago, "Сверяет данные по договорам\nпри финансовом аудите", "HTTPS, JSON, mTLS")
Rel(mod_finance, bank_sys, "Запрашивает статусы платежей\nдля автоматической сверки оплат", "HTTPS, JSON")
Rel(mod_finance, email_sys, "Отправляет закрывающие финансовые отчеты\nи уведомления", "SMTP / STARTTLS", $tags="async")
Rel(email_sys, accountant, "Доставляет отчеты на e-mail", "E-mail", $tags="async")

SHOW_LEGEND()
@enduml