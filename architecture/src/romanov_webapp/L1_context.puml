@startuml
!include ../core/C4_Context.puml

LAYOUT_TOP_DOWN()
title ИС ОСАГО — локальная диаграмма контекста (L1): продажа и оформление полисов (Романов Н.И.)

Person(guest, "Гость", "Рассчитывает стоимость\nполиса без входа", $tags="outsider")
Person(client, "Клиент", "Оформляет полис,\nличный кабинет", $tags="staff")
Person(agent, "Страховой агент", "Оформляет полисы\nза клиентов", $tags="staff")
Person(manager, "Менеджер отдела продаж", "Контроль агентов,\nсложные случаи", $tags="staff")
Person(payer, "Застрахованный клиент", "Оплачивает полис", $tags="outsider")

System(osago, "ИС ОСАГО", "Расчёт премии, оформление и\nоплата полиса,\nличный кабинет, рабочие места\nагента и менеджера", $tags="target")
System_Ext(payment_sys, "Платёжная система", "Платёжная сессия,\nwebhook об оплате", $tags="ext")
System_Ext(sms_sys, "SMS-шлюз", "Одноразовые коды входа", $tags="ext")
System_Ext(email_sys, "E-mail система", "Электронный полис и чек", $tags="ext")
System_Ext(ais_osago, "АИС ОСАГО (РСА)", "КБМ, проверка ТС и водителей,\nрегистрация договора", $tags="ext")

Rel(guest, osago, "Рассчитывает стоимость полиса", "HTTPS")
Rel(client, osago, "Оформляет полис, скачивает PDF", "HTTPS")
Rel(agent, osago, "Оформляет полис за клиента", "HTTPS")
Rel(manager, osago, "Смотрит продажи, утверждает\nсложные случаи", "HTTPS")

Rel(payer, payment_sys, "Оплачивает полис", "HTTPS")
Rel(osago, payment_sys, "Создаёт платёжную сессию", "HTTPS, JSON")
Rel(payment_sys, osago, "Сообщает об оплате (webhook)", "HTTPS, JSON")
Rel(osago, sms_sys, "Отправляет код входа", "HTTPS, JSON")
Rel(osago, email_sys, "Отправляет полис и чек", "SMTP/STARTTLS 587", $tags="async")
Rel(osago, ais_osago, "Получает КБМ, проверяет ТС\nи водителей", "HTTPS, JSON, mTLS")

SHOW_LEGEND()
@enduml
