@startuml
!include ../core/C4_Dynamic.puml


LAYOUT_TOP_DOWN()
title Динамическая диаграмма — расчёт, оформление и оплата полиса ОСАГО в Web App

Person(client, "Клиент или агент", "Оформляет полис")
Person(payer, "Застрахованный клиент", "Оплачивает полис")
Container_Boundary(web_app, "Web App (React SPA)") {
  Component(p_calc, "CalculatorPage", "React Page", "Расчёт стоимости")
  Component(p_buy, "CheckoutPage", "React Page", "Оформление и оплата")
  Component(l_pol, "PolicyLogic", "React Hooks", "Расчёт, оформление, оплата")
  Component(a_pol, "PolicyApiClient", "TypeScript", "Расчёт, оформление, оплата, PDF")
  Component(http, "HttpClient", "axios", "Токен в каждом запросе, 401/403, повторы")
  Component(l_auth, "AuthLogic", "React Context", "Токен и роль пользователя")
}
Container_Boundary(api, "API (FastAPI)") {
  Component(policy_comp, "PolicyController", "FastAPI Router", "Расчёт и оформление полиса")
  Component(payment_comp, "PaymentController", "FastAPI Router", "Оплата, webhook")
  Component(access_comp, "AccessService", "Python · Strategy", "Проверка прав (RBAC)")
  Component(s_pol, "PolicyService", "Python", "Премия, полис")
  Component(s_pay, "PaymentService", "Python", "Сессия, обработка webhook")
  Component(r_tar, "TariffRepository", "SQLAlchemy", "Тарифы и коэффициенты")
  Component(f_ais, "AisOsagoFacade", "HTTP Client", "КБМ, проверки, регистрация")
  Component(r_user, "UserRepository", "SQLAlchemy", "Пользователи, полисы")
  Component(f_pay, "PaymentGatewayFacade", "HTTP Client", "Платёжные сессии")
  Component(task_queue_comp, "TaskQueueFacade", "SQL Client", "Задачи в очередь для Worker")
  Component(r_acc, "AccidentRepository", "SQLAlchemy", "Транзакции, очередь задач")
}
ContainerDb(db_tarifs, "DB_TARIFS", "PostgreSQL", "Тарифы, коэффициенты")
ContainerDb(db_users, "DB_USERS", "PostgreSQL", "Пользователи, полисы")
ContainerDb(db_audit, "DB_AUDIT", "PostgreSQL", "Транзакции, outbox")
Container(worker, "Worker", "Python / Celery", "Регистрация договора, PDF, письма")
System_Ext(ais_osago, "АИС ОСАГО (РСА)", "КБМ, проверки, регистрация", $tags="ext")
System_Ext(payment_sys, "Платёжная система", "Платёжные сессии", $tags="ext")
System_Ext(email_sys, "E-mail система", "Доставка полиса", $tags="ext")

Rel(client, p_calc, "01. Вводит данные ТС, водителей и регион", "HTTPS")
Rel(p_calc, l_pol, "02. calculate(data)", "React Hooks")
Rel(l_pol, a_pol, "03. calculate(data)", "TypeScript call")
Rel(a_pol, http, "04. POST /api/policies/calculate", "TypeScript call")
Rel(http, policy_comp, "05. calculate_premium(payload)", "REST/HTTPS, JSON")
Rel(policy_comp, s_pol, "06. calculate_premium(data)", "Python Call")
Rel(s_pol, r_tar, "07. get_coefficients()", "Python Call")
Rel(r_tar, db_tarifs, "08. Читает тариф и коэффициенты региона", "SQL/TCP 5432")
Rel(s_pol, f_ais, "09. get_kbm(), check_vehicle(), check_drivers()", "Python Call")
Rel(f_ais, ais_osago, "10. Запрос КБМ и проверка ТС и водителей", "HTTPS, JSON, mTLS")
Rel(client, p_buy, "11. Подтверждает оформление", "HTTPS")
Rel(p_buy, l_pol, "12. issue(draft)", "React Hooks")
Rel(l_pol, a_pol, "13. issue(draft)", "TypeScript call")
Rel(a_pol, http, "14. POST /api/policies", "TypeScript call")
Rel(http, l_auth, "15. getToken()", "React Context")
Rel(http, policy_comp, "16. issue_policy(payload)", "REST/HTTPS, JSON")
Rel(policy_comp, access_comp, "17. check_permission(token, «policy.issue»)", "Python Call")
Rel(policy_comp, s_pol, "18. issue_policy(draft)", "Python Call")
Rel(s_pol, r_user, "19. save_policy(policy)", "Python Call")
Rel(r_user, db_users, "20. Сохраняет полис (status = awaiting_payment)", "SQL/TCP 5432")
Rel(p_buy, l_pol, "21. pay(policyId)", "React Hooks")
Rel(l_pol, a_pol, "22. pay(policyId)", "TypeScript call")
Rel(a_pol, http, "23. POST /api/payments/session", "TypeScript call")
Rel(http, payment_comp, "24. create_session(payload)", "REST/HTTPS, JSON")
Rel(payment_comp, s_pay, "25. create_session(policy_id, amount)", "Python Call")
Rel(s_pay, f_pay, "26. create_session(policy_id, amount)", "Python Call")
Rel(f_pay, payment_sys, "27. Создаёт платёжную сессию, возвращает ссылку", "HTTPS, JSON")
Rel(payer, payment_sys, "28. Оплачивает полис", "HTTPS")
Rel(payment_sys, payment_comp, "29. POST /api/payments/webhook — handle_webhook()", "HTTPS, JSON")
Rel(payment_comp, s_pay, "30. handle_webhook(event)", "Python Call")
Rel(s_pay, r_acc, "31. save_transaction(tx)", "Python Call")
Rel(s_pay, task_queue_comp, "32. enqueue(CONTRACT_REG), enqueue(PDF_POLICY)", "Python Call")
Rel(task_queue_comp, r_acc, "33. save_task(task)", "Python Call")
Rel(r_acc, db_audit, "34. Транзакция и две задачи в outbox (pending)", "SQL/TCP 5432")
Rel(worker, db_audit, "35. list_pending_tasks(): CONTRACT_REG, PDF_POLICY", "SQL/TCP 5432")
Rel(worker, ais_osago, "36. register_policy(policy_data)", "HTTPS, JSON, mTLS", $tags="async")
Rel(worker, email_sys, "37. Отправляет PDF полиса и чек", "SMTP / STARTTLS", $tags="async")
Rel(email_sys, client, "38. Доставляет электронный полис", "E-mail", $tags="async")
SHOW_LEGEND()
@enduml
