' =====================================================================
'  ИС ОСАГО — ЕДИНЫЕ СТИЛИ C4 (зона ответственности тимлида)
'  Подключается только через core/C4_*.puml. В файлах разработчиков
'  skinparam, Add*Tag и Update*Style ЗАПРЕЩЕНЫ — только $tags="...".
' =====================================================================
skinparam defaultFontName "Liberation Sans"
skinparam shadowing false
skinparam wrapWidth 240
skinparam maxMessageSize 240
skinparam nodesep 50
skinparam ranksep 70

' --- Теги элементов (уровни L0–L2) ---
AddElementTag("target", $bgColor="#2E86C1", $fontColor="#FFFFFF", $borderColor="#1B4F72", $legendText="Целевой модуль разработчика")
AddElementTag("ext", $bgColor="#A9A9A9", $fontColor="#FFFFFF", $borderColor="#7F7F7F", $legendText="Внешняя система")
AddElementTag("city", $bgColor="#7DAA92", $fontColor="#FFFFFF", $borderColor="#4E7A63", $legendText="Сервис Smart City (предлагаемая интеграция)")
AddElementTag("staff", $bgColor="#1F4E8C", $fontColor="#FFFFFF", $borderColor="#143560", $legendText="Пользователь / сотрудник")
AddElementTag("outsider", $bgColor="#A9A9A9", $fontColor="#FFFFFF", $borderColor="#8A8A8A", $legendText="Внешний пользователь")

' --- Теги компонентов (уровень L3, динамика) ---
AddElementTag("changed", $borderColor="#E8590C", $borderThickness="4", $legendText="Изменено / добавлено на ревью")
AddElementTag("layer_api", $bgColor="#6CC2F5", $fontColor="#000000", $borderColor="#3A9BD8", $legendText="Слой API: контроллеры")
AddElementTag("layer_service", $bgColor="#6CC2F5", $fontColor="#000000", $borderColor="#2E86C1", $legendText="Слой бизнес-логики")
AddElementTag("layer_integration", $bgColor="#6CC2F5", $fontColor="#000000", $borderColor="#247FB0", $legendText="Слой интеграции: фасады")
AddElementTag("layer_data", $bgColor="#6CC2F5", $fontColor="#000000", $borderColor="#1B6E9C", $legendText="Слой данных: репозитории")
AddElementTag("layer_consumer", $bgColor="#6CC2F5", $fontColor="#000000", $borderColor="#3A9BD8", $legendText="Слой приёма задач")
AddElementTag("layer_ui", $bgColor="#6CC2F5", $fontColor="#000000", $borderColor="#1B6E9C", $legendText="Слой интерфейса")

' --- Теги связей ---
AddRelTag("async", $lineStyle=DashedLine(), $lineColor="#000000", $legendText="Асинхронное взаимодействие (фоновая обработка)")
AddRelTag("rbac", $lineColor="#7048E8", $lineStyle=DashedLine(), $legendText="Проверка прав (RBAC)")
AddRelTag("audit", $lineColor="#8C96A0", $lineStyle=DashedLine(), $legendText="Запись в аудит")
