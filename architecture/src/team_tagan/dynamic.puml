@startuml
!include ../core/C4_Dynamic.puml
LAYOUT_LEFT_RIGHT()
title Глобальная динамическая диаграмма ИС ОСАГО — сквозной процесс всех модулей (сборка тимлида)

Person(client, "Клиент / агент", "Полис, подпись протокола")
Person(payer, "Застрахованный клиент", "Оплата")
Person(dispatcher, "Диспетчер и эксперт", "ДТП и осмотр")
Person(accountant, "Бухгалтер", "Маржа и сверка")
Person(support, "Поддержка и ИБ", "Задачи и аудит")
Container(web_app, "Web App", "React SPA", "Романов Н.И.")
Container(backoffice, "Backoffice", "React SPA", "Мехова А.С.")
Container(api, "API", "FastAPI", "Киселев Д.А.")
Container(worker, "Worker", "Python / Celery", "Усков М.В.")
ContainerDb(db_users, "DB_USERS", "PostgreSQL", "Пользователи, полисы")
ContainerDb(db_tarifs, "DB_TARIFS", "PostgreSQL", "Тарифы, маржа")
ContainerDb(db_audit, "DB_AUDIT", "PostgreSQL", "Аудит, транзакции, ДТП, outbox")
ContainerDb(db_files, "DB_FILES", "MongoDB", "Фото, подписи, PDF")
System_Ext(sms_sys, "SMS-шлюз", "Коды", $tags="ext")
System_Ext(ais_osago, "АИС ОСАГО (РСА)", "КБМ, полисы, договоры", $tags="ext")
System_Ext(payment_sys, "Платёжная система", "Сессии, webhook, сверка", $tags="ext")
System_Ext(email_sys, "E-mail система", "Документы", $tags="ext")

' --- Фаза 0: вход
Rel(client, web_app, "Вводит телефон и код", "HTTPS")
Rel(web_app, api, "POST /api/auth/code — request_code(); POST /api/auth/verify — issue_token()", "REST/HTTPS, JSON")
Rel(api, sms_sys, "send_code(phone, code)", "HTTPS, JSON")
' --- Фаза А: продажа полиса (Романов)
Rel(web_app, api, "POST /api/policies/calculate — calculate_premium()", "REST/HTTPS, JSON")
Rel(api, db_tarifs, "get_coefficients()", "SQL")
Rel(api, ais_osago, "get_kbm(), check_vehicle(), check_drivers()", "HTTPS, JSON, mTLS")
Rel(web_app, api, "POST /api/policies — issue_policy()", "REST/HTTPS, JSON")
Rel(api, db_users, "save_policy()", "SQL")
Rel(web_app, api, "POST /api/payments/session — create_session()", "REST/HTTPS, JSON")
Rel(api, payment_sys, "create_session(policy_id, amount)", "HTTPS, JSON")
Rel(payer, payment_sys, "Оплачивает полис", "HTTPS")
Rel(payment_sys, api, "POST /api/payments/webhook — handle_webhook()", "HTTPS, JSON")
Rel(api, db_audit, "save_transaction(); save_task(CONTRACT_REG, PDF_POLICY)", "SQL")
Rel(worker, db_audit, "list_pending_tasks()", "SQL")
Rel(worker, ais_osago, "register_policy(policy_data)", "HTTPS, JSON, mTLS", $tags="async")
Rel(worker, db_files, "generate_policy_pdf() → save_policy_pdf()", "MongoDB driver")
Rel(worker, email_sys, "send_mail(полис, чек)", "SMTP / STARTTLS", $tags="async")
' --- Фаза Б: ДТП и осмотр (Киселев)
Rel(dispatcher, web_app, "Регистрирует заявление, назначает эксперта, вносит осмотр", "HTTPS")
Rel(web_app, api, "POST /api/claims — register_claim()", "REST/HTTPS, JSON")
Rel(api, ais_osago, "check_policy(claim)", "HTTPS, JSON, mTLS")
Rel(api, db_audit, "save_claim(); assign_expert()", "SQL")
Rel(web_app, api, "POST /api/claims/{id}/inspection, /photos — submit_results(), upload_photos()", "REST/HTTPS, multipart")
Rel(api, db_files, "save_photos(); save_inspection()", "MongoDB driver / SQL")
Rel(client, web_app, "Подписывает протокол", "HTTPS")
Rel(web_app, api, "POST /api/claims/{id}/signature — accept_signature()", "REST/HTTPS, JSON")
Rel(api, db_files, "save_signature()", "MongoDB driver")
Rel(api, db_audit, "save_task(PDF_PROTOCOL); save_audit()", "SQL")
Rel(worker, db_audit, "list_pending_tasks(): PDF_PROTOCOL", "SQL")
Rel(worker, db_files, "generate_protocol_pdf() → save_pdf()", "MongoDB driver")
Rel(worker, email_sys, "send_mail(протокол осмотра)", "SMTP / STARTTLS", $tags="async")
' --- Фаза В: финансовый контроль (Усков)
Rel(accountant, backoffice, "Запускает расчёт маржи за период", "HTTPS (VPN)")
Rel(backoffice, api, "POST /api/admin/finance/margin — trigger_margin()", "REST/HTTPS, JSON")
Rel(api, db_audit, "save_task(MARGIN_CALC)", "SQL")
Rel(worker, db_audit, "get_for_period(): транзакции", "SQL")
Rel(worker, db_tarifs, "get_coefficients(); save_margin_result()", "SQL")
Rel(worker, payment_sys, "check_pending_transactions() (Celery Beat)", "HTTPS, JSON")
Rel(worker, db_audit, "update_status() зависших платежей", "SQL")
Rel(worker, email_sys, "Отчёт по марже бухгалтеру", "SMTP / STARTTLS", $tags="async")
' --- Фаза Г: администрирование и аудит (Мехова)
Rel(support, backoffice, "Перезапускает сбойную задачу, открывает журнал аудита", "HTTPS (VPN)")
Rel(backoffice, api, "POST /api/admin/tasks/{id}/restart — restart_task()", "REST/HTTPS, JSON")
Rel(api, db_audit, "save_task(CONTRACT_REG, pending); save_audit(task_restarted)", "SQL")
Rel(backoffice, api, "GET /api/admin/audit — get_audit()", "REST/HTTPS, JSON")
Rel(api, db_audit, "list_audit()", "SQL")
SHOW_LEGEND()
@enduml
