@startuml
!include ../core/C4_Deployment.puml

title ИС ОСАГО. Общая диаграмма развёртывания и политики безопасности (сборка тимлида)

LAYOUT_TOP_DOWN()

Deployment_Node(dev_front, "Устройство клиента или сотрудника фронт-офиса", "ПК / смартфон") {
    Deployment_Node(br_front, "Веб-браузер", "Chrome / Firefox / Safari") {
        Container(web_app, "Web App", "React SPA", "Расчет, оформление и оплата полиса, личный кабинет;\nрабочие места агента, менеджера, диспетчера и эксперта")
    }
}

Deployment_Node(dev_back, "Рабочее место сотрудника бэк-офиса", "ПК") {
    Deployment_Node(br_back, "Веб-браузер", "Chrome / Firefox") {
        Container(backoffice, "Backoffice", "React SPA", "Админ-панель: пользователи, роли, тарифы, аудит, задачи;\nпоиск полисов, статусы платежей; аналитика маржи, отчеты")
    }
}

Deployment_Node(ngfw, "Внешний межсетевой экран + WAF", "NGFW, кластер 2 шт.", "Пропускает из интернета только TCP 443; WAF: OWASP Top 10, rate limit; webhook – только с IP платёжной системы и с проверкой подписи")
Deployment_Node(vpn, "VPN-шлюз", "IPsec / WireGuard", "Доступ сотрудников бэк-офиса; без VPN Backoffice недоступен")
Deployment_Node(dmz, "DMZ (VLAN 10)", "Сегмент сети: вход только от NGFW на TCP 443") {
    Deployment_Node(lb, "Балансировщик нагрузки и reverse proxy, 2 экземпляра", "nginx, режим active/passive", "Терминирует TLS 1.3, распределяет запросы между экземплярами API")
}

Deployment_Node(app_zone, "Зона приложений (VLAN 20)", "Сегмент сети: доступ только из DMZ; исходящие во внешние системы через NGFW") {
    Deployment_Node(api_cluster, "Кластер API, 3 экземпляра", "Docker-контейнеры") {
        Container(api, "API", "FastAPI", "REST/HTTPS JSON — расчет премии, оформление, оплата,\nRBAC, фиксация ДТП, администрирование,\nтарифы, финансовый контроль, выдача PDF")
    }
    Deployment_Node(worker_cluster, "Узлы Worker, 2 экземпляра", "Docker-контейнеры") {
        Container(worker, "Worker", "Python / Celery", "Фоновая обработка: PDF, регистрация договора,\nписьма, сверка платежей, расчет маржи, отчеты")
    }
}

Deployment_Node(corp, "Корпоративная зона (VLAN 40)", "Сервисы компании") {
    Deployment_Node(iam_n, "Сервер IAM", "Keycloak / корпоративная IAM", "SSO сотрудников, роли, OAuth2 / OIDC")
    Deployment_Node(crm_n, "Сервер CRM", "Корпоративная CRM", "Клиенты, продажи агентов")
    Deployment_Node(siem_n, "SIEM и мониторинг", "журналы, метрики, оповещения", "Сбор событий аудита и журналов; передача инцидентов в городской SOC")
}
Deployment_Node(data_zone, "Зона данных (VLAN 30)", "Сегмент сети: доступ только из зоны приложений на 5432 и 27017") {
    Deployment_Node(pg_primary, "Сервер PostgreSQL (primary)", "PostgreSQL") {
        ContainerDb(db_users, "DB_USERS", "PostgreSQL", "Пользователи, роли, права (RBAC),\nклиенты, номера полисов")
        ContainerDb(db_tarifs, "DB_TARIFS", "PostgreSQL", "Тарифные сетки, коэффициенты, правила\nрасчета, результаты расчета маржи")
        ContainerDb(db_audit, "DB_AUDIT", "PostgreSQL", "Аудит, транзакции, платежи, акты ДТП,\nочередь асинхронных задач (outbox)")
    }
    Deployment_Node(pg_replica, "Сервер PostgreSQL (replica)", "PostgreSQL, только чтение")
    Deployment_Node(mongo_primary, "Сервер MongoDB (primary)", "MongoDB, набор реплик") {
        ContainerDb(db_files, "DB_FILES", "MongoDB", "Фото ДТП, подписи, документы\n(PDF полисов и протоколов)")
    }
    Deployment_Node(mongo_secondary, "Серверы MongoDB (secondary), 2 экземпляра", "MongoDB, набор реплик")
}

System_Ext(sms_sys, "SMS-шлюз", "Отправка одноразовых кодов")
System_Ext(ais_osago, "АИС ОСАГО (РСА)", "КБМ, проверка ТС, водителей и полиса,\nрегистрация договоров, актуальные тарифы")
System_Ext(payment_sys, "Платежная система", "Платежные сессии, webhook об оплате,\nпоступления, комиссии, сверка платежей")
System_Ext(email_sys, "E-mail система", "Рассылка и обмен письмами: полисы, чеки, протоколы,\nсчета, акты, отчеты, уведомления о сбоях")

Rel(web_app, ngfw, "Загружает приложение; расчет, оформление, оплата, результаты осмотра, скачивание полиса", "HTTPS, TCP 443, TLS 1.3")
Rel(backoffice, vpn, "Загружает приложение; администрирование, тарифы, аудит, дашборд, управление задачами", "HTTPS, TCP 443, TLS 1.3")
Rel(dev_front, ngfw, "Страховой агент передает данные о продажах и комиссии (КВ) в API", "REST/HTTPS, TCP 443, TLS 1.3")
Rel(payment_sys, ngfw, "Уведомляет об оплате (webhook)", "HTTPS, TCP 443, TLS 1.3")
Rel(ngfw, lb, "Пропускает разрешённый трафик", "HTTPS, TCP 443")
Rel(vpn, lb, "Трафик Backoffice из VPN", "HTTPS, TCP 443, TLS 1.3")
Rel(lb, api, "Распределяет запросы между экземплярами API", "HTTPS, TCP 443, TLS 1.3")

Rel(api, db_users, "Аутентификация, пользователи, роли, клиенты, полисы", "SQL, TCP 5432, TLS")
Rel(api, db_tarifs, "Чтение и изменение тарифов, запись лога отчетов", "SQL, TCP 5432, TLS")
Rel(api, db_audit, "Аудит, транзакции, акты ДТП, задачи в outbox", "SQL, TCP 5432, TLS")
Rel(api, db_files, "Фото, подписи, документы; просмотр и удаление; выдача PDF по ссылке", "MongoDB driver, TCP 27017, TLS")

Rel(api, worker, "Ставит задачи: повтор, отчеты, расчет маржи (через outbox в DB_AUDIT, прямого соединения нет)", "SQL через DB_AUDIT, TCP 5432, TLS")

Rel(worker, db_tarifs, "Читает данные для расчета, записывает результаты маржи", "SQL, TCP 5432, TLS")
Rel(worker, db_audit, "Забирает задачи из outbox, обновляет статусы, сверяет оплаты", "SQL, TCP 5432, TLS")
Rel(worker, db_files, "Читает фото и подписи, сохраняет PDF, удаляет устаревшие файлы", "MongoDB driver, TCP 27017, TLS")

Rel(pg_primary, pg_replica, "Реплицирует изменения (потоковая репликация)", "SQL, TCP 5432, TLS")
Rel(mongo_primary, mongo_secondary, "Реплицирует изменения (набор реплик)", "MongoDB driver, TCP 27017, TLS")

Rel(api, sms_sys, "Отправляет одноразовый код для авторизации", "HTTPS, JSON, TCP 443, TLS 1.3")
Rel(api, ais_osago, "Запрашивает КБМ и тарифы, проверяет ТС, водителей и наличие полиса", "HTTPS, JSON, TCP 443, mTLS")
Rel(api, payment_sys, "Создает платежную сессию, получает отчеты о поступлениях", "HTTPS, JSON, TCP 443, TLS 1.3")
Rel(api, email_sys, "Отправляет вопросы и корректировки", "SMTP, TCP 587, STARTTLS")

Rel(worker, ais_osago, "Регистрирует договор после оплаты (в т.ч. по команде администратора), повторная проверка полиса", "HTTPS, JSON, TCP 443, mTLS")
Rel(worker, payment_sys, "Сверяет зависшие платежи (по расписанию)", "HTTPS, JSON, TCP 443, TLS 1.3")
Rel(worker, email_sys, "Отправляет полисы, чеки, протоколы, счета, отчеты, уведомления о сбоях", "SMTP, TCP 587, STARTTLS")
Rel(api, iam_n, "Проверка токенов сотрудников (introspection)", "HTTPS, OAuth2, TCP 8443, TLS")
Rel(api, crm_n, "Клиенты и продажи агентов", "HTTPS, JSON, TCP 443, TLS")
Rel(api, siem_n, "События аудита и журналы", "syslog over TLS, TCP 6514")
Rel(worker, siem_n, "Журналы задач", "syslog over TLS, TCP 6514")
@enduml
