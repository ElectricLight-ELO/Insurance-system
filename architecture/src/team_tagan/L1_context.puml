@startuml
!include ../core/C4_Context.puml

title Информационная система оформления ОСАГО (ИС ОСАГО). System Context

Person(guest, "Гость", "Неавторизованный посетитель,\nрассчитывает стоимость полиса", $tags="outsider")
Person(agent, "Страховой агент", "Специалист, оформляющий полисы,\nработает с клиентами, передает данные\nпо комиссии (КВ)", $tags="staff")
Person(manager, "Менеджер отдела продаж", "Контроль работы агентов, отчеты по продажам,\nутверждение сложных случаев", $tags="staff")
Person(dispatcher, "Диспетчер", "Оператор колл-центра: принимает заявления о ДТП,\nназначает эксперта, отслеживает статус", $tags="staff")
Person(expert, "Аварийный эксперт", "Выезжает на место ДТП, загружает\nфото осмотра и сведения о ДТП", $tags="staff")
Person(support, "Оператор поддержки", "Отслеживает статусы полисов и платежей,\nперезапускает зависшие задачи", $tags="staff")
Person(auditor, "Сотрудник ИБ", "Изучает журнал аудита,\nрасследует инциденты", $tags="staff")
Person(accountant, "Бухгалтер", "Проверяет маржу и статусы оплат,\nформирует счета и акты, подписывает отчеты", $tags="staff")
Person(admin, "Администратор", "Права всех ролей: пользователи,\nроли, тарифы, аудит, задачи", $tags="staff")
Person(client, "Клиент", "Участник ДТП (страхователь или потерпевший):\nподает заявку, загружает фото, получает полис,\nставит подпись на протоколе осмотра", $tags="staff")
Person(payer, "Застрахованный клиент", "Застрахованное лицо,\nсовершающее оплату полиса", $tags="outsider")

System(osago, "Информационная система оформления ОСАГО (ИС ОСАГО)", "Расчет премии, оформление и оплата полисов, фиксация ДТП и осмотр,\nавторизация (RBAC), администрирование и тарифы, аудит,\nфинансовый контроль и верификация маржи, фоновая обработка задач")

System_Ext(email_sys, "E-mail система", "Рассылка и обмен письмами: полисы, чеки, протоколы,\nсчета, акты, отчеты, уведомления о сбоях", $tags="ext")
System_Ext(payment_sys, "Платежная система", "Платежные сессии, webhook об оплате,\nпоступления, комиссии, сверка платежей", $tags="ext")
System_Ext(ais_osago, "АИС ОСАГО (РСА)", "КБМ, проверка ТС, водителей и полиса,\nрегистрация договоров, актуальные тарифы", $tags="ext")
System_Ext(sms_sys, "SMS-шлюз", "Отправка одноразовых кодов", $tags="ext")

Rel(guest, osago, "Рассчитывает стоимость без регистрации", "HTTPS")
Rel(agent, osago, "Оформляет полисы и договоры,\nпередает данные о продажах и КВ", "HTTPS, REST")
Rel(manager, osago, "Смотрит отчеты, управляет агентами,\nутверждает сложные случаи", "HTTPS")
Rel(dispatcher, osago, "Регистрирует заявления о ДТП,\nназначает эксперта", "HTTPS")
Rel(expert, osago, "Загружает фото осмотра\nи сведения о ДТП", "HTTPS")
Rel(support, osago, "Ищет полисы, смотрит статусы,\nперезапускает задачи", "HTTPS")
Rel(auditor, osago, "Изучает журнал аудита,\nрасследует инциденты", "HTTPS")
Rel(accountant, osago, "Проверяет маржу и оплаты,\nформирует счета и акты", "HTTPS")
Rel(admin, osago, "Управляет пользователями, ролями,\nтарифами, задачами", "HTTPS")
Rel(client, osago, "Вводит данные, подает заявку, загружает фото,\nскачивает полис, подписывает протокол", "HTTPS")

Rel(osago, email_sys, "Отправляет полисы, чеки, протоколы, счета,\nотчеты, уведомления о сбоях, вопросы", "SMTP / HTTPS", $tags="async")

Rel(osago, payment_sys, "Создает платежную сессию,\nполучает отчеты о поступлениях", "HTTPS, JSON")
Rel(payment_sys, osago, "Уведомляет об оплате (webhook)", "HTTPS, JSON")
Rel(osago, payment_sys, "Сверяет зависшие платежи\n(по расписанию)", "HTTPS, JSON", $tags="async")

Rel(osago, ais_osago, "Запрашивает КБМ и тарифы, проверяет ТС, водителей и полис;\nрегистрирует договор после оплаты", "HTTPS, JSON")
Rel(osago, sms_sys, "Отправляет одноразовый код\nдля авторизации", "HTTPS, JSON")

Rel(payer, payment_sys, "Оплачивает полис", "HTTPS")

Rel(email_sys, client, "Доставляет полисы, чеки,\nпротоколы осмотра", "E-mail", $tags="async")
Rel(email_sys, accountant, "Доставляет счета, акты,\nфинансовые отчеты", "E-mail", $tags="async")
Rel(email_sys, admin, "Доставляет уведомления о сбоях\nи отчеты о работе системы", "E-mail", $tags="async")

@enduml
