' Рисунок 4.25. Объединение локальных динамических представлений 4.26–4.29.
' Глобальные идентификаторы компонентов включают имя контейнера.
@startuml
!include <C4/C4_Dynamic>
skinparam defaultFontName Arial
skinparam wrapWidth 260
AddElementTag("ext", $bgColor="#A9A9A9", $borderColor="#8A8A8A", $fontColor="#FFFFFF", $legendText="Внешняя система")
AddElementTag("staff", $bgColor="#1F4E8C", $borderColor="#143560", $fontColor="#FFFFFF", $legendText="Пользователь / сотрудник")
AddElementTag("ctrl", $bgColor="#5DADE2", $borderColor="#2E86C1", $fontColor="#000000", $legendText="Слой входа: контроллеры, страницы, задачи")
AddElementTag("svc", $bgColor="#85C1E9", $borderColor="#2E86C1", $fontColor="#000000", $legendText="Слой бизнес-логики")
AddElementTag("integ", $bgColor="#AED6F1", $borderColor="#2E86C1", $fontColor="#000000", $legendText="Слой интеграции: фасады / API-клиенты")
AddElementTag("data", $bgColor="#D6EAF8", $borderColor="#2E86C1", $fontColor="#000000", $legendText="Слой данных: репозитории")
AddRelTag("async", $lineStyle=DashedLine(), $lineColor="#000000", $legendText="Асинхронное взаимодействие (фоновая обработка)")
HIDE_STEREOTYPE()
skinparam dpi 104
skinparam nodesep 20
skinparam ranksep 42
title ИС ОСАГО — глобальная динамическая диаграмма взаимодействия компонентов
caption Обозначения связей: Д — ДТП и осмотр (4.26), Ф — финансовый контроль (4.27), А — администрирование (4.28), П — оформление полиса (4.29).
ContainerDb(db_audit, "DB_AUDIT", "PostgreSQL", "Заявления, события аудита, очередь задач (outbox)")
ContainerDb(db_files, "DB_FILES", "MongoDB", "Фото осмотра, подписи, PDF-протоколы")
System_Ext(ais, "АИС ОСАГО (РСА)", "Проверка полиса ОСАГО, сведения о договоре", $tags="ext")
System_Ext(email, "E-mail система", "Доставка документов и уведомлений", $tags="ext")
ContainerDb(db_tarifs, "DB_TARIFS", "PostgreSQL", "Тарифные сетки, ставки КВ, результаты маржи")
System_Ext(payment, "Платёжная система / Эквайринг", "Внешний банковский шлюз, статусы платежей", $tags="ext")
Person(support, "Оператор поддержки", "Перезапускает сбойные задачи", $tags="staff")
Person(security, "Сотрудник ИБ", "Проверяет журнал аудита", $tags="staff")
Person(client, "Клиент или агент", "Оформляет полис", $tags="staff")
Person(insured, "Застрахованный клиент", "Оплачивает полис", $tags="staff")
ContainerDb(db_users, "DB_USERS", "PostgreSQL", "Пользователи, полисы")

Container_Boundary(web_app, "Web App (React SPA)") {
    Component(web_app_calculator_page, "CalculatorPage", "React Page", "Расчёт стоимости", $tags="ctrl")
    Component(web_app_checkout_page, "CheckoutPage", "React Page", "Оформление и оплата", $tags="ctrl")
