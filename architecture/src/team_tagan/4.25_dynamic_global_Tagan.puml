    Component(web_app_policy_api, "PolicyApiClient", "TypeScript", "Расчёт, оформление, оплата, PDF", $tags="integ")
    Component(web_app_http_client, "HttpClient", "axios", "Токен в каждом запросе, 401/403, повторы", $tags="integ")
    Component(web_app_auth_logic, "AuthLogic", "React Context", "Токен и роль пользователя", $tags="svc")
}

