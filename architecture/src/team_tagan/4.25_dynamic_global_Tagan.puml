    Component(worker_tariff_repo, "TariffRepository", "SQLAlchemy", "Тарифные коэффициенты, результаты маржи", $tags="data")
    Component(worker_audit_repo, "AuditRepository", "SQLAlchemy", "Outbox, статусы задач, аудит", $tags="data")
}

