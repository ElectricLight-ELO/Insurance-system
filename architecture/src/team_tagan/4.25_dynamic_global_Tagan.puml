    Component(api_policy_comp, "PolicyController", "FastAPI Router", "Расчёт и оформление полиса", $tags="ctrl")
    Component(api_payment_comp, "PaymentController", "FastAPI Router", "Оплата, webhook", $tags="ctrl")
    Component(api_policy_svc, "PolicyService", "Python", "Премия, полис", $tags="svc")
    Component(api_payment_svc, "PaymentService", "Python", "Сессия, обработка webhook", $tags="svc")
    Component(api_payment_facade, "PaymentGatewayFacade", "HTTP Client", "Платёжные сессии", $tags="integ")
    Component(api_tariff_repo, "TariffRepository", "SQLAlchemy", "Тарифы и коэффициенты", $tags="data")
    Component(api_user_repo, "UserRepository", "SQLAlchemy", "Пользователи, полисы", $tags="data")
}

