@startuml
!include ../core/C4_Context.puml

title ИС ОСАГО, фиксация ДТП. System Context (L1) — модуль аварийного эксперта (Киселев Д.А.)

Person(dispatcher, "Диспетчер", "Оператор колл-центра: принимает\nзаявления о ДТП, назначает эксперта,\nотслеживает статус", $tags="staff")
Person(expert, "Аварийный эксперт", "Выезжает на место ДТП, проводит осмотр,\nзагружает фото осмотра и сведения о ДТП", $tags="staff")
Person(client, "Клиент", "Участник ДТП (страхователь или потерпевший):\nподает заявку, ставит подпись\nна протоколе осмотра", $tags="staff")

System(mod_accident, "ИС ОСАГО: фиксация ДТП и осмотр", "Регистрация заявлений о ДТП и назначение эксперта,\nприём результатов осмотра, фотографий и электронной подписи,\nпроверка полиса ОСАГО, выдача PDF-протокола осмотра", $tags="target")

System_Ext(ais_osago, "АИС ОСАГО (РСА)", "Проверка наличия полиса ОСАГО,\nсведения о договоре", $tags="ext")
System_Ext(email_sys, "E-mail система", "Доставка протоколов осмотра\nи уведомлений", $tags="ext")

Rel(dispatcher, mod_accident, "Регистрирует заявление о ДТП,\nназначает эксперта", "HTTPS")
Rel(expert, mod_accident, "Загружает фотографии осмотра\nи сведения о ДТП", "HTTPS")
Rel(client, mod_accident, "Ставит электронную подпись\nна протоколе осмотра", "HTTPS")

Rel(mod_accident, ais_osago, "Проверяет наличие полиса ОСАГО\nпри регистрации заявления", "HTTPS, JSON, mTLS")
Rel(mod_accident, email_sys, "Отправляет протокол осмотра\nи уведомления о статусе", "SMTP / STARTTLS", $tags="async")
Rel(email_sys, client, "Доставляет протокол осмотра", "E-mail", $tags="async")

SHOW_LEGEND()
@enduml
