@startuml
title ИС ОСАГО. UML CLASS DIAGRAM — контейнер "Backoffice (React SPA)" (итоговая, на основе L3)

skinparam classAttributeIconSize 0
skinparam nodesep 40
skinparam ranksep 55
skinparam packageStyle frame
hide stereotype
skinparam class {
    BackgroundColor #FFFBEA
    BorderColor #D9A400
    HeaderBackgroundColor #FFD966
}
skinparam interface {
    BackgroundColor #FFFBEA
    BorderColor #D9A400
    HeaderBackgroundColor #FFD966
}
skinparam enum {
    BackgroundColor #FFFBEA
    BorderColor #D9A400
    HeaderBackgroundColor #FFD966
}
skinparam package {
    BorderColor #B8860B
}

package "Маршруты" #FFFDF2 {
    class AppRouter <<React Router>> {
        - routes: Route[]
        + canActivate(route: string, role: Role) -> boolean
        + redirectToLogin() -> void
    }
}

package "Страницы (React Page)" #FFFDF2 {
    class LoginPage <<React Page>> {
        - phone: string
        - code: string
        + render() -> JSX.Element
    }
    class UsersRolesPage <<React Page>> {
        - users: User[]
        + render() -> JSX.Element
    }
    class TariffsPage <<React Page>> {
        - tariffs: Tariff[]
        + render() -> JSX.Element
    }
    class TasksPage <<React Page>> {
        - failed: Task[]
        + render() -> JSX.Element
        + restart(taskId: string) -> void
    }
    class PolicySearchPage <<React Page>> {
        - query: string
        + render() -> JSX.Element
    }
    class AuditLogPage <<React Page>> {
        - events: AuditEvent[]
        + render() -> JSX.Element
    }
    class FinanceDashboard <<React Page>> {
        - margin: MarginReport
        + render() -> JSX.Element
    }
}

package "Логика и UI" #FFFDF2 {
    enum Role {
        ADMIN
        SUPPORT
        SECURITY
        ACCOUNTANT
    }
    class AuthLogic <<React Context>> {
        - token: string | null
        - role: Role | null
        + login(phone: string, code: string) -> Promise<void>
        + logout() -> void
        + getToken() -> string | null
        + getRole() -> Role | null
    }
    class AdminLogic <<React Hooks>> {
        + saveUser(user: UserDTO) -> Promise<void>
        + assignRole(userId: string, role: Role) -> Promise<void>
        + saveTariff(tariff: TariffDTO) -> Promise<void>
    }
    class OperationsLogic <<React Hooks>> {
        + loadFailedTasks() -> Promise<Task[]>
        + restartTask(taskId: string) -> Promise<void>
        + findPolicies(query: string) -> Promise<Policy[]>
        + loadPaymentStatuses() -> Promise<Payment[]>
    }
    class AuditLogic <<React Hooks>> {
        - filter: AuditFilter
        + loadEvents() -> Promise<AuditEvent[]>
        + exportEvents() -> void
    }
    class FinanceLogic <<React Hooks>> {
        + loadMargin(period: Period) -> Promise<MarginReport>
        + loadPayments() -> Promise<Payment[]>
        + requestInvoice(period: Period) -> Promise<void>
    }
    class DocumentViewer <<React Component>> {
        - url: string | null
        + open(documentId: string) -> Promise<void>
        + close() -> void
    }
    class ReportExporter <<SheetJS>> {
        + toExcel(rows: object[], name: string) -> void
        + toCsv(rows: object[], name: string) -> void
    }
    class NotificationCenter <<React Component>> {
        - items: Notice[]
        + showError(message: string) -> void
        + showSuccess(message: string) -> void
    }
}

package "API-клиенты" #FFFDF2 {
    class AuthApiClient <<TypeScript>> {
        - _http: HttpClient
        + requestCode(phone: string) -> Promise<void>
        + verifyCode(phone: string, code: string) -> Promise<TokenResponse>
    }
    class AdminApiClient <<TypeScript>> {
        - _http: HttpClient
        + listUsers() -> Promise<UserDTO[]>
        + saveUser(user: UserDTO) -> Promise<UserDTO>
        + assignRole(userId: string, role: Role) -> Promise<UserDTO>
        + getTariffs() -> Promise<TariffDTO[]>
        + saveTariff(tariff: TariffDTO) -> Promise<TariffDTO>
    }
    class OperationsApiClient <<TypeScript>> {
        - _http: HttpClient
        + failedTasks() -> Promise<Task[]>
        + restartTask(taskId: string, body: TaskRestartRequest) -> Promise<void>
        + registerContract(policyNumber: string) -> Promise<void>
        + searchPolicies(query: string) -> Promise<PolicyDTO[]>
        + payments() -> Promise<PaymentDTO[]>
    }
    class AuditApiClient <<TypeScript>> {
        - _http: HttpClient
        + events(filter: AuditFilter) -> Promise<AuditEventDTO[]>
    }
    class FinanceApiClient <<TypeScript>> {
        - _http: HttpClient
        + margin(period: Period) -> Promise<MarginReportDTO[]>
        + payments(period: Period) -> Promise<PaymentDTO[]>
        + requestInvoice(body: InvoiceRequest) -> Promise<void>
    }
}

package "HTTP" #FFFDF2 {
    class HttpClient <<axios>> {
        - _baseUrl: string
        - _auth: AuthLogic
        + request<T>(method: string, url: string, body?: object) -> Promise<T>
        + attachToken() -> void
        + handleError(status: number) -> void
        + retry(request: Request, attempts: number) -> Promise<Response>
    }
}

' --- Зависимости (из связей компонентов L3) ---
AppRouter ..> LoginPage
AppRouter ..> UsersRolesPage
AppRouter ..> TariffsPage
AppRouter ..> TasksPage
AppRouter ..> PolicySearchPage
AppRouter ..> AuditLogPage
AppRouter ..> FinanceDashboard
AppRouter ..> AuthLogic : "RBAC"
LoginPage ..> AuthLogic
UsersRolesPage ..> AdminLogic
TariffsPage ..> AdminLogic
TasksPage ..> OperationsLogic
PolicySearchPage ..> OperationsLogic
AuditLogPage ..> AuditLogic
FinanceDashboard ..> FinanceLogic
AuthLogic ..> AuthApiClient
AdminLogic ..> AdminApiClient
OperationsLogic ..> OperationsApiClient
AuditLogic ..> AuditApiClient
FinanceLogic ..> FinanceApiClient
PolicySearchPage ..> DocumentViewer
DocumentViewer ..> OperationsApiClient
AuditLogPage ..> ReportExporter
FinanceDashboard ..> ReportExporter
AuthApiClient ..> HttpClient
AdminApiClient ..> HttpClient
OperationsApiClient ..> HttpClient
AuditApiClient ..> HttpClient
FinanceApiClient ..> HttpClient
HttpClient ..> NotificationCenter
HttpClient ..> AuthLogic : "RBAC"

' --- Реализации и прочие связи ---

@enduml
