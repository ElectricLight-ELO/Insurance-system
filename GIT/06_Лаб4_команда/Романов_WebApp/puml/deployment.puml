@startuml
skinparam defaultFontName "Liberation Sans"
skinparam dpi 140
skinparam shadowing false
skinparam node {
  BackgroundColor #EAF4FB
  BorderColor #2E86C1
}
skinparam artifact {
  BackgroundColor #6CC2F5
  BorderColor #2E86C1
}
skinparam database {
  BackgroundColor #A9D8F5
  BorderColor #2E86C1
}
skinparam ArrowColor #1B2A4A
title ИС ОСАГО, продажа полисов. DEPLOYMENT DIAGRAM — локальный сегмент модуля Web App

node "Устройства клиентов и агентов\n(браузер: ПК, смартфон)" as dev
node "CDN / кэш статики\n(опционально)" as cdn
node "Корпоративный сервер (on-prem)\nDocker host, Linux, 16 CPU / 32 GB" as host {
  node "Изолированная docker-сеть\n172.20.0.0/16 (bridge)" as net {
    artifact "Nginx Reverse Proxy\n:443, TLS 1.2+, HSTS\nединственная точка входа\nrate limit на /api/policies/calculate" as nginx
    artifact "Web App\nстатический бандл React SPA\n(отдаётся Nginx)" as web
    artifact "API (FastAPI)\nреплика 1\n:8000" as api1
    artifact "API (FastAPI)\nреплика 2\n:8000" as api2
    artifact "Worker (Celery)\nинстанс 1" as w1
    database "DB_TARIFS\nPostgreSQL :5432, TLS" as dbt
    database "DB_USERS\nPostgreSQL, Master\n:5432, TLS" as dbu
    database "DB_USERS\nPostgreSQL, Replica\n(hot standby), :5432" as dbur
    database "DB_AUDIT\nPostgreSQL :5432, TLS\n(транзакции, outbox)" as dba
  }
}
cloud "Интернет" as inet {
  node "Платёжная система\n(эквайринг)" as pay
  node "АИС ОСАГО (РСА)\nвнешняя отраслевая система" as ais
  node "E-mail система\nвнешний почтовый релей" as mail
}
dev --> cdn : "HTTPS :443/TCP\n(статика)"
cdn --> nginx : "HTTPS :443/TCP"
dev --> nginx : "HTTPS, TLS 1.2+, HSTS\n:443/TCP (API)"
nginx --> web : "отдача статики\n:443/TCP"
nginx --> api1 : "reverse proxy\n:8000/TCP, round-robin\n+ health check"
nginx --> api2 : "reverse proxy\n:8000/TCP, round-robin\n+ health check"
pay --> nginx : "webhook об оплате\nHTTPS :443/TCP,\nподпись запроса + IP allowlist"
api1 --> dbt : "SQL/TCP, TLS :5432"
api1 --> dbu : "SQL/TCP, TLS :5432"
api2 --> dbu : "SQL/TCP, TLS :5432"
api1 --> dba : "SQL/TCP, TLS :5432"
api2 --> dba : "SQL/TCP, TLS :5432"
dbu --> dbur : "streaming replication\n:5432/TCP, TLS"
api1 --> ais : "HTTPS, mTLS :443/TCP\nКБМ, проверки"
api1 --> pay : "HTTPS :443/TCP\nплатёжная сессия"
w1 --> dba : "опрос outbox\n:5432/TCP, TLS"
w1 --> ais : "HTTPS, mTLS :443/TCP\nрегистрация договора"
w1 --> mail : "SMTP STARTTLS :587/TCP"
@enduml
