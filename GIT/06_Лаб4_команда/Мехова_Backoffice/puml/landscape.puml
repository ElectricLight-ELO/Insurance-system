@startuml
!include <C4/C4_Context>
!include common.inc
LAYOUT_TOP_DOWN()
title ИС ОСАГО, Backoffice. SYSTEM LANDSCAPE (L0) — модуль администрирования и аудита

Person(admin, "Администратор", "Пользователи, роли, тарифы,\nрегистрация договора по команде")
Person(support, "Оператор поддержки", "Поиск полисов и платежей,\nперезапуск сбойных задач")
Person(sec, "Сотрудник ИБ", "Журнал аудита,\nрасследования инцидентов")
Person(acc, "Бухгалтер", "Маржа, оплаты,\nсчета и акты")

Enterprise_Boundary(ent, "Корпоративная ИТ-инфраструктура страховой компании") {
  System(bo, "ИС ОСАГО: Backoffice (администрирование и аудит)", "Админ-панель: пользователи и роли, тарифы, задачи, поиск полисов, журнал аудита, финансовые отчёты", $tags="target")
  System(iam, "Служба авторизации (IAM)", "Аутентификация сотрудников, RBAC, выпуск и проверка токенов")
  System(core, "Подсистема оформления полисов и урегулирования", "API и Worker: полисы, платежи, ДТП, очередь задач (outbox), аудит")
  System(crm, "CRM страховой компании", "Карточки клиентов, история обращений")
}
Boundary(city, "Экосистема Smart City") {
  System_Ext(soc, "Городской центр мониторинга ИБ (SOC)", "Приём сведений об инцидентах ИБ городских информационных систем", $tags="city")
}
System_Ext(ais, "АИС ОСАГО (РСА)", "Регистрация договоров, проверка полиса", $tags="ext")
System_Ext(email, "E-mail система", "Отчёты, счета и акты, уведомления о сбоях", $tags="ext")

Rel(admin, bo, "Управляет пользователями, ролями, тарифами", "HTTPS")
Rel(support, bo, "Ищет полисы и платежи, перезапускает задачи", "HTTPS")
Rel(sec, bo, "Просматривает и выгружает журнал аудита", "HTTPS")
Rel(acc, bo, "Смотрит маржу и оплаты, запрашивает счета", "HTTPS")
Rel(bo, iam, "Вход по коду, проверка ролей (RBAC), токены", "HTTPS, JSON, OAuth2")
Rel(bo, core, "Административные операции, журнал аудита, статусы задач и платежей", "REST/HTTPS, JSON")
Rel(bo, crm, "Карточка клиента при обращении в поддержку", "HTTPS, JSON")
Rel(core, ais, "Регистрирует договор, в т.ч. по команде администратора", "HTTPS, JSON, mTLS")
Rel(core, email, "Отчёты, счета и акты, уведомления о сбоях", "SMTP / STARTTLS", $tags="async")
Rel(email, acc, "Доставляет отчёты, счета и акты", "E-mail", $tags="async")
Rel(bo, soc, "Сведения об инцидентах ИБ (выгрузка событий аудита)", "HTTPS, JSON (syslog/CEF)", $tags="async")
SHOW_LEGEND()
@enduml
