@startuml
!include <C4/C4_Dynamic>
!include common.inc
LAYOUT_TOP_DOWN()
title Динамическая диаграмма — перезапуск сбойной задачи регистрации договора и контроль в журнале аудита

Person(support, "Оператор поддержки", "Перезапускает сбойные задачи")
Person(sec, "Сотрудник ИБ", "Проверяет журнал аудита")
Container_Boundary(bo, "Backoffice (React SPA)") {
  Component(p_task, "TasksPage", "React Page", "Сбойные задачи, перезапуск")
  Component(l_ops, "OperationsLogic", "React Hooks", "Задачи, поиск полисов, статусы")
  Component(a_ops, "OperationsApiClient", "TypeScript", "Задачи, полисы, платежи")
  Component(p_aud, "AuditLogPage", "React Page", "Журнал аудита, расследования")
  Component(l_aud, "AuditLogic", "React Hooks", "Фильтры журнала, выгрузка")
  Component(a_aud, "AuditApiClient", "TypeScript", "Журнал аудита")
  Component(http, "HttpClient", "axios", "Токен в каждом запросе, 401/403, повторы")
  Component(l_auth, "AuthLogic", "React Context", "Токен и роль пользователя")
  Component(u_note, "NotificationCenter", "React Component", "Уведомления о результатах")
  Component(u_exp, "ReportExporter", "SheetJS", "Выгрузка в Excel / CSV")
}
Container_Boundary(api, "API (FastAPI)") {
  Component(c_adm, "AdminController", "FastAPI Router", "Пользователи, тарифы, аудит, задачи")
  Component(s_acc, "AccessService", "Python · Strategy", "Проверка прав (RBAC)")
  Component(s_adm, "AdminService", "Python", "Административные операции")
  Component(f_task, "TaskQueueFacade", "SQL Client", "Задачи в очередь для Worker")
  Component(s_aud, "AuditService", "Python", "Запись событий аудита")
  Component(r_acc, "AccidentRepository", "SQLAlchemy", "Аудит, транзакции, очередь задач")
}
ContainerDb(db_audit, "DB_AUDIT", "PostgreSQL", "Аудит, транзакции, очередь задач (outbox)")
Container(worker, "Worker", "Python / Celery", "Фоновая регистрация договора")
System_Ext(ais, "АИС ОСАГО (РСА)", "Регистрация договоров", $tags="ext")

Rel(support, p_task, "Нажимает «Перезапустить» у задачи CONTRACT_REG", "HTTPS")
Rel(p_task, l_ops, "restartTask(taskId)", "React Hooks")
Rel(l_ops, a_ops, "restartTask(taskId, body)", "TypeScript call")
Rel(a_ops, http, "POST /api/admin/tasks/{id}/restart", "TypeScript call")
Rel(http, l_auth, "getToken()", "React Context")
Rel(http, c_adm, "restart_task(task_id)", "REST/HTTPS, JSON")
Rel(c_adm, s_acc, "check_permission(token, «tasks.restart»)", "Python Call")
Rel(c_adm, s_adm, "restart_task(task_id)", "Python Call")
Rel(s_adm, f_task, "enqueue(TaskItem CONTRACT_REG)", "Python Call")
Rel(f_task, r_acc, "save_task(task)", "Python Call")
Rel(r_acc, db_audit, "Возвращает задачу в outbox (status = pending)", "SQL")
Rel(s_adm, s_aud, "log_event(actor, «task_restarted», task_id)", "Python Call")
Rel(s_aud, r_acc, "save_audit(event)", "Python Call")
Rel(r_acc, db_audit, "Записывает событие аудита", "SQL")
Rel(http, u_note, "showSuccess(«Задача перезапущена»)", "React")
Rel(worker, db_audit, "list_pending_tasks(): забирает CONTRACT_REG", "SQL")
Rel(worker, ais, "register_policy(policy_data)", "HTTPS, JSON, mTLS", $tags="async")
Rel(worker, db_audit, "mark_task_done(task_id)", "SQL")
Rel(sec, p_aud, "Открывает журнал с фильтром «task_restarted»", "HTTPS")
Rel(p_aud, l_aud, "loadEvents()", "React Hooks")
Rel(l_aud, a_aud, "events(filter)", "TypeScript call")
Rel(a_aud, http, "GET /api/admin/audit", "TypeScript call")
Rel(http, c_adm, "get_audit()", "REST/HTTPS, JSON")
Rel(c_adm, s_acc, "check_permission(token, «audit.view»)", "Python Call")
Rel(c_adm, s_adm, "get_audit()", "Python Call")
Rel(s_adm, r_acc, "list_audit()", "Python Call")
Rel(r_acc, db_audit, "Читает события аудита", "SQL")
Rel(l_aud, u_exp, "exportEvents() → toExcel(events)", "TypeScript call")
SHOW_LEGEND()
@enduml
