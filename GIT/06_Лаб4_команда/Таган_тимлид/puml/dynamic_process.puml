@startuml
!include <C4/C4_Dynamic>
!include common.inc
LAYOUT_LEFT_RIGHT()
title Глобальная динамическая диаграмма ИС ОСАГО — сквозной процесс всех модулей (сборка тимлида)

Person(client, "Клиент / агент", "Полис, подпись протокола")
Person(payer, "Застрахованный клиент", "Оплата")
Person(disp, "Диспетчер и эксперт", "ДТП и осмотр")
Person(acc, "Бухгалтер", "Маржа и сверка")
Person(staff, "Поддержка и ИБ", "Задачи и аудит")
Container(web, "Web App", "React SPA", "Романов Н.И.")
Container(bo, "Backoffice", "React SPA", "Мехова А.С.")
Container(api, "API", "FastAPI", "Киселев Д.А.")
Container(worker, "Worker", "Python / Celery", "Усков М.В.")
ContainerDb(dbu, "DB_USERS", "PostgreSQL", "Пользователи, полисы")
ContainerDb(dbt, "DB_TARIFS", "PostgreSQL", "Тарифы, маржа")
ContainerDb(dba, "DB_AUDIT", "PostgreSQL", "Аудит, транзакции, ДТП, outbox")
ContainerDb(dbf, "DB_FILES", "MongoDB", "Фото, подписи, PDF")
System_Ext(sms, "SMS-шлюз", "Коды", $tags="ext")
System_Ext(ais, "АИС ОСАГО (РСА)", "КБМ, полисы, договоры", $tags="ext")
System_Ext(pay, "Платёжная система", "Сессии, webhook, сверка", $tags="ext")
System_Ext(email, "E-mail система", "Документы", $tags="ext")

' --- Фаза 0: вход
Rel(client, web, "Вводит телефон и код", "HTTPS")
Rel(web, api, "POST /api/auth/code — request_code(); POST /api/auth/verify — issue_token()", "REST/HTTPS, JSON")
Rel(api, sms, "send_code(phone, code)", "HTTPS, JSON")
' --- Фаза А: продажа полиса (Романов)
Rel(web, api, "POST /api/policies/calculate — calculate_premium()", "REST/HTTPS, JSON")
Rel(api, dbt, "get_coefficients()", "SQL")
Rel(api, ais, "get_kbm(), check_vehicle(), check_drivers()", "HTTPS, JSON, mTLS")
Rel(web, api, "POST /api/policies — issue_policy()", "REST/HTTPS, JSON")
Rel(api, dbu, "save_policy()", "SQL")
Rel(web, api, "POST /api/payments/session — create_session()", "REST/HTTPS, JSON")
Rel(api, pay, "create_session(policy_id, amount)", "HTTPS, JSON")
Rel(payer, pay, "Оплачивает полис", "HTTPS")
Rel(pay, api, "POST /api/payments/webhook — handle_webhook()", "HTTPS, JSON")
Rel(api, dba, "save_transaction(); save_task(CONTRACT_REG, PDF_POLICY)", "SQL")
Rel(worker, dba, "list_pending_tasks()", "SQL")
Rel(worker, ais, "register_policy(policy_data)", "HTTPS, JSON, mTLS", $tags="async")
Rel(worker, dbf, "generate_policy_pdf() → save_policy_pdf()", "MongoDB driver")
Rel(worker, email, "send_mail(полис, чек)", "SMTP / STARTTLS", $tags="async")
' --- Фаза Б: ДТП и осмотр (Киселев)
Rel(disp, web, "Регистрирует заявление, назначает эксперта, вносит осмотр", "HTTPS")
Rel(web, api, "POST /api/claims — register_claim()", "REST/HTTPS, JSON")
Rel(api, ais, "check_policy(claim)", "HTTPS, JSON, mTLS")
Rel(api, dba, "save_claim(); assign_expert()", "SQL")
Rel(web, api, "POST /api/claims/{id}/inspection, /photos — submit_results(), upload_photos()", "REST/HTTPS, multipart")
Rel(api, dbf, "save_photos(); save_inspection()", "MongoDB driver / SQL")
Rel(client, web, "Подписывает протокол", "HTTPS")
Rel(web, api, "POST /api/claims/{id}/signature — accept_signature()", "REST/HTTPS, JSON")
Rel(api, dbf, "save_signature()", "MongoDB driver")
Rel(api, dba, "save_task(PDF_PROTOCOL); save_audit()", "SQL")
Rel(worker, dba, "list_pending_tasks(): PDF_PROTOCOL", "SQL")
Rel(worker, dbf, "generate_protocol_pdf() → save_pdf()", "MongoDB driver")
Rel(worker, email, "send_mail(протокол осмотра)", "SMTP / STARTTLS", $tags="async")
' --- Фаза В: финансовый контроль (Усков)
Rel(acc, bo, "Запускает расчёт маржи за период", "HTTPS (VPN)")
Rel(bo, api, "POST /api/admin/finance/margin — trigger_margin()", "REST/HTTPS, JSON")
Rel(api, dba, "save_task(MARGIN_CALC)", "SQL")
Rel(worker, dba, "get_for_period(): транзакции", "SQL")
Rel(worker, dbt, "get_coefficients(); save_margin_result()", "SQL")
Rel(worker, pay, "check_pending_transactions() (Celery Beat)", "HTTPS, JSON")
Rel(worker, dba, "update_status() зависших платежей", "SQL")
Rel(worker, email, "Отчёт по марже бухгалтеру", "SMTP / STARTTLS", $tags="async")
' --- Фаза Г: администрирование и аудит (Мехова)
Rel(staff, bo, "Перезапускает сбойную задачу, открывает журнал аудита", "HTTPS (VPN)")
Rel(bo, api, "POST /api/admin/tasks/{id}/restart — restart_task()", "REST/HTTPS, JSON")
Rel(api, dba, "save_task(CONTRACT_REG, pending); save_audit(task_restarted)", "SQL")
Rel(bo, api, "GET /api/admin/audit — get_audit()", "REST/HTTPS, JSON")
Rel(api, dba, "list_audit()", "SQL")
SHOW_LEGEND()
@enduml
