@startuml
!include <C4/C4_Context>
!include common.inc
LAYOUT_TOP_DOWN()
title ИС ОСАГО. SYSTEM LANDSCAPE (L0) — интеграция в экосистему Smart City (тимлид)

Person(cit, "Граждане и клиенты", "Гость, клиент, застрахованный клиент (3 роли L1)")
Person(front, "Сотрудники фронт-офиса", "Страховой агент, менеджер продаж, диспетчер, аварийный эксперт (4 роли L1)")
Person(back, "Сотрудники бэк-офиса", "Оператор поддержки, сотрудник ИБ, бухгалтер, администратор (4 роли L1)")

Boundary(city, "Экосистема Smart City") {
  Enterprise_Boundary(ent, "Корпоративная ИТ-инфраструктура страховой компании") {
    System(osago, "ИС ОСАГО", "Продажа и оформление полисов, оплата, регистрация договоров, фиксация ДТП и осмотр, финансовый контроль, администрирование и аудит", $tags="target")
    System(iam, "Служба авторизации (IAM)", "Единые учётные записи сотрудников, SSO, роли, выпуск и проверка токенов")
    System(crm, "CRM страховой компании", "Карточки клиентов, лиды и продажи агентов, история обращений")
    System(email, "E-mail система", "Корпоративная почта и рассылки")
    System(sms, "SMS-шлюз", "Одноразовые коды")
  }
  System_Ext(portal, "Городской портал услуг", "Единая точка доступа граждан к городским сервисам", $tags="city")
  System_Ext(esia, "ЕСИА (Госуслуги)", "Подтверждённая учётная запись гражданина", $tags="city")
  System_Ext(sitc, "Ситуационный центр / Система-112", "Приём сообщений о ДТП, вызов служб", $tags="city")
  System_Ext(soc, "Городской центр мониторинга ИБ (SOC)", "Инциденты ИБ городских систем", $tags="city")
}
System_Ext(ais, "АИС ОСАГО (РСА)", "КБМ, проверки ТС, водителей и полиса, регистрация договоров", $tags="ext")
System_Ext(pay, "Платёжная система", "Платёжные сессии, webhook, сверка", $tags="ext")

Rel(cit, osago, "Расчёт и оформление полиса, личный кабинет, заявление о ДТП, подпись протокола", "HTTPS")
Rel(front, osago, "Продажи и КВ, отчёты, заявления о ДТП, осмотр и фото", "HTTPS")
Rel_U(back, osago, "Администрирование, задачи, журнал аудита, финансы", "HTTPS через VPN")
Rel(cit, pay, "Оплачивает полис", "HTTPS")
Rel(osago, iam, "Вход сотрудников (SSO), роли, проверка токенов", "HTTPS, OAuth2 / OIDC")
Rel(osago, crm, "Клиенты, продажи агентов, обращения в поддержку", "HTTPS, JSON", $tags="async")
Rel(osago, sms, "Одноразовые коды", "HTTPS, JSON")
Rel(osago, email, "Полисы, чеки, протоколы, счета, отчёты", "SMTP / STARTTLS", $tags="async")
Rel(email, cit, "Доставляет документы", "E-mail", $tags="async")
Rel(osago, ais, "КБМ, проверки, регистрация договора", "HTTPS, JSON, mTLS")
Rel(osago, pay, "Платёжная сессия, сверка", "HTTPS, JSON")
Rel(pay, osago, "Уведомление об оплате (webhook)", "HTTPS, JSON", $tags="async")
Rel(portal, osago, "Переход гражданина к расчёту и оформлению полиса", "HTTPS")
Rel(osago, esia, "Вход гражданина через Госуслуги", "HTTPS, OAuth2 / OIDC")
Rel(sitc, osago, "Сообщение о ДТП с координатами (создание черновика заявления)", "HTTPS, JSON", $tags="async")
Rel(osago, soc, "События ИБ из журнала аудита", "HTTPS, JSON (syslog/CEF)", $tags="async")
SHOW_LEGEND()
@enduml
