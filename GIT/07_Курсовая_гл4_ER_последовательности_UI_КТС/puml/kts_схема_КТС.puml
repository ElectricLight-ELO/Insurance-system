@startuml
skinparam defaultFontName "Liberation Sans"
skinparam defaultFontSize 13
skinparam dpi 150
skinparam shadowing false
nwdiag {
  internet [shape = cloud, description = "Интернет"];
  internet -- fw_ext;

  network wan {
    description = "Внешний периметр\n2 канала по 100 Мбит/с"
    address = "203.0.113.0/29"
    color = "#FFF2CC"
    fw_ext [shape = node, address = "203.0.113.2", description = "МЭ-1 (внешний)\nNGFW / кластер 2 шт."];
    users [shape = node, description = "Устройства пользователей\nПК / ноутбуки / смартфоны"];
    ext [shape = cloud, description = "Внешние системы:\nАИС ОСАГО / платёжная\nE-mail / SMS-шлюз"];
  }
  network dmz {
    description = "DMZ\nVLAN 10"
    address = "10.10.10.0/24"
    color = "#FCE4D6"
    fw_ext [address = "10.10.10.1"];
    lb1 [address = "10.10.10.11", description = "LB-1\nnginx (reverse proxy)"];
    lb2 [address = "10.10.10.12", description = "LB-2\nnginx (reverse proxy)"];
    fw_int [address = "10.10.10.254", shape = node, description = "МЭ-2 (внутренний)"];
  }
  network app {
    description = "Зона приложений\nVLAN 20"
    address = "10.10.20.0/24"
    color = "#DDEBF7"
    fw_int [address = "10.10.20.1"];
    api1 [address = "10.10.20.11", description = "APP-1\nAPI (Docker)"];
    api2 [address = "10.10.20.12", description = "APP-2\nAPI (Docker)"];
    api3 [address = "10.10.20.13", description = "APP-3\nAPI (Docker)"];
    wrk1 [address = "10.10.20.21", description = "WRK-1\nWorker (Docker)"];
    wrk2 [address = "10.10.20.22", description = "WRK-2\nWorker (Docker)"];
  }
  network data {
    description = "Зона данных\nVLAN 30"
    address = "10.10.30.0/24"
    color = "#E2EFDA"
    fw_int [address = "10.10.30.1"];
    pg1 [shape = database, address = "10.10.30.11", description = "PG-1 PostgreSQL\nprimary"];
    pg2 [shape = database, address = "10.10.30.12", description = "PG-2 PostgreSQL\nreplica"];
    mg1 [shape = database, address = "10.10.30.21", description = "MDB-1 MongoDB\nprimary"];
    mg2 [shape = database, address = "10.10.30.22", description = "MDB-2 MongoDB\nsecondary"];
    mg3 [shape = database, address = "10.10.30.23", description = "MDB-3 MongoDB\nsecondary"];
    bkp [shape = storage, address = "10.10.30.50", description = "BKP\nСХД резервных копий"];
  }
  network mgmt {
    description = "Сеть управления\nVLAN 99"
    address = "10.10.99.0/24"
    color = "#EDEDED"
    fw_int [address = "10.10.99.1"];
    mon [address = "10.10.99.10", description = "MON\nмониторинг и журналы"];
    adm [address = "10.10.99.20", description = "АРМ администратора\n(VPN)"];
  }
}
@enduml
