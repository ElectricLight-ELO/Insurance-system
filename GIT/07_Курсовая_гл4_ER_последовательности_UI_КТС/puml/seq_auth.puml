@startuml
skinparam dpi 170
skinparam defaultFontName Times New Roman
skinparam sequenceMessageAlign center
skinparam ParticipantPadding 20
title Вход по одноразовому коду
actor "Пользователь" as U
participant "Web App\n(AuthLogic, AuthApiClient)" as W
participant "API\n(AuthController, AccessService)" as A
participant "SmsGatewayFacade" as S
database "DB_USERS" as D
participant "SMS-шлюз" as G
U -> W : ввод номера телефона
W -> A : POST /api/auth/code {phone}
A -> D : найти пользователя по phone
A -> S : send_code(phone)
S -> G : отправить код (HTTPS)
A --> W : 202 Accepted
G --> U : SMS с кодом
U -> W : ввод кода
W -> A : POST /api/auth/verify {phone, code}
A -> A : проверить код и срок действия
alt код верный
  A -> D : прочитать роль и права (RBAC)
  A --> W : 200 TokenResponse {access_token, role, expires_at}
  W -> W : сохранить токен, открыть страницы по роли
else код неверный
  A --> W : 401 Unauthorized
  W --> U : сообщение об ошибке
end
@enduml
