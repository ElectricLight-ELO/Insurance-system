@startuml
skinparam dpi 120
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam shadowing false
skinparam packageStyle rectangle
skinparam rectangle {
  BorderColor black
  BorderThickness 2
  FontStyle bold
  BackgroundColor white
}
skinparam usecase {
  BackgroundColor white
  BorderColor black
  ArrowColor black
}
skinparam actor {
  BackgroundColor white
  BorderColor black
}
skinparam nodesep 18
skinparam ranksep 90
left to right direction
actor "Клиент" as C
actor "Диспетчер" as D
actor "Аварийный\nэксперт" as E
actor "АИС ОСАГО\n(РСА)" as RSA
actor "E-mail\nсистема" as EM
rectangle "ИС ОСАГО: урегулирование ДТП (как должно быть)" {
  usecase "Подать заявление\nо ДТП онлайн" as U1 #C5E0B3
  usecase "Зарегистрировать заявление\nо ДТП по телефону" as U2 #C5E0B3
  usecase "Проверить полис участника\nв АИС ОСАГО автоматически" as U3 #C5E0B3
  usecase "Назначить эксперта\nв системе" as U4 #C5E0B3
  usecase "Уведомить клиента о статусе\nдела по e-mail" as U5 #BDD7EE
  usecase "Отслеживать статус\nдела онлайн" as U6 #BDD7EE
  usecase "Загрузить фото и сведения\nоб осмотре в карточку дела" as U7 #C5E0B3
  usecase "Заполнить электронный\nакт осмотра" as U8 #C5E0B3
  usecase "Подписать протокол\nосмотра электронной подписью" as U9 #C5E0B3
  usecase "Сформировать PDF-протокол\nи отправить клиенту" as U10 #C5E0B3
}
C -- U1
C -- U6
C -- U9
D -- U2
D -- U4
E -- U7
E -- U8
U1 ..> U3 : <<include>>
U2 ..> U3 : <<include>>
U4 ..> U5 : <<extend>>
U9 ..> U10 : <<include>>
U3 --> RSA
U5 --> EM
U10 --> EM
legend left
  <back:#C5E0B3>  зелёный  </back> прецеденты, устраняющие проблемы модели «как есть» (п. 2.2.4)
  <back:#BDD7EE>  голубой  </back> новые возможности, отсутствовавшие в модели «как есть»
  белый — неизменяемые части
endlegend
@enduml
