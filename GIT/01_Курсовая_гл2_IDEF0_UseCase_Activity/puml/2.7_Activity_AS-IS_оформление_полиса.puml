@startuml
skinparam defaultFontName "Liberation Sans"
skinparam defaultFontSize 15
skinparam dpi 170
skinparam shadowing false
skinparam ArrowColor black
skinparam activity {
  BackgroundColor white
  BorderColor black
  DiamondBackgroundColor white
  DiamondBorderColor black
}
skinparam swimlane {
  BorderColor black
  TitleFontStyle bold
  TitleFontSize 16
}
title Оформление полиса ОСАГО (как есть)
|Клиент|
start
:Обратиться к агенту\n(офис, телефон);
:Передать документы\nклиента, ТС и водителей;
|Страховой агент|
repeat
  :Проверить комплектность\nдокументов;
  backward:Запросить недостающие\nдокументы у клиента;
repeat while (Комплект полный?) is (нет) not (да)
#FAD7B5:Ввести данные клиента и ТС\nв веб-кабинет АИС ОСАГО;
|АИС ОСАГО|
:Вернуть КБМ и результаты\nпроверки ТС и водителей;
|Страховой агент|
if (Проверка пройдена?) then (нет)
  :Сообщить клиенту\nоб отказе;
  stop
else (да)
endif
#FAD7B5:Рассчитать премию\nв Excel вручную;
:Заполнить бумажный\nдоговор и квитанцию;
|Клиент|
:Оплатить полис\n(касса, перевод);
|Банк|
:Провести платёж,\nотразить в выписке;
|Страховой агент|
#FAD7B5:Сверить оплату\nпо банковской выписке;
if (Оплата найдена\nв срок?) then (нет)
  :Аннулировать\nбумажный договор;
  stop
else (да)
endif
repeat
  #FAD7B5:Внести договор\nв АИС ОСАГО вручную;
  |АИС ОСАГО|
  :Принять сведения\nо договоре;
  |Страховой агент|
repeat while (Ошибка регистрации?) is (да) not (нет)
:Выдать бумажный полис;
|Клиент|
:Получить полис;
stop
legend right
  Оранжевым выделены ручные операции,
  создающие проблемы (п. 1.1.4)
endlegend
@enduml
