@startuml
left to right direction
skinparam shadowing false
skinparam usecase {
  BackgroundColor white
  BorderColor black
}
actor "Бухгалтер" as B
actor "Оператор\nподдержки" as S
actor "Администратор" as A
actor "Сотрудник ИБ" as IB
rectangle "Страховая компания: финансы, поддержка и администрирование (как есть)" {
  usecase "Сверять оплаты по\nбанковским выпискам" as U1 #FAD7B5
  usecase "Рассчитывать маржу и КВ\nв таблицах Excel" as U2 #FAD7B5
  usecase "Формировать счета\nи акты вручную" as U3 #FAD7B5
  usecase "Рассылать документы\nпо e-mail вручную" as U4 #FAD7B5
  usecase "Искать полис и платёж\nв нескольких источниках" as U5 #FAD7B5
  usecase "Повторять зависшие\nоперации вручную" as U6 #FAD7B5
  usecase "Заводить пользователей\nи права доступа" as U7
  usecase "Обновлять тарифы\nв таблицах" as U8 #FAD7B5
  usecase "Разбирать инциденты\nпо разрозненным записям" as U9 #FAD7B5
}
actor "Банк" as BANK
actor "Почтовый\nсервер" as MAIL
B -- U1
B -- U2
B -- U3
B -- U4
S -- U5
S -- U6
A -- U7
A -- U8
IB -- U9
U1 -- BANK
U4 -- MAIL
@enduml
